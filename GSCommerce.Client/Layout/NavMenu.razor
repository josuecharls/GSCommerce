@using GSCommerce.Client.Services
@using GSCommerce.Client.Helpers
@inject AuthService AuthService
@inject CajaService CajaService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="top-row navbar navbar-dark">
    <div class="d-flex align-items-center ms-4">
        <img src="/imagen/LogoGSC.png" alt="GSCommerce Logo" style="width: 60px;height: 60px;margin-right: 10px;justify-items: center;">
        <a class="navbar-brand" href="/">GSCommerce</a>
    </div>
    <button title="Navigation menu" class="navbar-toggler msd-4 order-md-2 order-1" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>
<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @if (esContadorCentral)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/ventas">
                    <span class="bi bi-receipt" aria-hidden="true"></span> Ventas
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/notass-credito">
                    <span class="bi bi-file-earmark-excel" aria-hidden="true"></span> Notas de Crédito
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/comprobantes-sunat">
                    <span class="bi bi-file-earmark-zip-fill" aria-hidden="true"></span> Comprobantes SUNAT
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/guias-remision-sunat">
                    <span class="bi bi-truck" aria-hidden="true"></span> Guías Remisión SUNAT
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/series-guias-remision">
                    <span class="bi bi-list-ol" aria-hidden="true"></span> Series Guías Remisión
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/kardex-detallado">
                    <span class="bi bi-journal" aria-hidden="true"></span> Kardex Detallado
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/cambiar-password">
                    <span class="bi bi-key" aria-hidden="true"></span> Cambiar Contraseña
                </NavLink>
            </div>
        }
        else
        {
        @if (cargo == "ADMINISTRADOR" || cargo == "CAJERO" || cargo == "ALMACEN")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/hubs/maestros">
                    <span class="bi bi-database" aria-hidden="true"></span> Maestros
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/hubs/consultas">
                    <span class="bi bi-search" aria-hidden="true"></span> Consultas
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/hubs/movimientos">
                    <span class="bi bi-arrow-left-right" aria-hidden="true"></span> Movimientos
                </NavLink>
            </div>
        }

        @if (cargo == "ADMINISTRADOR" || cargo == "ALMACEN")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/ordenes-compra">
                    <span class="bi bi-cart-check" aria-hidden="true"></span> Órdenes de Compra
                </NavLink>
            </div>
        }

        @if (cargo == "ADMINISTRADOR" || cargo == "CAJERO")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/hubs/ventas-caja">
                    <span class="bi bi-cash-coin" aria-hidden="true"></span> Ventas y Caja
                </NavLink>
            </div>
        }

        @if (cargo == "ADMINISTRADOR" || cargo == "CAJERO" || cargo == "ALMACEN" || cargo == "CONTADOR")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/hubs/reportes">
                    <span class="bi bi-bar-chart" aria-hidden="true"></span> Reportes
                </NavLink>
            </div>
        }

        @if (cargo == "ADMINISTRADOR")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/hubs/configuracion">
                    <span class="bi bi-gear" aria-hidden="true"></span> Configuración
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/hubs/documentos-electronicos">
                    <span class="bi bi-file-earmark-text" aria-hidden="true"></span> Documentos Electrónicos
                </NavLink>
            </div>
        }

        @* Accesos directos importantes para CAJERO *@
        @if (cargo == "CAJERO")
        {
            <hr class="my-2" />
            <div class="nav-item px-3">
                <small class="text-muted ps-3">Accesos Rápidos</small>
            </div>
            <div class="nav-item px-3">
                <a class="nav-link" href="#" @onclick="IrAVentas">
                    <span class="bi bi-cart-plus" aria-hidden="true"></span> Nueva Venta
                </a>
            </div>
            <div class="nav-item px-3">
                <a class="nav-link" href="#" @onclick="IrACajaManual">
                    <span class="bi bi-calculator" aria-hidden="true"></span> Caja Manual
                </a>
            </div>
        }
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private string? cargo;
    private bool esContadorCentral;

    protected override async Task OnInitializedAsync()
    {
        cargo = await AuthService.GetUserCargo();
        var idUsuario = await AuthService.GetUserId();
        esContadorCentral = ContadorCentralHelper.EsContadorCentral(idUsuario);
    }
    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task IrAVentas()
    {
        var idUsuario = await AuthService.GetUserId();
        var idAlmacen = await AuthService.GetUserAlmacenId();
        if (idUsuario != null && idAlmacen != null)
        {
            var aperturas = await CajaService.VerificarAperturaAsync(idUsuario.Value, idAlmacen.Value);
            if (aperturas != null && aperturas.Any(a => a.Estado == "A"))
            {
                Navigation.NavigateTo("/ventass/crear/b1");
                return;
            }
        }

        await JS.InvokeVoidAsync("alert", "⚠️ Caja no aperturada.");
        Navigation.NavigateTo("/cajita");
    }

    private async Task IrACajaManual()
    {
        var idUsuario = await AuthService.GetUserId();
        var idAlmacen = await AuthService.GetUserAlmacenId();
        if (idUsuario != null && idAlmacen != null)
        {
            var aperturas = await CajaService.VerificarAperturaAsync(idUsuario.Value, idAlmacen.Value);
            if (aperturas != null && aperturas.Any(a => a.Estado == "A"))
            {
                Navigation.NavigateTo("/ventass/crear/b2");
                return;
            }
        }

        await JS.InvokeVoidAsync("alert", "⚠️ Caja no aperturada.");
        Navigation.NavigateTo("/cajita");
    }
}