@page "/hubs/reportes"
@using Microsoft.AspNetCore.Authorization
@using GSCommerce.Client.Components
@using GSCommerce.Client.Services
@attribute [Authorize]
@inject AuthService AuthService

<h3 class="mb-4">
    <i class="bi bi-bar-chart me-2"></i>
    Reportes
</h3>
<p class="text-muted mb-4">Reportes y estadísticas del sistema</p>

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
    
    @if (cargo == "ADMINISTRADOR" || cargo == "CAJERO")
    {
        <div class="col">
            <HubCard 
                Title="Resumen Diario" 
                Description="Resumen de ventas del día"
                IconClass="bi-file-earmark-check"
                Url="/diario-resumido" />
        </div>

        <div class="col">
            <HubCard 
                Title="Todos los Reportes" 
                Description="Acceder a todos los reportes"
                IconClass="bi-folder"
                Url="/reportes" />
        </div>
    }

    @if (cargo == "ALMACEN" || cargo == "ADMINISTRADOR")
    {
        <div class="col">
            <HubCard 
                Title="Cálculo de Distribución" 
                Description="Calcular distribución de productos"
                IconClass="bi-bar-chart-fill"
                Url="/reportes/calculo-distribucion" />
        </div>
    }

    @if (cargo == "CONTADOR" || cargo == "ADMINISTRADOR")
    {
        <div class="col">
            <HubCard 
                Title="Libro Contable de Ventas" 
                Description="Libro de ventas para contabilidad"
                IconClass="bi-book"
                Url="/reportes/libro-ventas-contable" />
        </div>
    }

    @if (userId == 4004 || userId == 4023 || userId == 4033)
    {
        <div class="col">
            <HubCard Title="Consolidado Anual Tarjetas"
                     Description="Reporte 2025"
                     IconClass="bi-calendar2-month"
                     Url="/hubs/reportes/ventas-tarjeta-mensual" />
        </div>
    }

</div>

@code {
    private string? cargo;
    private int? userId;

    protected override async Task OnInitializedAsync()
    {
        cargo = await AuthService.GetUserCargo();
        userId = await AuthService.GetUserId();
    }
}



