@page "/hubs/documentos-electronicos"
@using Microsoft.AspNetCore.Authorization
@using GSCommerce.Client.Components
@using GSCommerce.Client.Services
@attribute [Authorize]
@inject AuthService AuthService

<h3 class="mb-4">
    <i class="bi bi-file-earmark-text me-2"></i>
    Documentos Electrónicos
</h3>
<p class="text-muted mb-4">Comprobantes y guías SUNAT</p>

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
    
    <div class="col">
        <HubCard 
            Title="Guías de Remisión Electrónica" 
            Description="Gestionar guías SUNAT"
            IconClass="bi-truck"
            Url="/guias-remision-sunat" />
    </div>

    @if (cargo == "ADMINISTRADOR")
    {
        <div class="col">
            <HubCard 
                Title="Comprobantes SUNAT" 
                Description="Ver comprobantes enviados"
                IconClass="bi-file-earmark-zip-fill"
                Url="/comprobantes-sunat" />
        </div>
    }

</div>

@code {
    private string? cargo;

    protected override async Task OnInitializedAsync()
    {
        cargo = await AuthService.GetUserCargo();
    }
}

