@page "/guias-remision-electronica/formulario"
@page "/guias-remision-electronica/formulario/{idMovimiento:int}"
@using GSCommerce.Client.Models.SUNAT
@using GSCommerce.Client.Services
@inject GuiaRemisionElectronicaService GuiaService
@inject MovimientoGuiaService MovimientoGuiaService
@inject AlmacenService AlmacenService
@inject ClienteService ClienteService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Formulario de Guía de Remisión Electrónica</PageTitle>

<h3><i class="bi bi-file-earmark-plus"></i> @(guia.IdGuiaRemision > 0 ? "Editar" : "Nueva") Guía de Remisión Electrónica</h3>

<div class="card p-4">
    <div class="row">
        <div class="col-md-6">
            <h5>Datos del Remitente</h5>
            <div class="mb-3">
                <label>RUC</label>
                <input type="text" class="form-control" @bind="guia.RucRemitente" readonly />
            </div>
            <div class="mb-3">
                <label>Razón Social</label>
                <input type="text" class="form-control" @bind="guia.RazonSocialRemitente" readonly />
            </div>
            <div class="mb-3">
                <label>Dirección</label>
                <input type="text" class="form-control" @bind="guia.DireccionRemitente" readonly />
            </div>
        </div>

        <div class="col-md-6">
            <h5>Datos del Destinatario</h5>
            <div class="mb-3">
                <label>Tipo Documento</label>
                <select class="form-control" @bind="guia.TipoDocumentoDestinatario">
                    <option value="6">RUC</option>
                    <option value="1">DNI</option>
                </select>
            </div>
            <div class="mb-3">
                <label>Número Documento</label>
                <input type="text" class="form-control" @bind="guia.NumeroDocumentoDestinatario" />
            </div>
            <div class="mb-3">
                <label>Razón Social / Nombre</label>
                <input type="text" class="form-control" @bind="guia.RazonSocialDestinatario" />
            </div>
            <div class="mb-3">
                <label>Dirección</label>
                <input type="text" class="form-control" @bind="guia.DireccionDestinatario" />
            </div>
            <div class="mb-3">
                <label>Ubigeo</label>
                <input type="text" class="form-control" @bind="guia.UbigeoDestinatario" />
            </div>
        </div>
    </div>

    <hr />

    <div class="row">
        <div class="col-md-6">
            <h5>Datos de Origen</h5>
            <div class="mb-3">
                <label>Dirección Origen</label>
                <input type="text" class="form-control" @bind="guia.DireccionOrigen" />
            </div>
            <div class="mb-3">
                <label>Ubigeo Origen</label>
                <input type="text" class="form-control" @bind="guia.UbigeoOrigen" />
            </div>
        </div>

        <div class="col-md-6">
            <h5>Datos de Destino</h5>
            <div class="mb-3">
                <label>Dirección Destino</label>
                <input type="text" class="form-control" @bind="guia.DireccionDestino" />
            </div>
            <div class="mb-3">
                <label>Ubigeo Destino</label>
                <input type="text" class="form-control" @bind="guia.UbigeoDestino" />
            </div>
        </div>
    </div>

    <hr />

    <div class="row">
        <div class="col-md-4">
            <label>Serie</label>
            <input type="text" class="form-control" @bind="guia.Serie" maxlength="4" placeholder="T001" />
        </div>
        <div class="col-md-4">
            <label>Número</label>
            <input type="number" class="form-control" @bind="guia.Numero" />
        </div>
        <div class="col-md-4">
            <label>Fecha Emisión</label>
            <input type="date" class="form-control" @bind="guia.FechaEmision" />
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <label>Motivo de Traslado</label>
            <select class="form-control" @bind="guia.MotivoTraslado">
                <option value="01">01 - Venta</option>
                <option value="02">02 - Venta sujeta a confirmación</option>
                <option value="04">04 - Consignación</option>
                <option value="05">05 - Devolución</option>
                <option value="06">06 - Traslado entre establecimientos</option>
                <option value="07">07 - Traslado emisor itinerante</option>
                <option value="08">08 - Importación</option>
                <option value="09">09 - Exportación</option>
                <option value="13">13 - Otros</option>
            </select>
        </div>
        <div class="col-md-6">
            <label>Descripción Motivo</label>
            <input type="text" class="form-control" @bind="guia.DescripcionMotivo" />
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <label>Peso Total (kg)</label>
            <input type="number" step="0.01" class="form-control" @bind="guia.PesoTotal" />
        </div>
        <div class="col-md-6">
            <label>Número de Bultos</label>
            <input type="number" class="form-control" @bind="guia.NumeroBultos" />
        </div>
    </div>

    <div class="mt-3">
        <label>Observaciones</label>
        <textarea class="form-control" rows="2" @bind="guia.Observaciones"></textarea>
    </div>

    <hr />

    <h5>Detalles de Productos</h5>
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Item</th>
                <th>Código</th>
                <th>Descripción</th>
                <th>Unidad</th>
                <th>Cantidad</th>
                <th>Peso</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detalle in guia.Detalles)
            {
                <tr>
                    <td>@detalle.Item</td>
                    <td>@detalle.CodigoItem</td>
                    <td>@detalle.DescripcionItem</td>
                    <td>@detalle.UnidadMedida</td>
                    <td>@detalle.Cantidad</td>
                    <td>@(detalle.Peso?.ToString("F2") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <button class="btn btn-primary" @onclick="Guardar">
            <i class="bi bi-save"></i> Guardar
        </button>
        <button class="btn btn-success" @onclick="GenerarXml">
            <i class="bi bi-file-code"></i> Generar XML
        </button>
        <button class="btn btn-warning" @onclick="EnviarSunat">
            <i class="bi bi-send"></i> Enviar a SUNAT
        </button>
        <button class="btn btn-secondary" @onclick="Volver">
            <i class="bi bi-arrow-left"></i> Volver
        </button>
    </div>
</div>

@code {
    [Parameter] public int? idMovimiento { get; set; }

    private GuiaRemisionDTO guia = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (idMovimiento.HasValue)
        {
            await CargarDesdeMovimiento(idMovimiento.Value);
        }
        else
        {
            InicializarGuia();
        }
        isLoading = false;
    }

    private void InicializarGuia()
    {
        guia.FechaEmision = DateTime.Now;
        guia.HoraEmision = DateTime.Now.TimeOfDay;
        guia.Serie = "T001";
        guia.MotivoTraslado = "01";
        guia.DescripcionMotivo = "Venta";
    }

    private async Task CargarDesdeMovimiento(int idMov)
    {
        var movimiento = await MovimientoGuiaService.GetMovimientoById(idMov);
        if (movimiento != null)
        {
            guia.IdMovimiento = idMov;
            guia.FechaEmision = movimiento.Fecha;
            guia.HoraEmision = movimiento.Fecha.TimeOfDay;
            
            // Cargar datos del almacén (remitente)
            var almacenes = await AlmacenService.GetAlmacenes();
            var almacen = almacenes?.FirstOrDefault(a => a.IdAlmacen == movimiento.IdAlmacen);
            if (almacen != null)
            {
                guia.RucRemitente = almacen.Ruc ?? "";
                guia.RazonSocialRemitente = almacen.RazonSocial ?? "";
                guia.DireccionRemitente = almacen.Direccion ?? "";
                guia.UbigeoRemitente = almacen.Ubigeo ?? "";
            }

            // Mapear detalles
            guia.Detalles = movimiento.Detalles?.Select((d, index) => new GuiaRemisionDetalleDTO
            {
                Item = index + 1,
                CodigoItem = d.IdArticulo,
                DescripcionItem = d.DescripcionArticulo,
                Cantidad = d.Cantidad,
                UnidadMedida = "NIU"
            }).ToList() ?? new();
        }
    }

    private async Task Guardar()
    {
        if (guia.IdMovimiento > 0)
        {
            var (exito, mensaje, guiaCreada) = await GuiaService.CrearGuiaDesdeMovimiento(guia.IdMovimiento, guia);
            if (exito)
            {
                await JS.InvokeVoidAsync("alert", mensaje);
                if (guiaCreada != null)
                {
                    Navigation.NavigateTo($"/guias-remision-electronica/detalle/{guiaCreada.IdGuiaRemision}");
                }
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Error: {mensaje}");
            }
        }
    }

    private async Task GenerarXml()
    {
        var (exito, mensaje) = await GuiaService.GenerarXmlGuia(guia);
        await JS.InvokeVoidAsync("alert", mensaje);
    }

    private async Task EnviarSunat()
    {
        var (exito, mensaje) = await GuiaService.EnviarGuia(guia);
        await JS.InvokeVoidAsync("alert", mensaje);
        if (exito)
        {
            await CargarGuias();
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/guias-remision-electronica");
    }

    private async Task CargarGuias()
    {
        // Recargar datos si es necesario
    }
}
