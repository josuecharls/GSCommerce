@page "/articulo-form"
@page "/articulo-form/{dummy}"
@using GSCommerce.Client.Models
@using GSCommerce.Client.Services
@using System.Globalization
@using System.Linq
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ArticuloService ArticuloService
@inject ProveedorService ProveedorService
@inject ComplementoService ComplementoService
@using GSCommerce.Client.Pages
@inject NavigationManager Navigation
@inject ArticuloVarianteService ArticuloVarianteService
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

<h3><i class="bi bi-box-seam"></i> Nuevo Artículo</h3>

@if (!isLoading)
{
    <div class="card p-4">
        <div class="row">
            <!-- Izquierda -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Código</label>
                    <input type="text" class="form-control" @bind="articulo.IdArticulo" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <input type="text" class="form-control" @bind="articulo.Descripcion" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Descripción Corta</label>
                    <input type="text" class="form-control" @bind="articulo.DescripcionCorta" readonly />
                </div>

                <!-- FAMILIA -->
                <div class="mb-3">
                    <label class="form-label">Familia</label>
                    <div class="input-group">
                        <select class="form-control" @bind="articulo.Familia" @bind:after="ActualizarDescripcion">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var c in familias)
                            {
                                <option value="@c.Descripcion">@c.Descripcion</option>
                            }
                        </select>
                        <button class="btn btn-outline-primary" type="button" title="Nuevo"
                                @onclick='() => OpenNuevoComplemento("FAMILIA")'>
                            +
                        </button>
                    </div>
                </div>

                <!-- LINEA -->
                <div class="mb-3">
                    <label class="form-label">Línea</label>
                    <div class="input-group">
                        <select class="form-control" @bind="articulo.Linea" @bind:after="ActualizarDescripcion">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var c in lineas)
                            {
                                <option value="@c.Descripcion">@c.Descripcion</option>
                            }
                        </select>
                        <button class="btn btn-outline-primary" type="button" title="Nuevo"
                                @onclick='() => OpenNuevoComplemento("LINEA")'>
                            +
                        </button>
                    </div>
                </div>

                <!-- MARCA -->
                <div class="mb-3">
                    <label class="form-label">Marca</label>
                    <div class="input-group">
                        <select class="form-control" @bind="articulo.Marca" @bind:after="ActualizarDescripcion">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var c in marcas)
                            {
                                <option value="@c.Descripcion">@c.Descripcion</option>
                            }
                        </select>
                        <button class="btn btn-outline-primary" type="button" title="Nuevo"
                                @onclick='() => OpenNuevoComplemento("MARCA")'>
                            +
                        </button>
                    </div>
                </div>

                <!-- MATERIAL -->
                <div class="mb-3">
                    <label class="form-label">Material</label>
                    <div class="input-group">
                        <select class="form-control" @bind="articulo.Material" @bind:after="ActualizarDescripcion">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var c in materiales)
                            {
                                <option value="@c.Descripcion">@c.Descripcion</option>
                            }
                        </select>
                        <button class="btn btn-outline-primary" type="button" title="Nuevo"
                                @onclick='() => OpenNuevoComplemento("MATERIAL")'>
                            +
                        </button>
                    </div>
                </div>

                <!-- MODELO -->
                <div class="mb-3">
                    <label class="form-label">Modelo</label>
                    <div class="input-group">
                        <select class="form-control" @bind="articulo.Modelo" @bind:after="ActualizarDescripcion">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var c in modelos)
                            {
                                <option value="@c.Descripcion">@c.Descripcion</option>
                            }
                        </select>
                        <button class="btn btn-outline-primary" type="button" title="Nuevo"
                                @onclick='() => OpenNuevoComplemento("MODELO")'>
                            +
                        </button>
                    </div>
                </div>

                <!-- VARIANTES COLOR/TALLA -->
                <div class="mb-3">
                    <label class="form-label">Variantes Color/Talla</label>
                    <div class="input-group">
                        <button class="btn btn-outline-primary w-100" type="button" 
                                @onclick="AbrirModalVariantes"
                                disabled="@string.IsNullOrEmpty(articulo.IdArticulo)">
                            <i class="bi bi-palette"></i> Gestionar Variantes
                            @if (variantes.Any())
                            {
                                <span class="badge bg-success ms-2">@variantes.Count</span>
                            }
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(articulo.IdArticulo) && variantes.Any())
                    {
                        <small class="text-muted">@variantes.Count variante(s) registrada(s)</small>
                    }
                </div>

                <!-- ESTACION -->
                <div class="mb-3">
                    <label class="form-label">Estación</label>
                    <div class="input-group">
                        <select class="form-control" @bind="articulo.Estacion" @bind:after="ActualizarDescripcion">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var c in estaciones)
                            {
                                <option value="@c.Descripcion">@c.Descripcion</option>
                            }
                        </select>
                        <button class="btn btn-outline-primary" type="button" title="Nuevo"
                                @onclick='() => OpenNuevoComplemento("ESTACION")'>
                            +
                        </button>
                    </div>
                </div>

                <!-- DETALLE -->
                <div class="mb-3">
                    <label class="form-label">Detalle</label>
                    <div class="input-group">
                        <select class="form-control" @bind="articulo.Detalle" @bind:after="ActualizarDescripcion">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var c in detalles)
                            {
                                <option value="@c.Descripcion">@c.Descripcion</option>
                            }
                        </select>
                        <button class="btn btn-outline-primary" type="button" title="Nuevo"
                                @onclick='() => OpenNuevoComplemento("DETALLE")'>
                            +
                        </button>
                    </div>
                </div>
            </div> <!-- /col-md-6 izquierda -->
            <!-- Derecha -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Proveedor</label>
                    <div class="input-group">
                        <input type="text" class="form-control" @bind="rucProveedor" @onblur="BuscarProveedorPorRuc" />
                        <button class="btn btn-secondary" @onclick="() => mostrarProveedorModal = true"><i class="bi bi-search"></i> Buscar</button>
                    </div>
                    <div class="mt-1"><strong>@nombreProveedor</strong></div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Unidad de Almacén</label>
                    <input type="text" class="form-control" @bind="articulo.UnidadAlmacen" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Moneda de Costeo</label>
                    <select class="form-control" @bind="articulo.MonedaCosteo">
                        <option value="SOLES">Soles</option>
                        <option value="DOLARES">Dólares</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Precio Compra</label>
                    <input type="number" class="form-control" @bind="articulo.PrecioCompra" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Precio Venta</label>
                    <input type="number" class="form-control" @bind="articulo.PrecioVenta" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Estado</label>
                    <InputSelect @bind-Value="articulo.Estado" class="form-control">
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </InputSelect>
                </div>

                <!-- Imagen del artículo -->
                <div class="mb-3 text-center">
                    <label class="form-label">Imagen del artículo</label><br />
                    <img src="@articulo.Foto" class="img-thumbnail" width="100" style="display: @(string.IsNullOrEmpty(articulo.Foto) ? "none" : "block")" />
                    <InputFile OnChange="UploadImage" accept="image/*" />
                </div>

                <!-- Código de barras -->
                <div class="mb-3 text-center">
                    <label class="form-label">Código de Barras</label><br />
                    <img src="https://barcode.tec-it.com/barcode.ashx?data=@(articulo.IdArticulo)&code=Code93" class="img-thumbnail" width="150" />
                    <div><strong>@articulo.IdArticulo</strong></div>
                    <button class="btn btn-success mt-2 me-2" @onclick="PrintBarcode"><i class="bi bi-printer"></i> Imprimir</button>
                    <button class="btn btn-info mt-2" @onclick="() => mostrarModalQR = true"><i class="bi bi-qr-code"></i> QR</button>
                </div>

            </div> <!-- /col-md-6 derecha -->
        </div> <!-- /row -->
        <!-- Botones -->
        <div class="text-center mt-3">
            <button class="btn btn-primary" @onclick="SaveArticulo"><i class="bi bi-floppy2"></i>  Guardar</button>
            <button class="btn btn-danger" @onclick="Cancel"><i class="bi bi-x-lg"></i> Cancelar</button>
        </div>
    </div>
}
else
{
    <p>Cargando...</p>
}

<!-- Modal QR (2-up) -->
@if (mostrarModalQR)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-4 text-center">
                <h4><i class="bi bi-qr-code"></i> Código QR</h4>
                <hr />
                <div class="etiqueta-imprimir">
                    <div class="label">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=@(articulo.IdArticulo)" />
                        <div class="desc">@articulo.DescripcionCorta</div>
                        <div class="code">Código: @articulo.IdArticulo</div>
                    </div>
                    <div class="label">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=@(articulo.IdArticulo)" />
                        <div class="desc">@articulo.DescripcionCorta</div>
                        <div class="code">Código: @articulo.IdArticulo</div>
                    </div>
                </div>
                <div class="mt-3 no-print">
                    <button class="btn btn-success me-2" @onclick="Imprimir"><i class="bi bi-printer"></i> Imprimir</button>
                    <button class="btn btn-secondary" @onclick="() => mostrarModalQR = false"><i class="bi bi-x-lg"></i> Cancelar</button>
                </div>
            </div>
        </div>
    </div>

    <style>
        @@media print {
            @@page {
                size: 100mm 50mm;
                margin: 0;
            }

            body * {
                visibility: hidden !important;
            }

            .etiqueta-imprimir, .etiqueta-imprimir * {
                visibility: visible !important;
            }

            .etiqueta-imprimir {
                position: fixed;
                inset: 0;
                width: 100mm;
                height: 50mm;
                display: flex;
                gap: 3mm;
            }

            .label {
                width: calc((100mm - 3mm)/2);
                height: 50mm;
                border: 1px solid #000;
                border-radius: .8mm;
                padding: 1.2mm;
                box-sizing: border-box;
                display: flex;
                flex-direction: column;
                gap: 1mm;
                justify-content: center;
                align-items: center;
            }

                .label img {
                    width: 22mm;
                    height: 22mm;
                    object-fit: contain;
                    display: block;
                }

            .desc {
                font-weight: 700;
                font-size: 8pt;
                line-height: 1.15;
                text-align: center;
            }

            .code {
                font-size: 7pt;
            }

            .no-print {
                display: none !important;
            }
        }
    </style>
}

<!-- Modal: Nuevo Complemento -->
@if (mostrarNuevoComplemento)
{
    <div class="modal-backdrop fade show" style="z-index: @(vieneDelModalVariantes ? "10002" : "1050");"></div>
    <div class="modal d-block" tabindex="-1" style="z-index: @(vieneDelModalVariantes ? "10003" : "1051");">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo @nuevoTipo</h5>
                    <button type="button" class="btn-close" @onclick="CloseNuevoComplemento"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Tipo</label>
                        <input class="form-control" value="@nuevoTipo" readonly />
                    </div>
                    <div class="mb-3">
                        <label>Descripción</label>
                        <input class="form-control" @bind="nuevoDescripcion" />
                    </div>
                    <div class="mb-3">
                        <label>Alias (opcional)</label>
                        <input class="form-control" @bind="nuevoAlias" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="CrearNuevoComplemento">Guardar</button>
                    <button class="btn btn-secondary" @onclick="CloseNuevoComplemento">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Seleccionar Variante para Impresión -->
@if (mostrarModalSeleccionVarianteImpresion)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Seleccionar Variante para Imprimir</h5>
                    <button type="button" class="btn-close" @onclick="() => mostrarModalSeleccionVarianteImpresion = false"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">Seleccione la variante que desea imprimir:</p>
                    <div class="list-group">
                        @foreach (var variante in variantes)
                        {
                            <button type="button" 
                                    class="list-group-item list-group-item-action"
                                    @onclick="() => ImprimirVariante(variante)">
                                <strong>@variante.Color</strong> - <strong>@variante.Talla</strong>
                            </button>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => mostrarModalSeleccionVarianteImpresion = false">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

<ProveedorBuscarModal @bind-Mostrar="mostrarProveedorModal" OnSeleccionado="ProveedorSeleccionado" />

<!-- Modal: Gestionar Variantes -->
@if (mostrarModalVariantes)
{
    <div class="modal-backdrop fade show" style="z-index: 10000;"></div>
    <div class="modal d-block" tabindex="-1" style="z-index: 10001;">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-palette"></i> Variantes de Color/Talla - @articulo.IdArticulo</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalVariantes"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">Agregue las combinaciones de color y talla para este artículo</p>
                    
                    <div class="row mb-3">
                        <div class="col-md-5">
                            <label class="form-label">Color</label>
                            <div class="input-group">
                                <select class="form-select" @bind="nuevaVariante.Color">
                                    <option value="">-- Seleccionar Color --</option>
                                    @foreach (var c in colores)
                                    {
                                        <option value="@c.Descripcion">@c.Descripcion</option>
                                    }
                                </select>
                                <button class="btn btn-outline-primary" type="button" title="Nuevo Color"
                                        @onclick='() => OpenNuevoComplementoDesdeModal("COLOR")'>
                                    +
                                </button>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Talla</label>
                            <div class="input-group">
                                <select class="form-select" @bind="nuevaVariante.Talla">
                                    <option value="">-- Seleccionar Talla --</option>
                                    @foreach (var t in tallas)
                                    {
                                        <option value="@t.Descripcion">@t.Descripcion</option>
                                    }
                                </select>
                                <button class="btn btn-outline-primary" type="button" title="Nueva Talla"
                                        @onclick='() => OpenNuevoComplementoDesdeModal("TALLA")'>
                                    +
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-success w-100" @onclick="AgregarVariante">
                                <i class="bi bi-plus-lg"></i> Agregar
                            </button>
                        </div>
                    </div>

                    @if (variantes.Any())
                    {
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Color</th>
                                        <th>Talla</th>
                                        <th style="width: 100px;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in variantes)
                                    {
                                        <tr>
                                            <td>
                                                @v.Color
                                                @if (v.IdVariante < 0)
                                                {
                                                    <span class="badge bg-warning text-dark ms-1" title="Pendiente de guardar"><i class="bi bi-hourglass-split"></i></span>
                                                }
                                            </td>
                                            <td>@v.Talla</td>
                                            <td>
                                                <button class="btn btn-danger btn-sm w-100" 
                                                        @onclick="() => EliminarVariante(v.IdVariante)"
                                                        title="Eliminar">
                                                    <i class="bi bi-trash"></i> Eliminar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> No hay variantes registradas. Agregue combinaciones de color y talla arriba.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModalVariantes">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {

    [Parameter] public string? dummy { get; set; }

    private ArticuloDTO articulo = new();
    private List<ProveedorDTO>? proveedores = new();
    private bool isLoading = true;
    private bool yaInicializado = false;

    private bool mostrarModalQR = false;
    private bool mostrarProveedorModal = false;
    private bool mostrarModalVariantes = false;
    private bool mostrarModalSeleccionVarianteImpresion = false;

    // Complementos
    private List<ComplementoDTO> familias = new();
    private List<ComplementoDTO> lineas = new();
    private List<ComplementoDTO> marcas = new();
    private List<ComplementoDTO> materiales = new();
    private List<ComplementoDTO> modelos = new();
    private List<ComplementoDTO> colores = new();
    private List<ComplementoDTO> detalles = new();
    private List<ComplementoDTO> tallas = new();
    private List<ComplementoDTO> estaciones = new();

    // Modal nuevo complemento
    private bool mostrarNuevoComplemento = false;
    private string nuevoTipo = string.Empty;
    private string nuevoDescripcion = string.Empty;
    private string? nuevoAlias = string.Empty;
    private bool vieneDelModalVariantes = false;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        articulo.Estado = true;

        if (!yaInicializado)
        {
            isLoading = true;

            articulo = new ArticuloDTO();
            var nuevoId = await ArticuloService.GetNuevoIdArticulo();
            // Asegurar formato de 6 caracteres
            articulo.IdArticulo = nuevoId?.PadLeft(6, '0') ?? nuevoId;
            articulo.CodigoBarra = articulo.IdArticulo;

            proveedores = await ProveedorService.GetProveedores();

            // Cargar combos
            await LoadComplementos();

            yaInicializado = true;
            isLoading = false;

            StateHasChanged();
            await CargarVariantes();
        }
    }

    private async Task LoadComplementos()
    {
        familias = await ComplementoService.GetByTipo("FAMILIA");
        lineas = await ComplementoService.GetByTipo("LINEA");
        marcas = await ComplementoService.GetByTipo("MARCA");
        materiales = await ComplementoService.GetByTipo("MATERIAL");
        modelos = await ComplementoService.GetByTipo("MODELO");
        colores = await ComplementoService.GetByTipo("COLOR");
        detalles = await ComplementoService.GetByTipo("DETALLE");
        tallas = await ComplementoService.GetByTipo("TALLA");
        estaciones = await ComplementoService.GetByTipo("ESTACION");
    }

    private async Task ReloadTipo(string tipo)
    {
        switch (tipo)
        {
            case "FAMILIA": familias = await ComplementoService.GetByTipo(tipo); break;
            case "LINEA": lineas = await ComplementoService.GetByTipo(tipo); break;
            case "MARCA": marcas = await ComplementoService.GetByTipo(tipo); break;
            case "MATERIAL": materiales = await ComplementoService.GetByTipo(tipo); break;
            case "MODELO": modelos = await ComplementoService.GetByTipo(tipo); break;
            case "COLOR": colores = await ComplementoService.GetByTipo(tipo); break;
            case "DETALLE": detalles = await ComplementoService.GetByTipo(tipo); break;
            case "TALLA": tallas = await ComplementoService.GetByTipo(tipo); break;
            case "ESTACION": estaciones = await ComplementoService.GetByTipo(tipo); break;
        }
    }

    private void OpenNuevoComplemento(string tipo)
    {
        nuevoTipo = tipo;
        nuevoDescripcion = string.Empty;
        nuevoAlias = string.Empty;
        mostrarNuevoComplemento = true;
        vieneDelModalVariantes = false;
    }

    private void OpenNuevoComplementoDesdeModal(string tipo)
    {
        nuevoTipo = tipo;
        nuevoDescripcion = string.Empty;
        nuevoAlias = string.Empty;
        mostrarNuevoComplemento = true;
        vieneDelModalVariantes = true;
    }

    private void CloseNuevoComplemento()
    {
        mostrarNuevoComplemento = false;
        vieneDelModalVariantes = false;
    }

    private async Task CrearNuevoComplemento()
    {
        if (string.IsNullOrWhiteSpace(nuevoTipo) || string.IsNullOrWhiteSpace(nuevoDescripcion))
            return;

        var creado = await ComplementoService.Crear(nuevoTipo, nuevoDescripcion, nuevoAlias);
        if (creado is not null)
        {
            await ReloadTipo(nuevoTipo);
            
            // Si viene del modal de variantes, actualizar el campo correspondiente
            if (vieneDelModalVariantes)
            {
                if (nuevoTipo == "COLOR")
                {
                    nuevaVariante.Color = creado.Descripcion;
                }
                else if (nuevoTipo == "TALLA")
                {
                    nuevaVariante.Talla = creado.Descripcion;
                }
                vieneDelModalVariantes = false;
            }
            else
            {
                SetArticuloProp(nuevoTipo, creado.Descripcion);
                ActualizarDescripcion();
            }
            
            mostrarNuevoComplemento = false;
            StateHasChanged();
        }
    }

    private void SetArticuloProp(string tipo, string valor)
    {
        switch (tipo)
        {
            case "FAMILIA": articulo.Familia = valor; break;
            case "LINEA": articulo.Linea = valor; break;
            case "MARCA": articulo.Marca = valor; break;
            case "MATERIAL": articulo.Material = valor; break;
            case "MODELO": articulo.Modelo = valor; break;
            case "COLOR": articulo.Color = valor; break;
            case "TALLA": articulo.Talla = valor; break;
            case "ESTACION": articulo.Estacion = valor; break;
            case "DETALLE": articulo.Detalle = valor; break;
        }
    }

    private async Task Imprimir()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private void ActualizarDescripcion()
    {
        articulo.Descripcion =
            $"{articulo.Familia} {articulo.Linea} {articulo.Marca} {articulo.Material} {articulo.Modelo} {articulo.Detalle}".Trim();
        articulo.DescripcionCorta =
            $"{articulo.Familia} {articulo.Marca} {articulo.Modelo} {articulo.Detalle}".Trim();
    }

    private async Task SaveArticulo()
    {
        if (articulo.PrecioCompra == 0)
        {
            await JS.InvokeVoidAsync("alert", "⚠️ El Precio de Compra no puede ser 0.");
            return;
        }

        if (articulo.PrecioVenta == 0)
        {
            await JS.InvokeVoidAsync("alert", "⚠️ El Precio de Venta no puede ser 0.");
            return;
        }

        if (articulo.UnidadAlmacen == "string")
            articulo.UnidadAlmacen = null;

        // Asegurar formato de 6 caracteres para IdArticulo antes de guardar
        articulo.IdArticulo = articulo.IdArticulo?.PadLeft(6, '0') ?? articulo.IdArticulo;
        var idArticuloFormateado = articulo.IdArticulo;

        var creado = await ArticuloService.CreateArticulo(articulo);
        if (creado)
        {
            // Si el artículo se guardó exitosamente, asumir que existe
            // Esperar un momento para asegurar que la transacción se complete
            await Task.Delay(1000); // Aumentar delay a 1 segundo para dar más tiempo
            
            // Guardar todas las variantes pendientes directamente
            // No verificar existencia porque puede dar 404 por timing o caché
            var variantesGuardadas = 0;
            var variantesConError = 0;
            var erroresDetalle = new List<string>();
            
            if (variantesPendientes.Any())
            {
                    foreach (var variantePendiente in variantesPendientes.ToList())
                    {
                        // Asegurar que el IdArticulo esté en formato correcto
                        variantePendiente.IdArticulo = idArticuloFormateado;
                        
                        // Asegurar que IdVariante sea 0 (para que EF lo genere automáticamente)
                        // Las variantes pendientes tienen IdVariante negativo, debemos resetearlo
                        variantePendiente.IdVariante = 0;
                        
                        var (exito, mensajeError) = await ArticuloVarianteService.RegistrarVariante(variantePendiente);
                    if (exito)
                    {
                        variantesGuardadas++;
                    }
                    else
                    {
                        variantesConError++;
                        if (!string.IsNullOrEmpty(mensajeError))
                        {
                            erroresDetalle.Add(mensajeError);
                        }
                    }
                }
                
                variantesPendientes.Clear();
            }
            
            // Mostrar mensaje y redirigir
            string mensaje;
            if (variantesConError > 0)
            {
                var mensajeError = erroresDetalle.Any() 
                    ? $"\nDetalle: {string.Join("; ", erroresDetalle.Take(2))}"
                    : "";
                mensaje = $"✅ Artículo guardado correctamente.\n⚠️ {variantesConError} variante(s) no se pudieron guardar.{mensajeError}\nPuede agregarlas manualmente desde el menú de edición.";
            }
            else if (variantesGuardadas > 0)
            {
                mensaje = $"✅ Artículo guardado correctamente.\n✅ {variantesGuardadas} variante(s) guardada(s).";
            }
            else
            {
                mensaje = "✅ Artículo guardado correctamente.";
            }
            
            await JS.InvokeVoidAsync("alert", mensaje);
            
            // Redirigir al listado de artículos después de guardar
            Navigation.NavigateTo("/articulos");
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "❌ Error al guardar el artículo. Verifique los datos e intente nuevamente.");
        }
    }

    private ArticuloVarianteDTO nuevaVariante = new();
    private List<ArticuloVarianteDTO> variantes = new();
    private List<ArticuloVarianteDTO> variantesPendientes = new(); // Variantes que se guardarán cuando se guarde el artículo
    private int contadorVariantesPendientes = -1; // Contador negativo para identificar variantes pendientes

    private async Task AgregarVariante()
    {
        if (string.IsNullOrWhiteSpace(nuevaVariante.Color) || string.IsNullOrWhiteSpace(nuevaVariante.Talla))
        {
            await JS.InvokeVoidAsync("alert", "⚠️ Debe seleccionar Color y Talla.");
            return;
        }

        if (string.IsNullOrEmpty(articulo.IdArticulo))
        {
            await JS.InvokeVoidAsync("alert", "⚠️ El artículo debe tener un código.");
            return;
        }

        // Verificar si el artículo ya está guardado en la BD
        // Asegurar formato de 6 caracteres antes de verificar
        var idArticuloFormateado = articulo.IdArticulo?.PadLeft(6, '0') ?? articulo.IdArticulo;
        var articuloExiste = false;
        try
        {
            var articuloVerificado = await ArticuloService.GetArticuloById(idArticuloFormateado);
            articuloExiste = articuloVerificado != null;
        }
        catch
        {
            // Si hay error, asumir que no existe (esto evita mostrar errores 404 innecesarios)
            articuloExiste = false;
        }
        
        if (!articuloExiste)
        {
            // El artículo aún no está guardado, agregar a lista temporal
            var varianteTemp = new ArticuloVarianteDTO
            {
                IdArticulo = idArticuloFormateado, // Ya está formateado arriba
                Color = nuevaVariante.Color,
                Talla = nuevaVariante.Talla,
                IdVariante = contadorVariantesPendientes-- // ID negativo temporal
            };
            
            // Verificar que no se duplique
            if (variantes.Any(v => v.Color == varianteTemp.Color && v.Talla == varianteTemp.Talla))
            {
                await JS.InvokeVoidAsync("alert", "⚠️ Esta combinación de Color y Talla ya está en la lista.");
                return;
            }
            
            variantesPendientes.Add(varianteTemp);
            variantes.Add(varianteTemp); // Agregar también a la lista visible
            nuevaVariante = new();
            ActualizarDescripcion();
            await JS.InvokeVoidAsync("alert", "✅ Variante agregada (se guardará al guardar el artículo).");
            StateHasChanged();
        }
        else
        {
            // El artículo ya está guardado, guardar inmediatamente
            nuevaVariante.IdArticulo = idArticuloFormateado; // Ya está formateado arriba

            var (exito, mensajeError) = await ArticuloVarianteService.RegistrarVariante(nuevaVariante);
            if (exito)
            {
                await JS.InvokeVoidAsync("alert", "✅ Variante agregada correctamente.");
                await CargarVariantes();
                nuevaVariante = new();
                ActualizarDescripcion();
                StateHasChanged();
            }
            else
            {
                var mensaje = !string.IsNullOrEmpty(mensajeError) 
                    ? $"❌ Error al agregar la variante: {mensajeError}" 
                    : "❌ Error al agregar la variante. Verifique que el artículo esté guardado correctamente.";
                await JS.InvokeVoidAsync("alert", mensaje);
            }
        }
    }

    private async Task EliminarVariante(int id)
    {
        // Si el ID es negativo, es una variante pendiente
        if (id < 0)
        {
            var varianteAEliminar = variantes.FirstOrDefault(v => v.IdVariante == id);
            if (varianteAEliminar != null)
            {
                variantes.Remove(varianteAEliminar);
                variantesPendientes.RemoveAll(v => v.IdVariante == id);
                ActualizarDescripcion();
                StateHasChanged();
            }
        }
        else
        {
            // Variante guardada en BD, eliminar de BD
            var exito = await ArticuloVarianteService.EliminarVariante(id);
            if (exito)
            {
                await CargarVariantes();
                ActualizarDescripcion();
                StateHasChanged();
            }
        }
    }

    private async Task CargarVariantes()
    {
        if (!string.IsNullOrEmpty(articulo.IdArticulo))
        {
            var variantesGuardadas = await ArticuloVarianteService.ObtenerVariantesPorArticulo(articulo.IdArticulo);
            // Combinar variantes guardadas con las pendientes
            variantes = variantesGuardadas.Concat(variantesPendientes).ToList();
        }
    }

    private async Task AbrirModalVariantes()
    {
        if (string.IsNullOrEmpty(articulo.IdArticulo))
            return;
        
        // Asegurar que colores y tallas estén cargados
        if (!colores.Any())
            colores = await ComplementoService.GetByTipo("COLOR");
        if (!tallas.Any())
            tallas = await ComplementoService.GetByTipo("TALLA");
        
        await CargarVariantes();
        nuevaVariante = new();
        mostrarModalVariantes = true;
    }

    private void CerrarModalVariantes()
    {
        mostrarModalVariantes = false;
        nuevaVariante = new();
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/articulos");
    }

    private async Task PrintBarcode()
    {
        // Cargar variantes antes de verificar
        if (!string.IsNullOrEmpty(articulo.IdArticulo))
        {
            await CargarVariantes();
        }

        // Si tiene variantes, mostrar selector
        if (variantes.Any())
        {
            mostrarModalSeleccionVarianteImpresion = true;
            StateHasChanged();
            return;
        }

        // Sin variantes: abrir impresión en pestaña nueva (no NavigateTo forceLoad: pierde el estado del formulario)
        var q = BarcodePrintMetadataQuery.BuildPrintQuery(
            articulo.DescripcionCorta ?? string.Empty,
            articulo,
            articulo.PrecioVenta,
            articulo.Color,
            articulo.Talla);
        var url = Navigation.ToAbsoluteUri($"/barcode-print/{Uri.EscapeDataString(articulo.IdArticulo)}?{q}").ToString();
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task ImprimirVariante(ArticuloVarianteDTO variante)
    {
        // Determinar el código a imprimir
        // Si hay múltiples variantes, incluir sufijo -N
        string codigoParaImprimir = articulo.IdArticulo;

        if (variantes.Count > 1)
        {
            var indice = variantes.FindIndex(v => v.IdVariante == variante.IdVariante) + 1;
            codigoParaImprimir = $"{articulo.IdArticulo}-{indice}";
        }

        var q = BarcodePrintMetadataQuery.BuildPrintQuery(
            $"{articulo.DescripcionCorta} C/{variante.Color} T/{variante.Talla}",
            articulo,
            articulo.PrecioVenta,
            variante.Color,
            variante.Talla);

        var url = Navigation.ToAbsoluteUri($"/barcode-print/{Uri.EscapeDataString(codigoParaImprimir)}?{q}").ToString();
        await JS.InvokeVoidAsync("open", url, "_blank");
        mostrarModalSeleccionVarianteImpresion = false;
    }

    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5_000_000);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var imageBytes = ms.ToArray();
            var base64 = Convert.ToBase64String(imageBytes);
            articulo.Foto = $"data:{file.ContentType};base64,{base64}";
        }
    }

    private async Task BuscarProveedorPorRuc(FocusEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(rucProveedor))
            return;

        var resp = await ProveedorService.GetProveedorList(1, 1, rucProveedor);
        var prov = resp.Data.FirstOrDefault();
        if (prov != null)
        {
            articulo.IdProveedor = prov.IdProveedor;
            nombreProveedor = prov.Nombre;
        }
        else
        {
            nombreProveedor = "Proveedor no encontrado";
        }
    }

    private void ProveedorSeleccionado(ProveedorDTO prov)
    {
        articulo.IdProveedor = prov.IdProveedor;
        rucProveedor = prov.Ruc ?? string.Empty;
        nombreProveedor = prov.Nombre;
    }

    private string rucProveedor = string.Empty;
    private string nombreProveedor = string.Empty;
}