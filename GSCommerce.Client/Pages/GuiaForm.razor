@page "/guias-form/{tipo}"
@page "/guias-form/{tipo}/{idOC:int?}"
@**@
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Navigation
@inject MovimientoGuiaService MovimientoGuiaService
@inject AlmacenService AlmacenService
@inject StockService StockService
@inject IJSRuntime JS
@inject ProveedorService ProveedorService
@inject OrdenCompraService OrdenCompraService
@inject ArticuloService ArticuloService
@using System.Linq

@using GSCommerce.Client.Models
@using GSCommerce.Client.Services

@if (isLoading)
{
    <p>Cargando...</p>
}
else
{
    <h3>@titulo</h3>

    <div class="card p-4 mb-3">
        <div class="row">
            <div class="col-md-4">
                <label class="form-label"><i class="bi bi-box-seam-fill"></i> Almacén</label>
                <select class="form-control" @bind="guia.IdAlmacen">
                    <option disabled value="0">-- Seleccionar --</option>
                    @foreach (var a in almacenes)
                    {
                        <option value="@a.IdAlmacen">@a.Nombre</option>
                    }
                </select>
            </div>

            @if (mostrarDestino)
            {
                <div class="col-md-4">
                    <label class="form-label">Almacén Destino</label>
                    <select class="form-control" @bind="guia.IdAlmacenDestinoOrigen">
                        <option disabled value="0">-- Seleccionar --</option>
                        @foreach (var a in almacenes)
                        {
                            <option value="@a.IdAlmacen">@a.Nombre</option>
                        }
                    </select>
                </div>
            }

            <div class="col-md-4">
                <label class="form-label">Motivo</label>
                <select class="form-control" @bind="guia.Motivo">
                    @foreach (var m in motivos)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </div>
        </div>

        @if (mostrarProveedor)
        {
            <div class="row mt-3">
                <div class="col-md-6">
                    <label class="form-label">Proveedor</label>
                    <input class="form-control"
                           list="proveedoresList"
                           @bind="proveedorNombre"
                           @bind:event="oninput"
                           @bind:after="SincronizarProveedor"
                           placeholder="Buscar proveedor..." />
                    <datalist id="proveedoresList">
                        @foreach (var p in proveedores)
                        {
                            <option value="@p.Nombre"></option>
                        }
                    </datalist>
                </div>
            </div>
        }

        <div class="row mt-3">
            <div class="col-md-12">
                <label class="form-label">Descripción</label>
                <textarea class="form-control" rows="2" @bind="guia.Descripcion"></textarea>
            </div>
        </div>
    </div>
    <h5><i class="bi bi-box-seam-fill"></i>  Detalle de Artículos</h5>
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Código</th>
                <th>Descripción</th>
                <th class="text-end">Cantidad</th>
                <th class="text-end">Valor</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in guia.Detalles)
            {
                <tr>
                    <td>@d.Item</td>
                    <td><input class="form-control"
               @bind="d.IdArticulo"
               @bind:after="() => NormalizarCodigoArticulo(d)"
               @onblur="() => BuscarArticulo(d)"
               data-item="@d.Item" /></td>
                    <td><input class="form-control" value="@d.DescripcionArticulo" readonly /></td>
                    <td><input class="form-control text-end" type="number" @bind="d.Cantidad" @bind:after="() => OnCantidadChange(d)" @onkeydown="@((e) => OnCantidadKeyDown(e, d))" /></td>
                    <td><input class="form-control text-end" type="number" step="0.01" @bind="d.Valor" /></td>
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="@(() => QuitarArticulo(d))">❌</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-outline-primary mb-3" @onclick="AgregarArticulo">+ Agregar Artículo</button>

    <div class="alert alert-info">Total artículos: <strong>@totalArticulos</strong></div>
    <div class="text-center mt-3">
        <button class="btn btn-success" @onclick="Guardar" disabled="@guardando">
            @if (guardando)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-floppy2"></i>
            }
            Guardar
        </button>
        <button class="btn btn-secondary" @onclick="Cancelar" disabled="@guardando"><i class="bi bi-x-lg"></i> Cancelar</button>
    </div>
}

@code {
    [Parameter] public string tipo { get; set; } = "Ingreso"; // Ingreso, Egreso, Transferencia, IngresoXOC
    [Parameter] public int? idOC { get; set; }
    [Inject] AuxiliaresVariosService AuxiliaresVariosService { get; set; } = default!;


    private MovimientoGuiaDTO guia = new();
    private List<AlmacenDTO> almacenes = new();
    private List<ProveedorDTO> proveedores = new();
    private List<string> motivos = new();
    private bool isLoading = true;
    private bool guardando = false;
    private string titulo = "";
    private int totalArticulos = 0;
    private string tipoMovimiento = ""; // I, E, T
    private string proveedorNombre = string.Empty;
    // Diccionario para almacenar el stock disponible de cada artículo
    private Dictionary<string, int> stockPorArticulo = new Dictionary<string, int>();

    private bool mostrarDestino => tipo == "Transferencia" || tipo == "IngresoXOC";
    private bool mostrarProveedor => tipo == "Ingreso" || tipo == "IngresoXOC" || guia.Motivo == "DEVOLUCION A PROVEEDOR";

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        almacenes = await AlmacenService.GetAlmacenes() ?? new();
        proveedores = await ProveedorService.GetProveedores() ?? new();

        guia.Fecha = DateTime.Now;
        guia.IdUsuario = 1; // esto debe venir del login
        guia.Estado = "E";

        tipoMovimiento = tipo switch
        {
            "Ingreso" => "I",
            "Egreso" => "E",
            "Transferencia" => "T",
            "IngresoXOC" => "I", // mismo que Ingreso
            _ => "I"
        };

        titulo = tipo switch
        {
            "Ingreso" => "📥 Nueva Guía de Ingreso",
            "Egreso" => "📤 Nueva Guía de Egreso",
            "Transferencia" => "🔁 Nueva Transferencia",
            "IngresoXOC" => "📦 Ingreso por Orden de Compra",
            _ => "📥 Nueva Guía"
        };

        CargarMotivos();

        // Si es IngresoXOC: aquí debería cargarse info de la OC
        if (tipo == "IngresoXOC" && idOC.HasValue)
        {
            var orden = await OrdenCompraService.ObtenerOrdenPorId(idOC.Value);

            if (orden != null)
            {
                guia.IdOc = orden.IdOc;
                guia.Motivo = "COMPRA A PROVEEDOR";
                guia.IdProveedor = orden.IdProveedor;
                guia.Descripcion = $"Ingreso de artículos según OC {orden.NumeroOc}";
                guia.Detalles = orden.Detalles.Select(d => new MovimientoDetalleDTO
                    {
                        Item = d.Item,
                        IdArticulo = d.IdArticulo,
                        DescripcionArticulo = d.DescripcionArticulo,
                        Cantidad = d.Cantidad,
                        Valor = d.CostoUnitario
                    }).ToList();
            }
            else
            {
                await MostrarAlerta("❌ No se pudo obtener datos de la orden de compra.");
                Navigation.NavigateTo("/guias?tipo=" + tipo);
                return;
            }
        }
        else
        {
            guia.Motivo = motivos.FirstOrDefault() ?? "";
            guia.Detalles = new List<MovimientoDetalleDTO>
    {
        new MovimientoDetalleDTO { Item = 1, Cantidad = 1, Valor = 0 }
    };
        }

        guia.Detalles = new List<MovimientoDetalleDTO>();
        guia.Detalles.Add(new MovimientoDetalleDTO { Item = 1, Cantidad = 1, Valor = 0 });
        CalcularTotalArticulos();

        proveedorNombre = proveedores.FirstOrDefault(p => p.IdProveedor == guia.IdProveedor)?.Nombre ?? string.Empty;

        isLoading = false;


    }

    // Normalizar código de artículo a 6 dígitos con ceros a la izquierda
    private void NormalizarCodigoArticulo(MovimientoDetalleDTO d)
    {
        if (string.IsNullOrWhiteSpace(d.IdArticulo))
            return;

        var codigo = d.IdArticulo.Trim();

        // Si es un número, normalizar a 6 dígitos
        if (int.TryParse(codigo, out int numero))
        {
            d.IdArticulo = numero.ToString("D6"); // D6 = 6 dígitos con ceros a la izquierda
        }
        else if (codigo.Length < 6)
        {
            // Si no es numérico pero tiene menos de 6 caracteres, rellenar con ceros a la izquierda
            d.IdArticulo = codigo.PadLeft(6, '0');
        }
        else if (codigo.Length > 6)
        {
            // Si tiene más de 6 caracteres, truncar
            d.IdArticulo = codigo.Substring(0, 6);
        }
    }

    //PARA BUSCAR EL ARTICULO
    private async Task BuscarArticulo(MovimientoDetalleDTO d)
    {
        if (string.IsNullOrWhiteSpace(d.IdArticulo))
            return;

        // Normalizar el código antes de buscar
        NormalizarCodigoArticulo(d);
        var codigoNormalizado = d.IdArticulo;

        // Validar que el almacén esté seleccionado (necesario para validar stock)
        if (guia.IdAlmacen <= 0)
        {
            await MostrarAlerta("❌ Debe seleccionar un almacén antes de buscar artículos.");
            d.IdArticulo = string.Empty;
            d.DescripcionArticulo = string.Empty;
            StateHasChanged();
            return;
        }

        // Buscar el artículo
        var art = await ArticuloService.GetArticuloById(codigoNormalizado);

        if (art != null)
        {
            d.DescripcionArticulo = art.Descripcion;

            // Validar stock en el almacén para TODOS los tipos de movimiento
            var idAlmacen = guia.IdAlmacen;
            int stockDisponible;
            
            // Para transferencias, usar el método que considera transferencias pendientes
            if (tipo == "Transferencia")
            {
                stockDisponible = await StockService.GetStockDisponibleParaTransferencia(codigoNormalizado, idAlmacen);
            }
            else
            {
                stockDisponible = await StockService.GetStockDisponible(codigoNormalizado, idAlmacen);
            }

            // Guardar el stock disponible para validar cantidad después
            stockPorArticulo[codigoNormalizado] = stockDisponible;

            if (stockDisponible <= 0)
            {
                // Para transferencias y egresos: bloquear si no hay stock
                if (tipo == "Transferencia" || tipo == "Egreso")
                {
                    await MostrarAlerta($"⚠️ El artículo '{codigoNormalizado}' no tiene stock en el almacén seleccionado.");
                    // Limpiar el código y descripción para no permitir continuar
                    d.IdArticulo = string.Empty;
                    d.DescripcionArticulo = string.Empty;
                    stockPorArticulo.Remove(codigoNormalizado);
                    StateHasChanged();
                    return;
                }
                // Para ingresos: mostrar advertencia pero permitir continuar (puede ser un ingreso nuevo)
                else
                {
                    await MostrarAlerta($"⚠️ Advertencia: El artículo '{codigoNormalizado}' no tiene stock en el almacén seleccionado. Puede continuar si está ingresando nuevo stock.");
                }
            }
        }
        else
        {
            d.DescripcionArticulo = string.Empty;
            await MostrarAlerta($"❌ Artículo '{codigoNormalizado}' no encontrado.");
            // Limpiar el código si no se encuentra
            d.IdArticulo = string.Empty;
            // Remover del diccionario de stock si existe
            if (stockPorArticulo.ContainsKey(codigoNormalizado))
            {
                stockPorArticulo.Remove(codigoNormalizado);
            }
            StateHasChanged();
        }
    }

    //Cancelar
    private void Cancelar()
    {
        Navigation.NavigateTo("/guias?tipo=" + tipo); // Redirige con filtro
    }

    private async Task Guardar()
    {
        if (guardando) return; // Prevenir doble ejecución

        // Limpia detalles vacíos o inválidos
        guia.Detalles = guia.Detalles
            .Where(d => !string.IsNullOrWhiteSpace(d.IdArticulo) && d.Cantidad > 0)
            .ToList();

        if (!guia.Detalles.Any())
        {
            await MostrarAlerta("Debe ingresar al menos un artículo con cantidad válida.");
            return;
        }

        // Asegura que los items estén correctamente enumerados
        ReordenarItems();

        // Asigna el tipo real (I, E, T) antes de enviar
        guia.Tipo = tipoMovimiento;

        // Si es transferencia, SIEMPRE egreso en el emisor:
        if (tipo == "Transferencia")
        {
            guia.Motivo = "TRANSFERENCIA EGRESO";

            // Validar stock disponible en el almacén de origen
            foreach (var d in guia.Detalles)
            {
                var stockDisponible = await StockService.GetStockDisponibleParaTransferencia(d.IdArticulo, guia.IdAlmacen);
                if (stockDisponible < d.Cantidad)
                {
                    await MostrarAlerta($"❌ Stock insuficiente para el artículo '{d.IdArticulo}'. Disponible: {stockDisponible}, requerido: {d.Cantidad}.");
                    return;
                }
            }
        }

        guardando = true;
        try
        {
            bool ok;
            if (tipo == "Transferencia")
            {
                ok = await MovimientoGuiaService.CreateMovimiento(guia);
            }
            else
            {
                ok = await MovimientoGuiaService.CreateMovimientoConSP(guia);
            }

            if (ok)
            {
                Navigation.NavigateTo("/guias?tipo=" + tipo);
            }
            else
            {
                await MostrarAlerta("❌ Ocurrió un error al guardar la guía.");
            }
        }
        finally
        {
            guardando = false;
        }
    }

    private void OnProveedorChanged(ChangeEventArgs e)
    {
        proveedorNombre = e.Value?.ToString() ?? string.Empty;
        var prov = proveedores.FirstOrDefault(p => p.Nombre.Equals(proveedorNombre, System.StringComparison.OrdinalIgnoreCase));
        guia.IdProveedor = prov?.IdProveedor;
    }

    private async Task MostrarAlerta(string mensaje)
    {
        await JS.InvokeVoidAsync("alert", mensaje);
    }

    private void AgregarArticulo()
    {
        int nuevoItem = guia.Detalles.Count + 1;
        guia.Detalles.Add(new MovimientoDetalleDTO
            {
                Item = nuevoItem,
                Cantidad = 1,
                Valor = 0
            });

        CalcularTotalArticulos();
    }

    private void QuitarArticulo(MovimientoDetalleDTO item)
    {
        guia.Detalles.Remove(item);
        ReordenarItems();
        CalcularTotalArticulos();
    }

    private void SincronizarProveedor()
    {
        var prov = proveedores.FirstOrDefault(p =>
            p.Nombre.Equals(proveedorNombre, StringComparison.OrdinalIgnoreCase));
        guia.IdProveedor = prov?.IdProveedor;
    }

    private void ReordenarItems()
    {
        int i = 1;
        foreach (var d in guia.Detalles)
        {
            d.Item = i++;
        }
    }

    private void CalcularTotalArticulos()
    {
        totalArticulos = guia.Detalles.Sum(d => d.Cantidad);
    }

    // Validar cantidad vs stock disponible
    private async Task OnCantidadChange(MovimientoDetalleDTO d)
    {
        CalcularTotalArticulos();
        StateHasChanged();

        // Solo validar stock para transferencias y egresos
        if ((tipo == "Transferencia" || tipo == "Egreso") && !string.IsNullOrWhiteSpace(d.IdArticulo))
        {
            var codigoNormalizado = d.IdArticulo.Trim();
            
            // Si tenemos el stock almacenado, validar
            if (stockPorArticulo.ContainsKey(codigoNormalizado))
            {
                var stockDisponible = stockPorArticulo[codigoNormalizado];
                
                if (d.Cantidad > stockDisponible)
                {
                    await MostrarAlerta($"❌ No hay stock suficiente ({stockDisponible} en total) para el artículo '{codigoNormalizado}'. Cantidad solicitada: {d.Cantidad}.");
                    // Restaurar cantidad al stock disponible
                    d.Cantidad = stockDisponible;
                    CalcularTotalArticulos();
                    StateHasChanged();
                }
            }
            else
            {
                // Si no tenemos el stock almacenado, consultarlo
                if (guia.IdAlmacen > 0)
                {
                    int stockDisponible;
                    // Para transferencias, usar el método que considera transferencias pendientes
                    if (tipo == "Transferencia")
                    {
                        stockDisponible = await StockService.GetStockDisponibleParaTransferencia(codigoNormalizado, guia.IdAlmacen);
                    }
                    else
                    {
                        stockDisponible = await StockService.GetStockDisponible(codigoNormalizado, guia.IdAlmacen);
                    }
                    stockPorArticulo[codigoNormalizado] = stockDisponible;
                    
                    if (d.Cantidad > stockDisponible)
                    {
                        await MostrarAlerta($"❌ No hay stock suficiente ({stockDisponible} en total) para el artículo '{codigoNormalizado}'. Cantidad solicitada: {d.Cantidad}.");
                        // Restaurar cantidad al stock disponible
                        d.Cantidad = stockDisponible;
                        CalcularTotalArticulos();
                        StateHasChanged();
                    }
                }
            }
        }
    }

    // Manejar tecla Enter en el campo cantidad para agregar nuevo artículo
    private async Task OnCantidadKeyDown(KeyboardEventArgs e, MovimientoDetalleDTO d)
    {
        if (e.Key == "Enter")
        {
            // Validar cantidad antes de agregar
            await OnCantidadChange(d);
            // Agregar nuevo artículo
            var nuevoItem = guia.Detalles.Count + 1;
            AgregarArticulo();
            StateHasChanged();
            
            // Esperar un poco para que el DOM se actualice y luego enfocar el nuevo campo código
            await Task.Delay(100);
            await EnfocarInputCodigo(nuevoItem);
        }
    }

    // Enfocar el input de código de un artículo específico usando JavaScript
    private async Task EnfocarInputCodigo(int item)
    {
        await JS.InvokeVoidAsync("eval", $@"
            setTimeout(function() {{
                var input = document.querySelector('input[data-item=""{item}""]');
                if (input) {{
                    input.focus();
                    input.select();
                }} else {{
                    // Fallback: buscar por posición en la tabla
                    var rows = document.querySelectorAll('tbody tr');
                    if (rows.length >= {item}) {{
                        var targetRow = rows[{item} - 1];
                        var codigoInput = targetRow.querySelector('td:nth-child(2) input');
                        if (codigoInput) {{
                            codigoInput.focus();
                            codigoInput.select();
                        }}
                    }}
                }}
            }}, 50);
        ");
    }

    private async Task CargarMotivos()
    {
        motivos = await AuxiliaresVariosService.ObtenerMotivosPorTipo(tipo);
        guia.Motivo = motivos.FirstOrDefault() ?? "";
    }
}
