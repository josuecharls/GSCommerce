@page "/almacen"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "ADMINISTRADOR")]
@using GSCommerce.Client.Models
@using GSCommerce.Client.Services
@inject AlmacenService AlmacenService
@inject NavigationManager Navigation

@using Microsoft.AspNetCore.Components.Forms
@using System.Linq

<h3><i class="bi bi-box-seam-fill"></i>  Gestión de Almacenes</h3>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @mensajeClase alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" @onclick="() => mensaje = null"></button>
    </div>
}

<div class="d-flex justify-content-end align-items-center mb-3">
    <div class="input-group w-50">
        <input type="text" @bind="searchTerm" placeholder="Buscar por nombre..." class="form-control" />
        <button @onclick="SearchAlmacen" class="btn btn-primary"><i class="bi bi-search"></i> Buscar</button>
    </div>
</div>

<table class="table table-striped table-responsive">

    <thead>
        <tr>
            <th @onclick='() => SortBy("Nombre")' style="cursor:pointer;">
                <i class="bi @(GetSortIcon("Nombre")) me-1"></i>Nombre
            </th>
            <th @onclick='() => SortBy("Direccion")' style="cursor:pointer;">
                <i class="bi @(GetSortIcon("Direccion")) me-1"></i>Dirección
            </th>
            <th @onclick='() => SortBy("Dpd")' style="cursor:pointer;">
                <i class="bi @(GetSortIcon("Dpd")) me-1"></i>Departamento
            </th>
            <th @onclick='() => SortBy("RazonSocial")' style="cursor:pointer;">
                <i class="bi @(GetSortIcon("RazonSocial")) me-1"></i>Razón Social
            </th>
            <th @onclick='() => SortBy("Estado")' style="cursor:pointer;">
                <i class="bi @(GetSortIcon("Estado")) me-1"></i>Estado
            </th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (almacenList.Any())
        {
            @foreach (var a in almacenList)
            {
                <tr class="@(a.Estado ? "" : "table-secondary")">
                    <td>@a.Nombre</td>
                    <td>@a.Direccion</td>
                    <td>@a.Dpd</td>
                    <td>@a.RazonSocial</td>
                    <td>
                        @if (a.Estado)
                        {
                            <span class="badge bg-success">Habilitado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inhabilitado</span>
                        }
                    </td>
                    <td class="text-center text-nowrap">
                        <button @onclick="() => EditAlmacen(a.IdAlmacen)" class="btn btn-warning btn-sm me-1">
                            <i class="bi bi-pencil-square"></i> Editar
                        </button>
                        <button @onclick="() => AbrirCuentas(a.IdAlmacen)" class="btn btn-info btn-sm me-1">
                            <i class="bi bi-bank"></i> Cuentas
                        </button>
                        @if (a.Estado)
                        {
                            <button @onclick="() => ConfirmToggleEstado(a.IdAlmacen, a.Nombre, false)" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-slash-circle"></i> Deshabilitar
                            </button>
                        }
                        else
                        {
                            <button @onclick="() => ConfirmToggleEstado(a.IdAlmacen, a.Nombre, true)" class="btn btn-outline-success btn-sm">
                                <i class="bi bi-check-circle"></i> Habilitar
                            </button>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="6" class="text-center">Cargando... Espere...</td></tr>
        }
    </tbody>
</table>
<!-- Controles de paginación -->
<div class="d-flex justify-content-between">
    <button class="btn btn-secondary" @onclick="PrevPage" disabled="@(!CanPrev)">
        <i class="bi bi-arrow-left"></i> Anterior
    </button>
    <span>Página @currentPage de @totalPages</span>
    <button class="btn btn-secondary" @onclick="NextPage" disabled="@(!CanNext)">
        Siguiente <i class="bi bi-arrow-right"></i>
    </button>
</div>

@if (showEstadoModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(nuevoEstado ? "Habilitar almacén" : "Deshabilitar almacén")</h5>
                    <button type="button" class="btn-close" @onclick="CloseEstadoModal"></button>
                </div>
                <div class="modal-body">
                    @if (nuevoEstado)
                    {
                        <p>¿Desea <strong>habilitar</strong> el almacén <strong>@toggleAlmacenName</strong>?</p>
                        <p class="text-muted small mb-0">Volverá a aparecer en combos y reportes operativos.</p>
                    }
                    else
                    {
                        <p>¿Desea <strong>deshabilitar</strong> el almacén <strong>@toggleAlmacenName</strong>?</p>
                        <p class="text-muted small mb-0">Se ocultará de combos y reportes. El historial de ventas, stock y movimientos se conserva.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn @(nuevoEstado ? "btn-success" : "btn-danger")" @onclick="ToggleEstadoConfirmed" disabled="@isToggling">
                        @(nuevoEstado ? "Habilitar" : "Deshabilitar")
                    </button>
                    <button class="btn btn-secondary" @onclick="CloseEstadoModal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AlmacenDTO> almacenList = new();
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages;
    private string searchTerm = "";
    private bool isToggling = false;
    private bool showEstadoModal = false;
    private int toggleAlmacenId;
    private string toggleAlmacenName = "";
    private bool nuevoEstado;
    private string? mensaje;
    private string mensajeClase = "alert-info";

    private string currentSortColumn = "Nombre";
    private bool sortAscending = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAlmacen();
    }

    private async Task LoadAlmacen()
    {
        try
        {
            var response = await AlmacenService.GetAlmacenList(currentPage, pageSize, searchTerm);
            almacenList = SortList(response.Data);
            totalPages = response.TotalPages;
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al cargar almacenes: {ex.Message}", "alert-danger");
        }
    }

    private async Task SearchAlmacen()
    {
        currentPage = 1;
        await LoadAlmacen();
    }

    private async Task PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadAlmacen();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadAlmacen();
        }
    }

    private void EditAlmacen(int id)
    {
        Navigation.NavigateTo($"/almacen/edit/{id}");
    }

    private void AbrirCuentas(int id)
    {
        Navigation.NavigateTo($"/almacen-cuentas/{id}");
    }

    private void ConfirmToggleEstado(int id, string name, bool habilitar)
    {
        toggleAlmacenId = id;
        toggleAlmacenName = name;
        nuevoEstado = habilitar;
        showEstadoModal = true;
    }

    private void CloseEstadoModal()
    {
        showEstadoModal = false;
        toggleAlmacenId = 0;
        toggleAlmacenName = "";
    }

    private async Task ToggleEstadoConfirmed()
    {
        if (isToggling || toggleAlmacenId <= 0)
            return;

        isToggling = true;
        try
        {
            if (await AlmacenService.SetAlmacenEstado(toggleAlmacenId, nuevoEstado))
            {
                MostrarMensaje(
                    nuevoEstado
                        ? $"Almacén {toggleAlmacenName} habilitado correctamente."
                        : $"Almacén {toggleAlmacenName} deshabilitado. Ya no aparecerá en reportes ni combos.",
                    "alert-success");
                await LoadAlmacen();
            }
            else
            {
                MostrarMensaje("No se pudo actualizar el estado del almacén.", "alert-danger");
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al actualizar estado: {ex.Message}", "alert-danger");
        }
        finally
        {
            isToggling = false;
            CloseEstadoModal();
        }
    }

    private void MostrarMensaje(string texto, string clase)
    {
        mensaje = texto;
        mensajeClase = clase;
    }

    private void SortBy(string column)
    {
        if (currentSortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSortColumn = column;
            sortAscending = true;
        }

        almacenList = SortList(almacenList);
    }

    private List<AlmacenDTO> SortList(List<AlmacenDTO> list)
    {
        return currentSortColumn switch
        {
            "Nombre" => sortAscending
                ? list.OrderBy(a => a.Nombre).ToList()
                : list.OrderByDescending(a => a.Nombre).ToList(),
            "Direccion" => sortAscending
                ? list.OrderBy(a => a.Direccion).ToList()
                : list.OrderByDescending(a => a.Direccion).ToList(),
            "Dpd" => sortAscending
                ? list.OrderBy(a => a.Dpd).ToList()
                : list.OrderByDescending(a => a.Dpd).ToList(),
            "RazonSocial" => sortAscending
                ? list.OrderBy(a => a.RazonSocial).ToList()
                : list.OrderByDescending(a => a.RazonSocial).ToList(),
            "Estado" => sortAscending
                ? list.OrderBy(a => a.Estado).ToList()
                : list.OrderByDescending(a => a.Estado).ToList(),
            _ => list
        };
    }

    private string GetSortIcon(string column)
    {
        if (currentSortColumn != column)
            return "bi-arrow-down-up";
        return sortAscending ? "bi-arrow-up" : "bi-arrow-down";
    }

    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < totalPages;
}
