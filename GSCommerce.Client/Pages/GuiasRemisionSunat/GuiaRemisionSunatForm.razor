@page "/guias-remision-sunat/nueva"
@page "/guias-remision-sunat/editar/{Id:int}"
@using GSCommerce.Client.Models
@using GSCommerce.Client.Models.SUNAT
@using GSCommerce.Client.Services
@inject GuiaRemisionSunatService GuiaService
@inject AlmacenService AlmacenService
@inject ArticuloService ArticuloService
@inject ArticuloVarianteService ArticuloVarianteService
@inject AuthService AuthService
@inject ReniecService ReniecService
@inject SerieGuiaRemisionService SerieGuiaService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject DireccionRucService DireccionService

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">
            <i class="bi bi-truck text-primary me-2"></i>
            @(esEdicion ? "Editar" : "Nueva") Guía de Remisión Electrónica
        </h3>
        <button class="btn btn-outline-secondary" @onclick="Volver">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </button>
    </div>

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2">Cargando...</p>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <!-- Datos del documento -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <i class="bi bi-file-text me-2"></i>Datos del Documento
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Serie</label>
                                <input type="text" class="form-control bg-light" value="@guia.Serie" readonly 
                                       title="La serie se asigna automáticamente según el almacén seleccionado" />
                                @if (!string.IsNullOrEmpty(mensajeErrorSerie))
                                {
                                    <small class="text-danger">@mensajeErrorSerie</small>
                                }
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Fecha Emisión</label>
                                <input type="date" class="form-control" @bind="guia.FechaEmision" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tienda / Almacén Emisor</label>
                                <select class="form-select" @bind="guia.IdAlmacen" @bind:after="OnAlmacenChange">
                                    <option value="">Seleccione...</option>
                                    @foreach (var alm in almacenes)
                                    {
                                        <option value="@alm.IdAlmacen">@alm.Nombre - RUC: @alm.Ruc</option>
                                    }
                                </select>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(guia.RucRemitente))
                        {
                            <div class="row mt-3">
                                <div class="col-12">
                                    <div class="alert alert-info mb-0 py-2">
                                        <i class="bi bi-building me-2"></i>
                                        <strong>Emisor:</strong> @guia.RazonSocialRemitente (RUC: @guia.RucRemitente)
                                        <br/>
                                        <small class="text-muted">Este RUC se usará para firmar y enviar la guía a SUNAT</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Datos del destinatario -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-info text-white">
                        <i class="bi bi-person me-2"></i>Datos del Destinatario
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Tipo Doc.</label>
                                <select class="form-select" @bind="guia.TipoDocumentoDestinatario">
                                    <option value="6">RUC</option>
                                    <option value="1">DNI</option>
                                    <option value="4">Carnet Extranjería</option>
                                    <option value="7">Pasaporte</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Número Doc.</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" @bind="guia.NumeroDocumentoDestinatario" 
                                           maxlength="11" placeholder="@(guia.TipoDocumentoDestinatario == "6" ? "20XXXXXXXXX" : "DNI")" />
                                    @if (guia.TipoDocumentoDestinatario == "6")
                                    {
                                        <button class="btn btn-outline-primary" type="button" @onclick="BuscarRucDestinatario" 
                                                disabled="@buscandoRuc" title="Buscar datos del RUC">
                                            @if (buscandoRuc)
                                            {
                                                <span class="spinner-border spinner-border-sm"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-search"></i>
                                            }
                                        </button>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(mensajeRuc))
                                {
                                    <small class="@(rucEncontrado ? "text-success" : "text-danger")">@mensajeRuc</small>
                                }
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Razón Social / Nombre</label>
                                <input type="text" class="form-control" @bind="guia.RazonSocialDestinatario" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Ubigeo Destino</label>
                                <input type="text" class="form-control" @bind="guia.UbigeoLlegada" placeholder="150101" maxlength="6" />
                            </div>
                            <div class="col-md-9">
                                <label class="form-label">Dirección Destino</label>
                                <div class="input-group">
                                    <select class="form-select" value="@guia.DireccionLlegada" @onchange="OnDireccionDestinoChange">
                                        <option value="">-- Seleccione una dirección --</option>
                                        @foreach (var dir in direccionesDestino)
                                        {
                                            <option value="@dir.Direccion">@dir.DescripcionCompleta</option>
                                        }
                                        @if (!direccionesDestino.Any(d => d.Direccion == guia.DireccionLlegada) && !string.IsNullOrEmpty(guia.DireccionLlegada))
                                        {
                                            <option value="@guia.DireccionLlegada">@guia.DireccionLlegada</option>
                                        }
                                    </select>
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => AbrirModalDireccion(false)" 
                                            disabled="@(string.IsNullOrEmpty(guia.NumeroDocumentoDestinatario) || guia.TipoDocumentoDestinatario != "6")"
                                            title="Agregar nueva dirección para este RUC">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                                @if (string.IsNullOrEmpty(guia.NumeroDocumentoDestinatario))
                                {
                                    <small class="text-muted">Ingrese RUC para gestionar direcciones</small>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Datos del traslado -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-warning text-dark">
                        <i class="bi bi-signpost me-2"></i>Datos del Traslado
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Motivo de Traslado</label>
                                <select class="form-select" @bind="guia.MotivoTraslado">
                                    @foreach (var m in motivosTraslado)
                                    {
                                        <option value="@m.Codigo">@m.Codigo - @m.Descripcion</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Modalidad Transporte</label>
                                <select class="form-select" @bind="guia.ModalidadTraslado">
                                    <option value="02">02 - Transporte Privado</option>
                                    <option value="01">01 - Transporte Público</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Fecha Inicio Traslado</label>
                                <input type="date" class="form-control" @bind="guia.FechaInicioTraslado" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Peso Bruto (KG)</label>
                                <input type="number" class="form-control" @bind="guia.PesoBrutoTotal" step="0.01" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Nro. Bultos</label>
                                <input type="number" class="form-control" @bind="guia.NumeroBultos" 
                                       disabled="@guia.EsVehiculoM1L" title="@(guia.EsVehiculoM1L ? "No aplica para vehículos M1/L" : "")" />
                            </div>
                            @if (guia.MotivoTraslado == "13")
                            {
                                <div class="col-md-6">
                                    <label class="form-label">Descripción Motivo <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" @bind="guia.DescripcionMotivoTraslado" 
                                           placeholder="Obligatorio para motivo 'Otros'" />
                                </div>
                            }
                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" id="chkM1L" @bind="guia.EsVehiculoM1L" />
                                    <label class="form-check-label" for="chkM1L">
                                        <strong>Vehículo categoría M1 o L</strong>
                                        <small class="text-muted d-block">Automóviles, camionetas, motos. Si activa esta opción, no se requieren datos del conductor.</small>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Transporte -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-secondary text-white">
                        <i class="bi bi-truck me-2"></i>Datos del Transporte
                    </div>
                    <div class="card-body">
                        @if (guia.ModalidadTraslado == "01")
                        {
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">RUC Transportista</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" @bind="guia.RucTransportista" maxlength="11" />
                                        <button class="btn btn-outline-primary" type="button" @onclick="BuscarRucTransportista" 
                                                disabled="@buscandoRucTransportista" title="Buscar transportista">
                                            @if (buscandoRucTransportista)
                                            {
                                                <span class="spinner-border spinner-border-sm"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-search"></i>
                                            }
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label">Razón Social Transportista</label>
                                    <input type="text" class="form-control" @bind="guia.RazonSocialTransportista" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label">Placa Vehículo <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" @bind="guia.PlacaVehiculo" maxlength="7" placeholder="ABC123" />
                                </div>
                                @if (!guia.EsVehiculoM1L)
                                {
                                    <div class="col-12">
                                        <div class="alert alert-info py-2 mb-2">
                                            <i class="bi bi-info-circle me-1"></i>
                                            <small>Datos del conductor requeridos para vehículos que NO son M1/L (camiones, buses, etc.)</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">DNI Conductor <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" @bind="guia.NumeroDocumentoConductor" maxlength="8" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Nombres <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" @bind="guia.NombreConductor" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Apellidos <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" @bind="guia.ApellidoConductor" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Licencia Conducir <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" @bind="guia.LicenciaConductor" />
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-9">
                                        <div class="alert alert-secondary py-2 mb-0">
                                            <i class="bi bi-car-front me-1"></i>
                                            <small>Vehículo M1/L seleccionado: No se requieren datos del conductor para SUNAT.</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Punto de partida -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <i class="bi bi-geo-alt me-2"></i>Punto de Partida
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Ubigeo</label>
                                <input type="text" class="form-control" @bind="guia.UbigeoPartida" placeholder="150101" maxlength="6" />
                            </div>
                            <div class="col-md-9">
                                <label class="form-label">Dirección</label>
                                <div class="input-group">
                                    <select class="form-select" value="@guia.DireccionPartida" @onchange="OnDireccionPartidaChange">
                                        <option value="">-- Seleccione una dirección --</option>
                                        @foreach (var dir in direccionesPartida)
                                        {
                                            <option value="@dir.Direccion">@dir.DescripcionCompleta</option>
                                        }
                                        @if (!direccionesPartida.Any(d => d.Direccion == guia.DireccionPartida) && !string.IsNullOrEmpty(guia.DireccionPartida))
                                        {
                                            <option value="@guia.DireccionPartida">@guia.DireccionPartida</option>
                                        }
                                    </select>
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => AbrirModalDireccion(true)" 
                                            disabled="@string.IsNullOrEmpty(guia.RucRemitente)"
                                            title="Agregar nueva dirección para este RUC">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Observaciones -->
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <label class="form-label">Observaciones</label>
                        <textarea class="form-control" rows="2" @bind="guia.Observaciones"></textarea>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Detalle de artículos -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-box-seam me-2"></i>Bienes a Transportar</span>
                        <button class="btn btn-sm btn-light" @onclick="AgregarDetalle">
                            <i class="bi bi-plus"></i>
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                            <table class="table table-sm mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>#</th>
                                        <th>Código</th>
                                        <th>Descripción</th>
                                        <th>Cant.</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var det in guia.Detalles)
                                    {
                                        <tr>
                                            <td>@det.Item</td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" 
                                                       value="@det.IdArticulo" 
                                                       @onchange="async (e) => await OnCodigoArticuloChange(det, e.Value?.ToString() ?? string.Empty)" 
                                                       style="width: 80px;" />
                                            </td>
                                            <td>
                                                @if (det.ExisteEnBD)
                                                {
                                                    <input type="text" class="form-control form-control-sm bg-light" 
                                                           value="@det.DescripcionArticulo" readonly 
                                                           title="Artículo de la BD - descripción no editable" />
                                                }
                                                else
                                                {
                                                    <input type="text" class="form-control form-control-sm" 
                                                           @bind="det.DescripcionArticulo" 
                                                           placeholder="Descripción del artículo" />
                                                }
                                            </td>
                                            <td>
                                                <input type="number" class="form-control form-control-sm" 
                                                       @bind="det.Cantidad" style="width: 60px;" />
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarDetalle(det)">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer text-muted">
                        Total: @guia.Detalles.Count artículo(s)
                    </div>
                </div>

                <!-- Resumen del remitente -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <i class="bi bi-building me-2"></i>Datos del Remitente
                    </div>
                    <div class="card-body">
                        <p class="mb-1"><strong>RUC:</strong> @guia.RucRemitente</p>
                        <p class="mb-1"><strong>Razón Social:</strong> @guia.RazonSocialRemitente</p>
                        <p class="mb-0"><strong>Dirección:</strong> @guia.DireccionRemitente</p>
                    </div>
                </div>

                <!-- Botones de acción -->
                <div class="d-grid gap-2">
                    <button class="btn btn-success btn-lg" @onclick="Guardar" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-check-circle me-2"></i>Guardar Guía
                    </button>
                    
                    @if (esEdicion && !guia.EnviadoSunat)
                    {
                        <button class="btn btn-primary btn-lg" @onclick="GuardarYEnviar" disabled="@guardando">
                            <i class="bi bi-send me-2"></i>Guardar y Enviar a SUNAT
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Modal Nueva Dirección -->
    @if (mostrarModalDireccion)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5)">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">Agregar Dirección para @(esDireccionRemitente ? "Remitente" : "Destinatario")</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalDireccion"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">RUC Asociado</label>
                            <input type="text" class="form-control bg-light" value="@nuevaDireccion.Ruc" readonly />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Alias (Opcional)</label>
                            <input type="text" class="form-control" @bind="nuevaDireccion.Alias" placeholder="Ej: Sucursal Centro, Almacén A" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Dirección <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="nuevaDireccion.Direccion" />
                        </div>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label">Ubigeo <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" @bind="nuevaDireccion.Ubigeo" maxlength="6" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Dep/Prov/Dist</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="Departamento" @bind="nuevaDireccion.Departamento" />
                                    <input type="text" class="form-control" placeholder="Provincia" @bind="nuevaDireccion.Provincia" />
                                    <input type="text" class="form-control" placeholder="Distrito" @bind="nuevaDireccion.Distrito" />
                                </div>
                            </div>
                        </div>
                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox" id="chkDefault" @bind="nuevaDireccion.EsDefault">
                            <label class="form-check-label" for="chkDefault">
                                Establecer como dirección predeterminada
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModalDireccion">Cancelar</button>
                        <button type="button" class="btn btn-primary" @onclick="GuardarDireccion" disabled="@guardandoDireccion">
                            @if (guardandoDireccion)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Guardar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private GuiaRemisionSunatDTO guia = new();
    private List<AlmacenDTO> almacenes = new();
    private List<CatalogoItemDTO> motivosTraslado = new();

    private bool esEdicion => Id.HasValue && Id.Value > 0;
    private bool cargando = false;
    private bool guardando = false;
    private bool buscandoRuc = false;
    private string mensajeRuc = "";
    private bool rucEncontrado = false;
    private string mensajeErrorSerie = "";
    
    // Variables para gestión de direcciones
    private List<DireccionRucDTO> direccionesDestino = new();
    private List<DireccionRucDTO> direccionesPartida = new();
    private bool mostrarModalDireccion = false;
    private bool esDireccionRemitente = false;
    private DireccionRucDTO nuevaDireccion = new();
    private bool guardandoDireccion = false;
    private bool buscandoRucTransportista = false;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            almacenes = await AlmacenService.GetAlmacenes() ?? new();
            motivosTraslado = await GuiaService.ObtenerMotivosTraslado();

            if (motivosTraslado.Count == 0)
            {
                // Catálogo por defecto si no carga del servidor
                motivosTraslado = new List<CatalogoItemDTO>
                {
                    new() { Codigo = "01", Descripcion = "Venta" },
                    new() { Codigo = "02", Descripcion = "Compra" },
                    new() { Codigo = "04", Descripcion = "Traslado entre establecimientos" },
                    new() { Codigo = "06", Descripcion = "Devolución" },
                    new() { Codigo = "13", Descripcion = "Otros" }
                };
            }

            if (esEdicion)
            {
                var guiaExistente = await GuiaService.ObtenerGuiaAsync(Id!.Value);
                if (guiaExistente != null)
                {
                    guia = guiaExistente;
                }
            }
            else
            {
                // Valores por defecto (la serie se asigna al seleccionar almacén)
                guia.Serie = "";
                guia.FechaEmision = DateTime.Today;
                guia.FechaInicioTraslado = DateTime.Today;
                guia.MotivoTraslado = "01";
                guia.ModalidadTraslado = "02";
                guia.TipoDocumentoDestinatario = "6";
                guia.UnidadMedidaPeso = "KGM";
                guia.TipoDocumentoConductor = "1";

                var userId = await AuthService.GetUserId();
                guia.IdUsuario = userId;
            }
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task OnAlmacenChange()
    {
        mensajeErrorSerie = "";
        guia.Serie = "";
        
        if (guia.IdAlmacen.HasValue)
        {
            var alm = almacenes.FirstOrDefault(a => a.IdAlmacen == guia.IdAlmacen.Value);
            if (alm != null)
            {
                guia.RucRemitente = alm.Ruc ?? "";
                guia.RazonSocialRemitente = alm.RazonSocial ?? "";
                guia.DireccionRemitente = alm.Direccion ?? "";
                guia.UbigeoRemitente = alm.Ubigeo ?? "";
                guia.DireccionPartida = alm.Direccion ?? "";
                guia.UbigeoPartida = alm.Ubigeo ?? "";

                // Cargar direcciones del remitente
                await CargarDireccionesRemitente();
            }
            
            // Buscar la serie asignada a este almacén
            var serieAlmacen = await SerieGuiaService.ObtenerPorAlmacenAsync(guia.IdAlmacen.Value);
            if (serieAlmacen != null)
            {
                guia.Serie = serieAlmacen.Serie;
                mensajeErrorSerie = "";
            }
            else
            {
                guia.Serie = "";
                mensajeErrorSerie = "⚠ Este almacén no tiene serie de guía configurada";
            }
        }
    }

