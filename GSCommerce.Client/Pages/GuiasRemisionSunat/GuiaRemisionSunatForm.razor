    /// <summary>
    /// Busca un artículo por código (con soporte para variantes).
    /// Formato: XXXXXX o XXXXXX-N donde N es el índice de la variante (1-based)
    /// </summary>
    private async Task OnCodigoArticuloChange(GuiaRemisionDetalleItemDTO det, string codigo)
    {
        det.IdArticulo = codigo;
        det.ExisteEnBD = false;
        det.DescripcionArticulo = string.Empty;

        if (string.IsNullOrWhiteSpace(codigo))
        {
            return;
        }

        try
        {
            // Parsear el código para extraer el ID base y el índice de variante
            string idArticuloBase = codigo;
            int? varianteIndex = null;

            // Verificar si tiene formato XXXXXX-N
            if (codigo.Contains("-"))
            {
                var partes = codigo.Split('-');
                if (partes.Length == 2 && int.TryParse(partes[1], out int idx))
                {
                    idArticuloBase = partes[0];
                    varianteIndex = idx;
                }
            }

            // Formatear el ID a 6 caracteres
            var idFormateado = idArticuloBase.PadLeft(6, '0');

            // Buscar el artículo en la BD
            var articulo = await ArticuloService.GetArticuloById(idFormateado);

            if (articulo == null)
            {
                // Artículo no existe en la BD - permitir descripción manual
                det.ExisteEnBD = false;
                return;
            }

            // Artículo existe - construir descripción
            det.ExisteEnBD = true;
            string descripcionBase = articulo.Descripcion ?? articulo.DescripcionCorta ?? "";

            // Si tiene índice de variante, buscar la variante específica
            if (varianteIndex.HasValue)
            {
                var variantes = await ArticuloVarianteService.ObtenerVariantesPorArticulo(idFormateado);
                
                if (variantes != null && variantes.Count > 0)
                {
                    // El índice es 1-based
                    if (varianteIndex.Value >= 1 && varianteIndex.Value <= variantes.Count)
                    {
                        var variante = variantes[varianteIndex.Value - 1];
                        det.DescripcionArticulo = $"{descripcionBase} C/{variante.Color} T/{variante.Talla}";
                    }
                    else
                    {
                        // Índice fuera de rango - usar descripción base
                        det.DescripcionArticulo = descripcionBase;
                    }
                }
                else
                {
                    // No tiene variantes - usar descripción base
                    det.DescripcionArticulo = descripcionBase;
                }
            }
            else
            {
                // Sin índice de variante - usar descripción base
                det.DescripcionArticulo = descripcionBase;
            }
        }
        catch
        {
            // Error al buscar - permitir descripción manual
            det.ExisteEnBD = false;
        }

        StateHasChanged();
    }

    private async Task Guardar()
    {
        if (!Validar()) return;

        guardando = true;
        try
        {
            if (esEdicion)
            {
                var (ok, mensaje) = await GuiaService.ActualizarGuiaAsync(guia);
                await JS.InvokeVoidAsync("alert", mensaje);
                if (ok) Volver();
            }
            else
            {
                var (ok, mensaje, id) = await GuiaService.CrearGuiaAsync(guia);
                await JS.InvokeVoidAsync("alert", mensaje);
                if (ok) Volver();
            }
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task GuardarYEnviar()
    {
        if (!Validar()) return;

        guardando = true;
        try
        {
            // Primero guardar
            bool exitoGuardado;
            int idGuia = guia.IdGuiaRemision;

            if (esEdicion)
            {
                var (ok, _) = await GuiaService.ActualizarGuiaAsync(guia);
                exitoGuardado = ok;
            }
            else
            {
                var (ok, _, id) = await GuiaService.CrearGuiaAsync(guia);
                exitoGuardado = ok;
                idGuia = id;
            }

            if (exitoGuardado && idGuia > 0)
            {
                // Luego enviar a SUNAT
                var (okEnvio, mensajeEnvio, _) = await GuiaService.EnviarSunatAsync(idGuia);
                await JS.InvokeVoidAsync("alert", mensajeEnvio);
                Volver();
            }
        }
        finally
        {
            guardando = false;
        }
    }

    private bool Validar()
    {
        if (string.IsNullOrWhiteSpace(guia.Serie))
        {
            JS.InvokeVoidAsync("alert", "Ingrese la serie del documento");
            return false;
        }
        if (!guia.IdAlmacen.HasValue || guia.IdAlmacen <= 0)
        {
            JS.InvokeVoidAsync("alert", "Seleccione el almacén de origen");
            return false;
        }
        if (string.IsNullOrWhiteSpace(guia.NumeroDocumentoDestinatario))
        {
            JS.InvokeVoidAsync("alert", "Ingrese el documento del destinatario");
            return false;
        }
        if (string.IsNullOrWhiteSpace(guia.RazonSocialDestinatario))
        {
            JS.InvokeVoidAsync("alert", "Ingrese la razón social del destinatario");
            return false;
        }
        
        // Validación especial: Motivo 04 (Traslado entre establecimientos de la misma empresa)
        // El RUC del destinatario debe ser el mismo que el del remitente
        if (guia.MotivoTraslado == "04")
        {
            if (guia.TipoDocumentoDestinatario != "6")
            {
                JS.InvokeVoidAsync("alert", "Para traslado entre establecimientos, el destinatario debe tener RUC (no DNI)");
                return false;
            }
            if (guia.NumeroDocumentoDestinatario != guia.RucRemitente)
            {
                JS.InvokeVoidAsync("alert", $"Para traslado entre establecimientos de la misma empresa, el RUC del destinatario debe ser igual al del remitente ({guia.RucRemitente})");
                return false;
            }
        }
        if (string.IsNullOrWhiteSpace(guia.UbigeoLlegada))
        {
            JS.InvokeVoidAsync("alert", "Ingrese el ubigeo de destino");
            return false;
        }
        if (string.IsNullOrWhiteSpace(guia.DireccionLlegada))
        {
            JS.InvokeVoidAsync("alert", "Ingrese la dirección de destino");
            return false;
        }
        if (guia.Detalles.Count == 0)
        {
            JS.InvokeVoidAsync("alert", "Agregue al menos un artículo a transportar");
            return false;
        }
        
        // Validaciones de transporte privado
        if (guia.ModalidadTraslado == "02")
        {
            if (string.IsNullOrWhiteSpace(guia.PlacaVehiculo))
            {
                JS.InvokeVoidAsync("alert", "Ingrese la placa del vehículo");
                return false;
            }
            
            // Si NO es vehículo M1/L, se requieren datos del conductor
            if (!guia.EsVehiculoM1L)
            {
                if (string.IsNullOrWhiteSpace(guia.NumeroDocumentoConductor))
                {
                    JS.InvokeVoidAsync("alert", "Ingrese el DNI del conductor");
                    return false;
                }
                if (string.IsNullOrWhiteSpace(guia.NombreConductor))
                {
                    JS.InvokeVoidAsync("alert", "Ingrese los nombres del conductor");
                    return false;
                }
                if (string.IsNullOrWhiteSpace(guia.ApellidoConductor))
                {
                    JS.InvokeVoidAsync("alert", "Ingrese los apellidos del conductor");
                    return false;
                }
                if (string.IsNullOrWhiteSpace(guia.LicenciaConductor))
                {
                    JS.InvokeVoidAsync("alert", "Ingrese la licencia del conductor");
                    return false;
                }
            }
        }
        
        return true;
    }

    private async Task BuscarRucDestinatario()
    {
        if (string.IsNullOrWhiteSpace(guia.NumeroDocumentoDestinatario) || 
            guia.NumeroDocumentoDestinatario.Length != 11)
        {
            mensajeRuc = "Ingrese un RUC válido de 11 dígitos";
            rucEncontrado = false;
            return;
        }

        buscandoRuc = true;
        mensajeRuc = "";
        rucEncontrado = false;

        try
        {
            var datos = await ReniecService.ObtenerDatosCompletosRUC(guia.NumeroDocumentoDestinatario);
            
            if (datos != null)
            {
                // Auto-llenar datos del destinatario
                guia.RazonSocialDestinatario = datos.RazonSocial ?? "";
                guia.DireccionLlegada = datos.DireccionCompleta ?? datos.direccion ?? "";
                
                // Usar ubigeo_sunat si existe, sino el último elemento del array ubigeo
                if (!string.IsNullOrEmpty(datos.UbigeoSunat))
                {
                    guia.UbigeoLlegada = datos.UbigeoSunat;
                }
                else if (datos.ubigeo != null && datos.ubigeo.Length >= 3)
                {
                    guia.UbigeoLlegada = datos.ubigeo[2]; // El tercer elemento es el ubigeo completo
                }

                mensajeRuc = $"✓ {datos.estado} - {datos.condicion}";
                rucEncontrado = datos.estado == "ACTIVO" && datos.condicion == "HABIDO";
                
                if (!rucEncontrado)
                {
                    mensajeRuc = $"⚠ {datos.estado} - {datos.condicion}";
                }

                // Cargar direcciones guardadas
                await CargarDireccionesDestinatario();
            }
            else
            {
                mensajeRuc = "RUC no encontrado";
                rucEncontrado = false;
            }
        }
        catch (Exception ex)
        {
            mensajeRuc = $"Error: {ex.Message}";
            rucEncontrado = false;
        }
        finally
        {
            buscandoRuc = false;
            StateHasChanged();
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/guias-remision-sunat");
    }

    #region Gestión de Direcciones
    private async Task CargarDireccionesRemitente()
    {
        if (!string.IsNullOrEmpty(guia.RucRemitente))
        {
            direccionesPartida = await DireccionService.ObtenerDireccionesPorRuc(guia.RucRemitente);
        }
    }

    private async Task CargarDireccionesDestinatario()
    {
        if (!string.IsNullOrEmpty(guia.NumeroDocumentoDestinatario))
        {
            direccionesDestino = await DireccionService.ObtenerDireccionesPorRuc(guia.NumeroDocumentoDestinatario);
            
            // Si hay default y el campo está vacío, usarlo
            if (string.IsNullOrEmpty(guia.DireccionLlegada))
            {
                var def = direccionesDestino.FirstOrDefault(d => d.EsDefault);
                if (def != null)
                {
                    guia.DireccionLlegada = def.Direccion;
                    guia.UbigeoLlegada = def.Ubigeo;
                }
            }
        }
    }

    private void OnDireccionDestinoChange(ChangeEventArgs e)
    {
        var dirSeleccionada = e.Value?.ToString();
        if (!string.IsNullOrEmpty(dirSeleccionada))
        {
            guia.DireccionLlegada = dirSeleccionada;
            var dirObj = direccionesDestino.FirstOrDefault(d => d.Direccion == dirSeleccionada);
            if (dirObj != null)
            {
                guia.UbigeoLlegada = dirObj.Ubigeo;
            }
        }
    }

    private void OnDireccionPartidaChange(ChangeEventArgs e)
    {
        var dirSeleccionada = e.Value?.ToString();
        if (!string.IsNullOrEmpty(dirSeleccionada))
        {
            guia.DireccionPartida = dirSeleccionada;
            var dirObj = direccionesPartida.FirstOrDefault(d => d.Direccion == dirSeleccionada);
            if (dirObj != null)
            {
                guia.UbigeoPartida = dirObj.Ubigeo;
            }
        }
    }

    private void AbrirModalDireccion(bool esRemitente)
    {
        esDireccionRemitente = esRemitente;
        string ruc = esRemitente ? guia.RucRemitente : guia.NumeroDocumentoDestinatario;
        string razonSocial = esRemitente ? guia.RazonSocialRemitente : guia.RazonSocialDestinatario;

        if (string.IsNullOrEmpty(ruc)) return;

        nuevaDireccion = new DireccionRucDTO
        {
            Ruc = ruc,
            RazonSocial = razonSocial,
            Direccion = esRemitente ? guia.DireccionPartida : guia.DireccionLlegada,
            Ubigeo = esRemitente ? guia.UbigeoPartida : guia.UbigeoLlegada,
            EsDefault = false
        };
        mostrarModalDireccion = true;
    }

    private void CerrarModalDireccion()
    {
        mostrarModalDireccion = false;
    }

    private async Task GuardarDireccion()
    {
        if (string.IsNullOrWhiteSpace(nuevaDireccion.Direccion) || string.IsNullOrWhiteSpace(nuevaDireccion.Ubigeo))
        {
            await JS.InvokeVoidAsync("alert", "Ingrese dirección y ubigeo");
            return;
        }

        guardandoDireccion = true;
        try
        {
            var result = await DireccionService.CrearDireccion(nuevaDireccion);
            if (result != null)
            {
                if (esDireccionRemitente)
                {
                    await CargarDireccionesRemitente();
                    guia.DireccionPartida = result.Direccion;
                    guia.UbigeoPartida = result.Ubigeo;
                }
                else
                {
                    await CargarDireccionesDestinatario();
                    guia.DireccionLlegada = result.Direccion;
                    guia.UbigeoLlegada = result.Ubigeo;
                }
                CerrarModalDireccion();
            }
        }
        finally
        {
            guardandoDireccion = false;
        }
    }
    
    private async Task BuscarRucTransportista()
    {
        if (string.IsNullOrWhiteSpace(guia.RucTransportista) || guia.RucTransportista.Length != 11)
        {
            await JS.InvokeVoidAsync("alert", "Ingrese un RUC de transporte válido");
            return;
        }

        buscandoRucTransportista = true;
        try
        {
            var datos = await ReniecService.ObtenerNombrePorRUC(guia.RucTransportista);
            if (!string.IsNullOrEmpty(datos) && datos != "RUC NO ENCONTRADO" && !datos.StartsWith("ERROR"))
            {
                // El servicio devuelve "Razon Social (ESTADO)", limpiamos el estado
                var nombre = datos;
                int idxPar = datos.LastIndexOf('(');
                if (idxPar > 0)
                {
                    nombre = datos.Substring(0, idxPar).Trim();
                }
                guia.RazonSocialTransportista = nombre;
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "RUC no encontrado o error en consulta");
            }
        }
        finally
        {
            buscandoRucTransportista = false;
        }
    }
    #endregion
