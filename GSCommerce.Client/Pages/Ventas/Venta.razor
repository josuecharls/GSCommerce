@page "/ventas"
@using GSCommerce.Client.Models
@using GSCommerce.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "CAJERO,ADMINISTRADOR")]
@inject NavigationManager Nav
@inject VentaService ventaService
@inject AuthService AuthService
@inject AlmacenService AlmacenService
@inject UsuarioService UsuarioService
@inject IJSRuntime JS
@using System.Linq
@inject TipoPagoVentaService TipoPagoVentaService
@inject ArticuloService ArticuloService

<h3>Ventas Registradas</h3>
@if (cargo == "ADMINISTRADOR" || cargo == "CAJERO")
{
    <div class="row mb-3">
        <div class="col">
            <div class="d-flex flex-wrap gap-3">
                <div><strong>Efectivo S/:</strong> @efectivoSoles.ToString("N2")</div>
                <div><strong>Efectivo $:</strong> @efectivoDolares.ToString("N2")</div>
                <div><strong>Tarjeta/Online:</strong> @tarjetaOnline.ToString("N2")</div>
                <div><strong>N.C.:</strong> @notaCredito.ToString("N2")</div>
                <div><strong>Total:</strong> <span class="text-danger">@totalGeneral.ToString("N2")</span></div>
                <div><strong>Boletas/Tickets:</strong> @cantidadBoletas</div>
            </div>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-header bg-light py-2">
        <i class="bi bi-receipt"></i> Búsqueda Directa por Comprobante
    </div>
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-1">Serie:</label>
                <input type="text" class="form-control form-control-sm" @bind="serieBusqueda" 
                       placeholder="001" maxlength="4" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Número:</label>
                <input type="number" class="form-control form-control-sm" @bind="numeroBusqueda" 
                       placeholder="12345678" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-success btn-sm w-100" @onclick="BuscarPorSerieNumero">
                    <i class="bi bi-search"></i> Buscar Comprobante
                </button>
            </div>
            @if (!string.IsNullOrEmpty(mensajeBusquedaDirecta))
            {
                <div class="col-md-5">
                    <div class="alert alert-warning mb-0 py-1 small">@mensajeBusquedaDirecta</div>
                </div>
            }
        </div>
    </div>
</div>

<div class="row mb-3">
    @if (cargo == "ADMINISTRADOR")
    {
        <div class="col-md-3">
            <label>Almacén:</label>
            <select class="form-control" @bind="selectedAlmacen" @bind:after="OnAlmacenChanged">
                <option value="0">General</option>
                @foreach (var a in almacenes)
                {
                    <option value="@a.IdAlmacen">@a.Nombre</option>
                }
            </select>
        </div>
        @if (selectedAlmacen > 0)
        {
            <div class="col-md-3">
                <label>Cajero:</label>
                <select class="form-control" @bind="selectedCajero">
                    <option value="0">Todos</option>
                    @if (cajeros != null)
                    {
                        @foreach (var c in cajeros)
                        {
                            <option value="@c.IdUsuario">@c.Nombre</option>
                        }
                    }
                </select>
            </div>
        }
    }
    <div class="@(cargo == "ADMINISTRADOR" ? (selectedAlmacen > 0 ? "col-md-2" : "col-md-3") : "col-md-4")">
        <label>Desde:</label>
        <input type="date" class="form-control" @bind-value="desde" @bind-value:event="oninput" />
    </div>
    <div class="@(cargo == "ADMINISTRADOR" ? (selectedAlmacen > 0 ? "col-md-2" : "col-md-3") : "col-md-4")">
        <label>Hasta:</label>
        <input type="date" class="form-control" @bind-value="hasta" @bind-value:event="oninput" />
    </div>

    <div class="@(cargo == "ADMINISTRADOR" ? (selectedAlmacen > 0 ? "col-md-2" : "col-md-3") : "col-md-4")">
        <label>Tipo Doc:</label>
        <select class="form-control" @bind="selectedTipoDoc">
            <option value="0">Todos</option>
            <option value="1">BOLETA</option>
            <option value="2">FACTURA</option>
            <option value="4">TICKET</option>
            <option value="5">BOLETA M</option>
            <option value="6">FACTURA M</option>
        </select>
    </div>

    <div class="@(cargo == "ADMINISTRADOR" ? (selectedAlmacen > 0 ? "col-md-12 col-lg-1" : "col-md-12 col-lg-3") : "col-md-4") d-flex align-items-end">
        <button class="btn btn-primary w-100" @onclick="BuscarVentas"><i class="bi bi-search"></i> Buscar</button>
    </div>
    @if (cargo == "ADMINISTRADOR")
    {
        <div class="col-md-12 col-lg-2 d-flex align-items-end mt-2">
            @{
                var pendientes = ventas.Where(v => 
                    v.TipoDocumento != "TICKET" && 
                    v.TipoDocumento != "BOLETA M" &&
                    (v.EstadoSunat == "PENDIENTE" || v.EstadoSunat == "RECHAZADO")).ToList();
            }
            <button class="btn btn-warning w-100" 
                    @onclick="ReenviarMasivoSunat"
                    disabled="@(reenviandoMasivo || !pendientes.Any())">
                @if (reenviandoMasivo)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span> @progresoReenvio/@totalReenvio</span>
                }
                else
                {
                    <i class="bi bi-send"></i>
                    <span> Reenviar Pendientes (@pendientes.Count)</span>
                }
            </button>
        </div>
    }
</div>

@if (mostrarModalResultados)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Resultados de Reenvío Masivo a SUNAT</h5>
                    <button type="button" class="btn-close" @onclick="() => mostrarModalResultados = false"></button>
                </div>
                <div class="modal-body" style="max-height: 400px; overflow-y: auto;">
                    @{
                        var exitosos = resultadosReenvioMasivo.Count(r => r.Exito);
                        var fallidos = resultadosReenvioMasivo.Count(r => !r.Exito);
                    }
                    <div class="row mb-3">
                        <div class="col-6">
                            <div class="alert alert-success mb-0 py-2">
                                <strong>✅ Exitosos:</strong> @exitosos
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="alert alert-danger mb-0 py-2">
                                <strong>❌ Fallidos:</strong> @fallidos
                            </div>
                        </div>
                    </div>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Comprobante</th>
                                <th>Estado</th>
                                <th>Mensaje</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in resultadosReenvioMasivo)
                            {
                                <tr class="@(r.Exito ? "table-success" : "table-danger")">
                                    <td>@r.Comprobante</td>
                                    <td>@(r.Exito ? "✅ Aceptado" : "❌ Error")</td>
                                    <td>@r.Mensaje</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => mostrarModalResultados = false">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Tipo Doc</th>
            <th>Serie</th>
            <th>Número</th>
            <th>Cliente</th>
            <th>Total</th>
            <th>Forma Pago</th>
            <th>Estado</th>
            @if (cargo == "ADMINISTRADOR")
            {
                <th>SUNAT</th>
            }
            <th style="min-width:420px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (ventas.Any())
        {
            @foreach (var v in ventas)
            {
                <tr>
                    <td>@v.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@v.TipoDocumento</td>
                    <td>@v.Serie</td>
                    <td>@v.Numero.ToString("D8")</td>
                    <td>@v.NombreCliente</td>
                    <td>@v.Total.ToString("C", new System.Globalization.CultureInfo("es-PE"))</td>
                    <td>@v.FormaPago</td>
                    <td>
                        @if (v.Estado == "AN" || v.Estado == "ANULADO" || v.Estado == "A")
                        {
                            <span class="badge bg-danger">Anulado</span>
                        }
                        else if (v.Estado == "D")
                        {
                            <span class="badge bg-warning text-dark">Declarado</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Emitido</span>
                        }
                    </td>
                    @if (cargo == "ADMINISTRADOR")
                    {
                        <td>
                            @if (v.TipoDocumento == "TICKET")
                            {
                                @* No mostrar estado SUNAT *@
                            }
                            else if (v.EstadoSunat == "ACEPTADO")
                            {
                                <span class="badge bg-success" title="@v.DescripcionSunat">Aceptado</span>
                            }
                            else if (v.EstadoSunat == "RECHAZADO")
                            {
                                <span class="badge bg-danger" title="@v.DescripcionSunat">Rechazado</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark" title="@v.DescripcionSunat">Pendiente</span>
                            }
                        </td>
                    }
                    <td>
                        <div class="btn-group btn-group-sm flex-wrap" role="group">
                            <button class="btn btn-outline-info"
                                    title="Reimprimir boleta"
                                    @onclick="@(() => ReimprimirBoleta(v))">
                                <i class="bi bi-printer"></i> Imprimir
                            </button>
                            @if (cargo == "ADMINISTRADOR" && v.TipoDocumento == "TICKET")
                            {
                                <button class="btn btn-outline-danger" title="Anular Ticket" @onclick="@(() => AbrirAnulacion(v))">
                                    Anular
                                </button>
                            }
                        </div>
                        @if (cargo == "ADMINISTRADOR")
                        {
                            <div class="btn-group btn-group-sm flex-wrap" role="group">
                                <button class="btn btn-outline-primary"
                                        title="Emitir Nota de Crédito Electrónica"
                                        disabled="@(!PuedeEmitirNC(v))"
                                        @onclick="@(() => EmitirNotaCredito("ELECTRONICA", v))">
                                    NC Electrónica
                                </button>
                                <button class="btn btn-outline-secondary"
                                        title="Emitir Nota de Crédito Manual"
                                        disabled="@(!PuedeEmitirNC(v))"
                                        @onclick="@(() => EmitirNotaCredito("MANUAL", v))">
                                    NC Manual
                                </button>
                                <button class="btn btn-outline-dark"
                                        title="Emitir Nota de Crédito Interna"
                                        disabled="@(!PuedeEmitirNC(v))"
                                        @onclick="@(() => EmitirNotaCredito("INTERNA", v))">
                                    NC Interna
                                </button>
                                <button class="btn btn-outline-success"
                                        title="Ver Nota de Crédito"
                                        disabled="@string.IsNullOrWhiteSpace(v.NumeroNotaCredito)"
                                        @onclick="@(() => VerNCPdf(v))">
                                    Ver NC
                                </button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(v.NumeroNotaCredito))
                            {
                                <div class="text-muted small mt-1">NC: @v.NumeroNotaCredito</div>
                            }
                        }
                        @if (cargo != "CAJERO" && v.TipoDocumento != "TICKET" && v.EstadoSunat == "PENDIENTE" || v.EstadoSunat == "RECHAZADO" && (v.TipoDocumento == "BOLETA" || v.TipoDocumento == "BOLETA M" || v.TipoDocumento == "FACTURA"))
                        {
                            <div class="btn-group btn-group-sm flex-wrap mt-1" role="group">
                                <button class="btn btn-outline-warning" title="Reenviar a SUNAT" @onclick="@(() => ReenviarSunat(v))">
                                    Reenviar SUNAT
                                </button>
                            </div>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="@(cargo == "ADMINISTRADOR" ? 10 : 9)" class="text-center">No se encontraron ventas.</td>
            </tr>
        }
    </tbody>
</table>
@if (mostrarModalReenvio && ventaReenvio != null && ventaSeleccionada != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,.3)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @if (ventaSeleccionada.TipoDocumento == "BOLETA M" && modoEdicionActivo)
                        {
                            <span>✏️ Editar BOLETA M</span>
                        }
                        else
                        {
                            <span>Reenviar SUNAT</span>
                        }
                    </h5>
                    <button type="button" class="btn-close" @onclick="CancelarReenvio"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Cliente:</strong> @ventaReenvio.Nombre (@ventaReenvio.Dniruc)</p>
                    @if (infoCorrelativoReenvio != null)
                    {
                        @if (infoCorrelativoReenvio.Cambiara)
                        {
                            <div class="alert alert-warning">
                                <strong>⚠️ Correlativo cambiará:</strong><br/>
                                Actual: @ventaSeleccionada.Serie-@infoCorrelativoReenvio.NumeroActual.ToString("D8")<br/>
                                Nuevo: @ventaSeleccionada.Serie-@infoCorrelativoReenvio.Numero.ToString("D8")
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <strong>✓ Se mantendrá el mismo correlativo:</strong><br/>
                                @ventaSeleccionada.Serie-@infoCorrelativoReenvio.Numero.ToString("D8")<br/>
                                <small class="text-muted">(El documento nunca llegó a SUNAT)</small>
                            </div>
                        }
                    }
                    
                    @* Botón para activar modo edición solo para BOLETA M *@
                    @if (ventaSeleccionada.TipoDocumento == "BOLETA M" && !modoEdicionActivo)
                    {
                        <div class="mb-3">
                            <button class="btn btn-warning btn-sm" @onclick="ActivarModoEdicion">
                                <i class="bi bi-pencil"></i> Editar Artículos
                            </button>
                        </div>
                    }
                    
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th style="width: 100px;">Cantidad</th>
                                <th style="width: 100px;">P. Unit.</th>
                                <th style="width: 100px;">Total</th>
                                @if (modoEdicionActivo)
                                {
                                    <th style="width: 60px;"></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var det in ventaReenvio.Detalles)
                            {
                                <tr>
                                    <td>@det.DescripcionItem</td>
                                    <td>
                                        @if (modoEdicionActivo)
                                        {
                                            <input type="number" class="form-control form-control-sm" 
                                                   min="1" 
                                                   value="@det.Cantidad"
                                                   @onchange="@(e => CambiarCantidadDetalle(det, e))" />
                                        }
                                        else
                                        {
                                            @det.Cantidad
                                        }
                                    </td>
                                    <td>@det.PrecioUnitario.ToString("N2")</td>
                                    <td>@det.Total.ToString("N2")</td>
                                    @if (modoEdicionActivo)
                                    {
                                        <td>
                                            <button class="btn btn-outline-danger btn-sm" 
                                                    title="Eliminar"
                                                    disabled="@(ventaReenvio.Detalles.Count <= 1)"
                                                    @onclick="@(() => EliminarDetalle(det))">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                    
                    @if (modoEdicionActivo)
                    {
                        <div class="mb-3">
                            <div class="row g-2 align-items-end">
                                <div class="col-auto">
                                    <label class="form-label small mb-1">Código:</label>
                                    <input type="text" class="form-control form-control-sm" 
                                           style="width: 120px;"
                                           @bind="codigoArticuloAgregar" 
                                           placeholder="Código" />
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-success btn-sm" 
                                            @onclick="AgregarArticuloPorCodigo"
                                            disabled="@agregandoArticulo">
                                        @if (agregandoArticulo)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-plus-circle"></i>
                                        }
                                        Agregar
                                    </button>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(mensajeErrorAgregar))
                            {
                                <div class="alert alert-warning py-1 mt-2 small">@mensajeErrorAgregar</div>
                            }
                        </div>
                    }
                    
                    <div class="mt-3">
                        <p><strong>Subtotal:</strong> @ventaReenvio.SubTotal.ToString("C", new System.Globalization.CultureInfo("es-PE"))</p>
                        <p>
                            <strong>IGV:</strong> @ventaReenvio.Igv.ToString("C", new System.Globalization.CultureInfo("es-PE"))
                            @if (ventaReenvio.IdAlmacen == 1024)
                            {
                                <span class="text-muted">(Exonerado - Amazonas)</span>
                            }
                        </p>
                        <p><strong>Total:</strong> @ventaReenvio.Total.ToString("C", new System.Globalization.CultureInfo("es-PE"))</p>
                    </div>
                    
                    @if (modoEdicionActivo && cambiosPendientes)
                    {
                        <div class="alert alert-warning mt-2">
                            <i class="bi bi-exclamation-triangle"></i> Tiene cambios sin guardar. Guarde antes de emitir.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    @if (modoEdicionActivo)
                    {
                        <button class="btn btn-success" @onclick="GuardarCambiosDetalles" disabled="@guardandoCambios">
                            @if (guardandoCambios)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                            }
                            else
                            {
                                <i class="bi bi-check"></i>
                            }
                            Guardar Cambios
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="CancelarEdicion">Cancelar Edición</button>
                    }
                    <button class="btn btn-info" @onclick="ImprimirBoletaReenvio">Imprimir</button>
                    <button class="btn btn-primary" @onclick="ConfirmarReenvio" disabled="@(modoEdicionActivo && cambiosPendientes)">Emitir</button>
                    <button class="btn btn-secondary" @onclick="CancelarReenvio">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
    
}

@if (mostrarModalAnulacion && ventaAnulacion != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,.3)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Anular Ticket</h5>
                    <button type="button" class="btn-close" @onclick="CerrarAnulacion"></button>
                </div>
                <div class="modal-body">
                    <p>¿Estás seguro de anular este ticket? Se devolverá el stock y el dinero.</p>
                    <p><strong>Total:</strong> @ventaAnulacion.Total.ToString("C", new System.Globalization.CultureInfo("es-PE"))</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger" @onclick="ConfirmarAnulacion">Anular</button>
                    <button class="btn btn-secondary" @onclick="CerrarAnulacion">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<VentaConsultaDTO> ventas = new();
    private DateTime desde = DateTime.Today;
    private DateTime hasta = DateTime.Today;
    private string cargo = string.Empty;
    private List<AlmacenDTO> almacenes = new();
    private int selectedAlmacen;
    private int selectedTipoDoc = 0; // 0 = todos
    private int selectedCajero = 0; // 0 = todos
    private List<UsuarioDTO> cajeros = new();
    private int? idUsuarioActual;
    private decimal efectivoSoles;
    private decimal efectivoDolares;
    private decimal tarjetaOnline;
    private decimal notaCredito;
    private decimal totalGeneral;
    private int cantidadBoletas;

    private VentaDTO? ventaReenvio;
    private VentaConsultaDTO? ventaSeleccionada;
    private bool mostrarModalReenvio;
    private CorrelativoReenvioDTO? infoCorrelativoReenvio;
    private bool mostrarModalAnulacion;
    private VentaDTO? ventaAnulacion;
    private List<DetallePagoDTO> pagosAnulacion = new();
    private List<TipoPagoVentaDTO> tiposPago = new();
    private int idVentaAnulacion;

    // Variables para búsqueda directa por Serie/Número
    private string serieBusqueda = string.Empty;
    private int? numeroBusqueda;

    // Variables para reenvío masivo a SUNAT
    private bool reenviandoMasivo;
    private int progresoReenvio;
    private int totalReenvio;
    private List<(string Comprobante, bool Exito, string Mensaje)> resultadosReenvioMasivo = new();
    private bool mostrarModalResultados;
    private string mensajeBusquedaDirecta = string.Empty;

    // Variables para edición de BOLETA M
    private bool modoEdicionActivo;
    private bool cambiosPendientes;
    private bool guardandoCambios;
    private List<VentaDetalleDTO>? detallesBackup;
    private string codigoArticuloAgregar = string.Empty;
    private string mensajeErrorAgregar = string.Empty;
    private bool agregandoArticulo;

    protected override async Task OnInitializedAsync()
    {
        cargo = await AuthService.GetUserCargo() ?? string.Empty;
        if (cargo == "ADMINISTRADOR")
        {
            var lista = await AlmacenService.GetAlmacenes();
            if (lista != null) almacenes = lista;
            selectedAlmacen = 0;
        }
        else
        {
            selectedAlmacen = await AuthService.GetUserAlmacenId() ?? 0;
            idUsuarioActual = await AuthService.GetUserId();
        }

        await BuscarVentas();
    }

    private async Task OnAlmacenChanged()
    {
        selectedCajero = 0; // resetear cajero
        if (selectedAlmacen > 0)
        {
            cajeros = await UsuarioService.ObjetenerCajerosConUserAsync(selectedAlmacen);
        }
        else
        {
            cajeros = new();
        }
        StateHasChanged();
    }

    private async Task BuscarVentas()
    {
        int? filtroAlmacen = cargo == "ADMINISTRADOR" && selectedAlmacen == 0 ? (int?)null : selectedAlmacen;
        int? filtroTipoDoc = selectedTipoDoc == 0 ? (int?)null : selectedTipoDoc;
        int? filtroCajero = null;

        if (cargo == "ADMINISTRADOR")
        {
            // Si se seleccionó un cajero específico, usar ese
            if (selectedCajero > 0)
            {
                filtroCajero = selectedCajero;
            }
        }
        else if (cargo == "CAJERO")
        {
            // Para CAJERO, filtrar automáticamente por su IdUsuario
            filtroCajero = idUsuarioActual;
        }

        ventas = await ventaService.ObtenerVentasAsync(desde, hasta, filtroAlmacen, filtroTipoDoc, filtroCajero);
        CalcularResumen();
        mensajeBusquedaDirecta = string.Empty; // Limpiar mensaje de búsqueda directa
    }

    private async Task BuscarPorSerieNumero()
    {
        mensajeBusquedaDirecta = string.Empty;
        
        if (string.IsNullOrWhiteSpace(serieBusqueda) || !numeroBusqueda.HasValue)
        {
            mensajeBusquedaDirecta = "Ingrese Serie y Número";
            return;
        }
        
        var resultado = await ventaService.BuscarPorSerieNumeroAsync(serieBusqueda.Trim(), numeroBusqueda.Value);
        
        if (resultado != null && resultado.Any())
        {
            ventas = resultado;
            CalcularResumen();
        }
        else
        {
            ventas = new();
            mensajeBusquedaDirecta = $"No se encontró comprobante {serieBusqueda}-{numeroBusqueda:D8}";
        }
    }

    private void CalcularResumen()
    {
        var inicio = desde.Date;
        var fin = hasta.Date;
        var activas = ventas.Where(v =>
            !(v.Fecha.Date >= inicio && v.Fecha.Date <= fin &&
              (string.Equals(v.Estado, "A", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(v.Estado, "AN", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(v.Estado, "ANULADO", StringComparison.OrdinalIgnoreCase)) &&
              string.IsNullOrWhiteSpace(v.GeneroNC))
        ).ToList();
        var pagosActivos = activas.SelectMany(v => v.Pagos);

        efectivoSoles = 0;
        efectivoDolares = 0;
        tarjetaOnline = 0;
        notaCredito = 0;

        foreach (var p in pagosActivos)
        {
            var etiqueta = !string.IsNullOrWhiteSpace(p.FormaPago) ? p.FormaPago : p.Tipo;
            var token = (etiqueta ?? string.Empty)
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .FirstOrDefault() ?? string.Empty;

            var soles = p.Soles;
            var dolares = p.Dolares;
            var vuelto = p.Vuelto ?? 0m;

            if (token.Equals("Efectivo", StringComparison.OrdinalIgnoreCase))
            {
                if (soles > 0)
                    efectivoSoles += soles - vuelto;
                else
                    efectivoDolares += dolares - vuelto;
            }
            else if (token.Equals("Tarjeta", StringComparison.OrdinalIgnoreCase) ||
                     token.Equals("Online", StringComparison.OrdinalIgnoreCase))
            {
                tarjetaOnline += soles > 0 ? soles : dolares;
            }
            else if (token.Equals("N.C.", StringComparison.OrdinalIgnoreCase))
            {
                notaCredito += soles > 0 ? soles : dolares;
            }
        }

        totalGeneral = efectivoSoles + tarjetaOnline;

        cantidadBoletas = activas.Count(v => v.TipoDocumento.Contains("BOLETA", StringComparison.OrdinalIgnoreCase)
                                            || v.TipoDocumento.Contains("TICKET", StringComparison.OrdinalIgnoreCase));
    }

    private bool PuedeEmitirNC(VentaConsultaDTO v)
    {
        // Para TICKETS no aplica validación SUNAT
        if (v.IdTipoDocumento == 4)
            return (v.Estado == "E" || v.Estado == "D") && string.IsNullOrWhiteSpace(v.NumeroNotaCredito);
        
        // Para BOLETA, FACTURA, etc: debe estar ACEPTADO en SUNAT
        return (v.Estado == "E" || v.Estado == "D") 
            && string.IsNullOrWhiteSpace(v.NumeroNotaCredito) 
            && v.EstadoSunat == "ACEPTADO";
    }

    private async Task EmitirNotaCredito(string tipo, VentaConsultaDTO v)
    {
        if (!PuedeEmitirNC(v))
        {
            if (v.IdTipoDocumento != 4 && v.EstadoSunat != "ACEPTADO")
            {
                var tipoDoc = v.TipoDocumento?.ToUpper() ?? "COMPROBANTE";
                await JS.InvokeVoidAsync("alert", $"⚠️ {tipoDoc} no emitida, no puede hacer Nota De Crédito.");
                return;
            }
            await JS.InvokeVoidAsync("alert", "⚠️ Solo se puede emitir N.C. para ventas EMITIDAS o DECLARADAS y sin N.C. previa.");
            return;
        }

        var url = tipo.ToUpper() switch
        {
            "ELECTRONICA" => $"/nota-credito/electronica/{v.IdComprobante}",
            "MANUAL" => $"/nota-credito/manual/{v.IdComprobante}",
            "INTERNA" => $"/nota-credito/interna/{v.IdComprobante}",
            _ => null
        };

        if (!string.IsNullOrEmpty(url))
            Nav.NavigateTo(url);
    }

    private async Task VerNCPdf(VentaConsultaDTO v)
    {
        if (string.IsNullOrWhiteSpace(v.NumeroNotaCredito))
