    private void ActivarModoEdicion()
    {
        if (ventaReenvio == null) return;
        
        // Crear backup de los detalles originales
        detallesBackup = ventaReenvio.Detalles.Select(d => new VentaDetalleDTO
        {
            Item = d.Item,
            CodigoItem = d.CodigoItem,
            DescripcionItem = d.DescripcionItem,
            UnidadMedida = d.UnidadMedida,
            Cantidad = d.Cantidad,
            PrecioUnitario = d.PrecioUnitario,
            PorcentajeDescuento = d.PorcentajeDescuento,
            Total = d.Total
        }).ToList();
        
        modoEdicionActivo = true;
        cambiosPendientes = false;
    }

    private void CambiarCantidadDetalle(VentaDetalleDTO det, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nuevaCantidad) && nuevaCantidad > 0)
        {
            det.Cantidad = nuevaCantidad;
            det.Total = Math.Round(det.Cantidad * det.PrecioUnitario, 2);
            RecalcularTotalesVenta();
            cambiosPendientes = true;
        }
    }

    private void EliminarDetalle(VentaDetalleDTO det)
    {
        if (ventaReenvio == null || ventaReenvio.Detalles.Count <= 1) return;
        
        ventaReenvio.Detalles.Remove(det);
        
        // Renumerar items
        int item = 1;
        foreach (var d in ventaReenvio.Detalles)
        {
            d.Item = item++;
        }
        
        RecalcularTotalesVenta();
        cambiosPendientes = true;
    }

    private void RecalcularTotalesVenta()
    {
        if (ventaReenvio == null) return;
        
        decimal totalVenta = ventaReenvio.Detalles.Sum(d => d.Total);
        
        // IGV es 18% del total (precio ya incluye IGV), excepto almacén 1024
        if (ventaReenvio.IdAlmacen == 1024)
        {
            ventaReenvio.Igv = 0m;
            ventaReenvio.SubTotal = totalVenta;
        }
        else
        {
            ventaReenvio.Igv = Math.Round(totalVenta - (totalVenta / 1.18m), 2);
            ventaReenvio.SubTotal = totalVenta - ventaReenvio.Igv;
        }
        
        ventaReenvio.Total = totalVenta;
    }

    private async Task GuardarCambiosDetalles()
    {
        if (ventaReenvio == null || ventaSeleccionada == null) return;
        
        guardandoCambios = true;
        StateHasChanged();
        
        try
        {
            var resultado = await ventaService.ActualizarDetallesVentaAsync(
                ventaSeleccionada.IdComprobante, 
                ventaReenvio.Detalles);
            
            if (resultado != null)
            {
                // Actualizar con los datos del servidor
                ventaReenvio.SubTotal = resultado.SubTotal;
                ventaReenvio.Igv = resultado.Igv;
                ventaReenvio.Total = resultado.Total;
                ventaReenvio.Detalles = resultado.Detalles;
                
                cambiosPendientes = false;
                await JS.InvokeVoidAsync("alert", "✅ Cambios guardados correctamente.");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "❌ Error al guardar los cambios.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"❌ Error: {ex.Message}");
        }
        finally
        {
            guardandoCambios = false;
            StateHasChanged();
        }
    }

    private void CancelarEdicion()
    {
        if (ventaReenvio != null && detallesBackup != null)
        {
            // Restaurar detalles originales
            ventaReenvio.Detalles = detallesBackup;
            RecalcularTotalesVenta();
        }
        
        modoEdicionActivo = false;
        cambiosPendientes = false;
        detallesBackup = null;
    }

    private async Task AgregarArticuloPorCodigo()
    {
        if (ventaReenvio == null) return;
        
        mensajeErrorAgregar = string.Empty;
        
        if (string.IsNullOrWhiteSpace(codigoArticuloAgregar))
        {
            mensajeErrorAgregar = "Ingrese un código de artículo";
            return;
        }
        
        agregandoArticulo = true;
        StateHasChanged();
        
        try
        {
            // Buscar artículo por código
            var articulo = await ArticuloService.BuscarPorCodigoAsync(codigoArticuloAgregar.Trim());
            
            if (articulo == null)
            {
                mensajeErrorAgregar = $"No se encontró artículo con código: {codigoArticuloAgregar}";
                return;
            }
            
            // Verificar si el artículo ya existe en los detalles
            var existente = ventaReenvio.Detalles.FirstOrDefault(d => d.CodigoItem == articulo.IdArticulo);
            if (existente != null)
            {
                // Si ya existe, incrementar cantidad
                existente.Cantidad += 1;
                existente.Total = Math.Round(existente.Cantidad * existente.PrecioUnitario, 2);
            }
            else
            {
                // Agregar nuevo detalle
                var nuevoDetalle = new VentaDetalleDTO
                {
                    Item = ventaReenvio.Detalles.Count + 1,
                    CodigoItem = articulo.IdArticulo,
                    DescripcionItem = articulo.Descripcion ?? string.Empty,
                    UnidadMedida = "NIU",
                    Cantidad = 1,
                    PrecioUnitario = articulo.PrecioVenta,
                    PorcentajeDescuento = 0,
                    Total = articulo.PrecioVenta
                };
                ventaReenvio.Detalles.Add(nuevoDetalle);
            }
            
            RecalcularTotalesVenta();
            cambiosPendientes = true;
            codigoArticuloAgregar = string.Empty; // Limpiar input
        }
        catch (Exception ex)
        {
            mensajeErrorAgregar = $"Error: {ex.Message}";
        }
        finally
        {
            agregandoArticulo = false;
            StateHasChanged();
        }
    }

    private async Task ReenviarMasivoSunat()
    {
        // Filtrar solo boletas/facturas pendientes o rechazadas (excluir TICKET y BOLETA M)
        var pendientes = ventas.Where(v => 
            v.TipoDocumento != "TICKET" && 
            v.TipoDocumento != "BOLETA M" &&
            (v.EstadoSunat == "PENDIENTE" || v.EstadoSunat == "RECHAZADO")).ToList();

        if (!pendientes.Any())
        {
            await JS.InvokeVoidAsync("alert", "No hay comprobantes pendientes para reenviar.");
            return;
        }

        // Confirmar con el usuario
        var confirmar = await JS.InvokeAsync<bool>("confirm", 
            $"¿Desea reenviar {pendientes.Count} comprobante(s) pendiente(s) a SUNAT?\n\nEste proceso puede tomar varios minutos.");
        
        if (!confirmar) return;

        // Iniciar proceso
        reenviandoMasivo = true;
        progresoReenvio = 0;
        totalReenvio = pendientes.Count;
        resultadosReenvioMasivo = new();
        StateHasChanged();

        foreach (var venta in pendientes)
        {
            progresoReenvio++;
            StateHasChanged();

            var nombreComprobante = $"{venta.Serie}-{venta.Numero:D8}";
            
            try
            {
                var (ok, msg) = await ventaService.ReenviarSunatAsync(venta.IdComprobante);
                resultadosReenvioMasivo.Add((nombreComprobante, ok, msg ?? (ok ? "Aceptado" : "Error desconocido")));
            }
            catch (Exception ex)
            {
                resultadosReenvioMasivo.Add((nombreComprobante, false, $"Error: {ex.Message}"));
            }

            // Pequeña pausa entre envíos para no saturar
            await Task.Delay(500);
        }

        // Finalizar y mostrar resultados
        reenviandoMasivo = false;
        mostrarModalResultados = true;
        StateHasChanged();

        // Actualizar la lista de ventas
        await BuscarVentas();
    }


