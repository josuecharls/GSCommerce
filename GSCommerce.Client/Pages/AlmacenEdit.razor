@page "/almacen/edit/{id:int}"
@using GSCommerce.Client.Models
@using GSCommerce.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "ADMINISTRADOR")]
@inject AlmacenService AlmacenService
@inject NavigationManager Navigation

<h3>🏢 Editar Almacén</h3>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @mensajeClase">@mensaje</div>
}

@if (!isLoading)
{
    <div class="card p-4">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input type="text" class="form-control" @bind="almacen.Nombre" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Dirección</label>
                    <input type="text" class="form-control" @bind="almacen.Direccion" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Departamento, Provincia, Distrito</label>
                    <input type="text" class="form-control" @bind="almacen.Dpd" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Teléfono</label>
                    <input type="text" class="form-control" @bind="almacen.Telefono" pattern="\d{9}" maxlength="9" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Celular</label>
                    <input type="text" class="form-control" @bind="almacen.Celular" pattern="\d{9}" maxlength="9" />
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Razón Social</label>
                    <input type="text" class="form-control" @bind="almacen.RazonSocial" />
                </div>
                <div class="mb-3">
                    <label class="form-label">RUC</label>
                    <input type="text" class="form-control" @bind="almacen.Ruc" pattern="\d{11}" maxlength="11" />
                </div>
                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" id="esTienda" @bind="almacen.EsTienda" />
                    <label class="form-check-label" for="esTienda">¿Es Tienda?</label>
                </div>
            </div>
        </div>

        <div class="text-center mt-3">
            <button class="btn btn-primary" @onclick="UpdateAlmacen" disabled="@isSaving">
                <i class="bi bi-floppy2"></i> Guardar Cambios
            </button>
            <button class="btn btn-secondary" @onclick="Cancel"><i class="bi bi-x-lg"></i> Cancelar</button>
        </div>
    </div>
}
else
{
    <p>Cargando...</p>
}

@code {
    [Parameter] public int Id { get; set; }
    private AlmacenDTO almacen = new();
    private bool isLoading = true;
    private bool isSaving;
    private string? mensaje;
    private string mensajeClase = "alert-danger";

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        almacen = await AlmacenService.GetAlmacenById(Id) ?? new AlmacenDTO();
        if (almacen.IdAlmacen == 0)
        {
            mensaje = "No se encontró el almacén solicitado.";
            mensajeClase = "alert-warning";
        }
        isLoading = false;
    }

    private async Task UpdateAlmacen()
    {
        if (string.IsNullOrWhiteSpace(almacen.Nombre) || string.IsNullOrWhiteSpace(almacen.Direccion))
        {
            mensaje = "Nombre y dirección son obligatorios.";
            mensajeClase = "alert-warning";
            return;
        }

        isSaving = true;
        mensaje = null;
        try
        {
            if (await AlmacenService.UpdateAlmacen(Id, almacen))
            {
                Navigation.NavigateTo("/almacen");
                return;
            }

            mensaje = "No se pudieron guardar los cambios. Verifique los datos e intente nuevamente.";
            mensajeClase = "alert-danger";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/almacen");
    }
}
