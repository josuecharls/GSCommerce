@page "/ingreso-egreso-form"
@using GSCommerce.Client.Models
@using GSCommerce.Client.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq
@inject IngresosEgresosService IngresosEgresosService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AlmacenService AlmacenService
@inject UsuarioService UsuarioService
@inject CajaService CajaService
@inject IJSRuntime JS


<h3>Registrar @tituloNaturaleza</h3>

<EditForm Model="registro" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    @if (esIngreso)
    {
        <div class="mb-3">
            <label>Tipo</label>
            <InputText @bind-Value="registro.Tipo" class="form-control" readonly />
        </div>
    }
    else
    {
        <div class="mb-3">
            <label>Tipo</label>
            <InputSelect @bind-Value="registro.Tipo" class="form-select" @bind-Value:after="OnTipoChangeAfter">
                @foreach (var t in tiposEgreso)
                {
                    <option value="@t">@t</option>
                }
            </InputSelect>
        </div>

        @if (registro.Tipo == "PAGO PROVEEDORES")
        {
            <div class="mb-3">
                <label>Proveedor</label>
                <div class="input-group">
                    <input class="form-control" readonly value="@proveedorNombre" />
                    <button class="btn btn-secondary" type="button" @onclick="() => mostrarProveedorModal = true"><i class="bi bi-search"></i> Buscar</button>
                </div>
            </div>
        }

        @if (registro.Tipo == "TRANSFERENCIA")
        {
            @if (esAdministrador)
            {
                <div class="mb-3">
                    <label>Almacén</label>
                    <select class="form-select" @bind="idAlmacenSeleccionado" @bind:after="OnAlmacenSeleccionadoChange">
                        <option value="0">-- Seleccione --</option>
                        @foreach (var a in almacenes)
                        {
                            <option value="@a.IdAlmacen">@a.Nombre</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label>Cajero Origen</label>
                    <select class="form-select" @bind="idCajeroOrigen" @bind:after="OnCajeroOrigenChange">
                        <option value="0">-- Seleccione --</option>
                        @foreach (var c in cajerosOrigen)
                        {
                            <option value="@c.IdUsuario">@c.Nombre</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label>Cajero Destino</label>
                    <InputSelect class="form-select" @bind-Value="registro.IdCajeroDestino">
                        <option value="">-- Seleccione --</option>
                        @foreach (var c in cajerosDestino)
                        {
                            <option value="@c.IdUsuario">@c.Nombre</option>
                        }
                    </InputSelect>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label>Cajero Destino</label>
                    <InputSelect class="form-select" @bind-Value="registro.IdCajeroDestino">
                        <option value="">-- Seleccione --</option>
                        @foreach (var c in cajerosDestino)
                        {
                            <option value="@c.IdUsuario">@c.Nombre</option>
                        }
                    </InputSelect>
                </div>
            }
        }
    }

    <div class="mb-3">
        <label>Glosa</label>
        <InputTextArea @bind-Value="registro.Glosa" class="form-control" rows="3" />
    </div>

    <div class="mb-3">
        <label>Fecha</label>
        <InputDate @bind-Value="registro.Fecha" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Forma</label>
        <InputSelect @bind-Value="detalle.Forma" class="form-select">
            <option value="EFECTIVO">EFECTIVO</option>
            <option value="DEPOSITO">DEPOSITO</option>
        </InputSelect>
    </div>

    @if (detalle.Forma == "DEPOSITO")
    {
        <div class="mb-3">
            <label>Banco</label>
            <InputText @bind-Value="detalle.Banco" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Cuenta</label>
            <InputText @bind-Value="detalle.Cuenta" class="form-control" />
        </div>
    }

    <div class="mb-3">
        <label>Detalle</label>
        <InputTextArea @bind-Value="detalle.Detalle" class="form-control" rows="3" />
    </div>

    <div class="mb-3">
        <label>Monto</label>
        <InputNumber @bind-Value="MontoDetalle" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Monto Total</label>
        <InputNumber @bind-Value="registro.Monto" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label>Comprobante</label>
        <InputFile OnChange="OnFileChange" />
    </div>

    <button class="btn btn-primary" type="submit" disabled="@guardando">Guardar</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Volver">Cancelar</button>
</EditForm>

<ProveedorBuscarModal Mostrar="mostrarProveedorModal" MostrarChanged="(v) => mostrarProveedorModal = v" OnSeleccionado="SeleccionarProveedor" />

@code {
    private IngresoEgresoRegistroDTO registro = new();
    private IngresoEgresoDetalleDTO detalle = new();

    [Parameter]
    [SupplyParameterFromQuery]
    public string? naturaleza { get; set; }

    private int idUsuario;
    private int idAlmacen;
    private string tituloNaturaleza = "Egreso";
    private bool esIngreso;
    private bool mostrarProveedorModal;
    private string proveedorNombre = string.Empty;
    private bool guardando;
    private string? cargo;
    private bool esAdministrador;
    private int idAlmacenSeleccionado;
    private int idCajeroOrigen;

    private List<string> tiposEgreso = new()
  {
    "GASTOS DIVERSOS",
    "TRANSFERENCIA",
    "PAGO PROVEEDORES",
    "PAGO LUZ",
    "PAGO AGUA",
    "PAGO TELEFONO",
    "PAGO CELULAR",
    "PAGO ALQUILER",
    "PAGO PLANILLAS",
    "PAGO ADELANTOS",
    "SUNAT",
    "FLETE",
    "AFP",
    "AFP-REPORTE",
    "SUNAT-REPORTE",
    "ALQUILER-REPORTE"
  };

    private List<AlmacenDTO> almacenes = new();
    private List<UsuarioDTO> cajerosDestino = new();
    private List<UsuarioDTO> cajerosOrigen = new();

    private decimal MontoDetalle
    {
        get => detalle.Monto;
        set
        {
            detalle.Monto = value;
            registro.Monto = value;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        idUsuario = await AuthService.GetUserId() ?? 0;
        idAlmacen = await AuthService.GetUserAlmacenId() ?? 0;
        cargo = await AuthService.GetUserCargo();
        esAdministrador = cargo == "ADMINISTRADOR";
        tituloNaturaleza = naturaleza ?? "Egreso";
        esIngreso = tituloNaturaleza.StartsWith("I", StringComparison.OrdinalIgnoreCase);
        registro.Naturaleza = esIngreso ? "I" : "E";
        registro.Fecha = DateTime.Now;
        registro.Tipo = esIngreso ? "SOBRANTE DE CAJA" : tiposEgreso.First();
        if (!esIngreso)
        {
            almacenes = await AlmacenService.GetAlmacenes() ?? new();
            if (registro.Tipo == "TRANSFERENCIA")
            {
                await CargarCajerosParaTransferencia();
            }
        }
    }

    private async Task ManejarCambioTipoAsync()
    {
        registro.IdProveedor = null;
        registro.IdAlmacenDestino = null;
        registro.IdCajeroDestino = null;
        idCajeroOrigen = 0;
        idAlmacenSeleccionado = 0;
        proveedorNombre = string.Empty;
        cajerosDestino.Clear();
        cajerosOrigen.Clear();

        if (registro.Tipo == "TRANSFERENCIA")
        {
            await CargarCajerosParaTransferencia();
            StateHasChanged();
        }
    }

    private async Task OnTipoChangeAfter()
    {
        try
        {
            // Como ves, no necesitas el parámetro, usas registro.Tipo directamente
            // si lo necesitaras dentro de ManejarCambioTipoAsync
            await ManejarCambioTipoAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error procesando cambio de tipo: {ex.Message}");
        }
    }

    private async Task CargarCajerosParaTransferencia()
    {
        if (esAdministrador)
        {
            // Para administrador, los cajeros se cargan cuando selecciona el almacén
            cajerosDestino.Clear();
            cajerosOrigen.Clear();
        }
        else
        {
            // Para cajero, cargar solo los cajeros del mismo almacén excluyendo al logueado
            var todosCajeros = await UsuarioService.ObtenerCajerosAsync(idAlmacen);
            cajerosDestino = todosCajeros.Where(c => c.IdUsuario > 0 && c.IdUsuario != idUsuario).ToList();
            registro.IdAlmacenDestino = idAlmacen; // El almacén destino es el mismo del cajero logueado
            StateHasChanged();
        }
    }

    private async Task OnAlmacenSeleccionadoChange()
    {
        registro.IdAlmacenDestino = idAlmacenSeleccionado;

        if (idAlmacenSeleccionado > 0)
        {
            var todosCajeros = await UsuarioService.ObtenerCajerosAsync(idAlmacenSeleccionado);
            cajerosOrigen = todosCajeros.Where(c => c.IdUsuario > 0).ToList();
            cajerosDestino = todosCajeros.Where(c => c.IdUsuario > 0).ToList();
        }
        else
        {
            cajerosOrigen.Clear();
            cajerosDestino.Clear();
        }

        idCajeroOrigen = 0;
        registro.IdCajeroDestino = null;
        StateHasChanged();
    }

    private void OnCajeroOrigenChange()
    {
        // Filtrar cajeros destino para excluir al cajero origen seleccionado
        if (idAlmacenSeleccionado > 0 && idCajeroOrigen > 0)
        {
            var todosCajeros = cajerosOrigen.Where(c => c.IdUsuario != idCajeroOrigen && c.IdUsuario > 0).ToList();
            cajerosDestino = todosCajeros;
        }
        registro.IdCajeroDestino = null;
        StateHasChanged();
    }

    private void SeleccionarProveedor(ProveedorDTO prov)
    {
        registro.IdProveedor = prov.IdProveedor;
        proveedorNombre = prov.Nombre;
    }

    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > 5_000_000)
        {
            await JS.InvokeVoidAsync("alert", "El archivo es demasiado grande. Tamaño máximo: 5MB.");
            return;
        }
        
        // Validar tipo MIME
        var allowedTypes = new[] { "image/jpeg", "image/png", "image/gif", "image/webp" };
        if (!allowedTypes.Contains(file.ContentType))
        {
            await JS.InvokeVoidAsync("alert", "Tipo de archivo no permitido. Solo se permiten imágenes (JPEG, PNG, GIF, WEBP).");
            return;
        }
        
        using var stream = file.OpenReadStream(5_000_000);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        
        // Validar que realmente sea una imagen (magic bytes)
        var bytes = ms.ToArray();
        if (!IsValidImage(bytes))
        {
            await JS.InvokeVoidAsync("alert", "El archivo no es una imagen válida.");
            return;
        }
        
        detalle.ImagenBase64 = Convert.ToBase64String(bytes);
    }

    private bool IsValidImage(byte[] bytes)
    {
        if (bytes.Length < 4) return false;
        
        // JPEG: FF D8 FF
        if (bytes[0] == 0xFF && bytes[1] == 0xD8 && bytes[2] == 0xFF) return true;
        // PNG: 89 50 4E 47
        if (bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47) return true;
        // GIF: 47 49 46 38 (GIF8)
        if (bytes[0] == 0x47 && bytes[1] == 0x49 && bytes[2] == 0x46 && bytes[3] == 0x38) return true;
        // WEBP: RIFF...WEBP (más complejo, pero verificamos los primeros bytes)
        if (bytes.Length >= 12 && 
            bytes[0] == 0x52 && bytes[1] == 0x49 && bytes[2] == 0x46 && bytes[3] == 0x46 &&
            bytes[8] == 0x57 && bytes[9] == 0x45 && bytes[10] == 0x42 && bytes[11] == 0x50) return true;
        
        return false;
    }

    private async Task Guardar()
    {
        if (guardando) return;

        if (registro.Tipo == "PAGO PROVEEDORES" && !registro.IdProveedor.HasValue)
        {
            await JS.InvokeVoidAsync("alert", "Debe seleccionar un proveedor antes de guardar.");
            return;
        }

        if (registro.Tipo == "TRANSFERENCIA" && !registro.IdCajeroDestino.HasValue)
        {
            await JS.InvokeVoidAsync("alert", "Debe seleccionar un cajero destino antes de guardar.");
            return;
        }

        if (registro.Tipo == "TRANSFERENCIA" && esAdministrador)
        {
            if (idAlmacenSeleccionado == 0)
            {
                await JS.InvokeVoidAsync("alert", "Debe seleccionar un almacén antes de guardar.");
                return;
            }
            if (idCajeroOrigen == 0)
            {
                await JS.InvokeVoidAsync("alert", "Debe seleccionar un cajero origen antes de guardar.");
                return;
            }
        }

        // Validar apertura de caja para transferencias
        if (registro.Tipo == "TRANSFERENCIA")
        {
            int idCajeroOrigenValidar;
            int idAlmacenOrigenValidar;
            int idCajeroDestinoValidar;
            int idAlmacenDestinoValidar;

            if (esAdministrador)
            {
                idCajeroOrigenValidar = idCajeroOrigen;
                idAlmacenOrigenValidar = idAlmacenSeleccionado;
                idCajeroDestinoValidar = registro.IdCajeroDestino ?? 0;
                idAlmacenDestinoValidar = idAlmacenSeleccionado; // Los cajeros mostrados son del almacén seleccionado

                if (idCajeroDestinoValidar == 0)
                {
                    await JS.InvokeVoidAsync("alert", "Debe seleccionar un cajero destino.");
                    return;
                }
            }
            else
            {
                idCajeroOrigenValidar = idUsuario;
                idAlmacenOrigenValidar = idAlmacen;
                idCajeroDestinoValidar = registro.IdCajeroDestino ?? 0;
                idAlmacenDestinoValidar = idAlmacen; // Mismo almacén para cajero

                if (idCajeroDestinoValidar == 0)
                {
                    await JS.InvokeVoidAsync("alert", "Debe seleccionar un cajero destino.");
                    return;
                }
            }

            var fechaOperacion = DateOnly.FromDateTime(registro.Fecha);

            // Verificar apertura del cajero origen
            var aperturaOrigen = await CajaService.ObtenerAperturaAsync(idCajeroOrigenValidar, idAlmacenOrigenValidar, fechaOperacion);
            if (aperturaOrigen == null || (aperturaOrigen.Estado != "A" && aperturaOrigen.Estado != "L"))
            {
                var nombreCajeroOrigen = esAdministrador
                  ? cajerosOrigen.FirstOrDefault(c => c.IdUsuario == idCajeroOrigenValidar)?.Nombre ?? "Cajero Origen"
                  : "su caja";
                await JS.InvokeVoidAsync("alert", $"El cajero origen ({nombreCajeroOrigen}) no tiene caja aperturada para la fecha {fechaOperacion:dd/MM/yyyy}.");
                return;
            }

            // Verificar apertura del cajero destino
            var aperturaDestino = await CajaService.ObtenerAperturaAsync(idCajeroDestinoValidar, idAlmacenDestinoValidar, fechaOperacion);
            if (aperturaDestino == null || (aperturaDestino.Estado != "A" && aperturaDestino.Estado != "L"))
            {
                var nombreCajeroDestino = cajerosDestino.FirstOrDefault(c => c.IdUsuario == idCajeroDestinoValidar)?.Nombre ?? "Cajero Destino";
                await JS.InvokeVoidAsync("alert", $"El cajero destino ({nombreCajeroDestino}) no tiene caja aperturada para la fecha {fechaOperacion:dd/MM/yyyy}.");
                return;
            }
        }

        guardando = true;
        try
        {
            // Para administrador en transferencia, usar el cajero origen seleccionado como IdUsuario
            if (registro.Tipo == "TRANSFERENCIA" && esAdministrador && idCajeroOrigen > 0)
            {
                registro.IdUsuario = idCajeroOrigen;
                registro.IdAlmacen = idAlmacenSeleccionado;
                registro.IdAlmacenGasto = idAlmacenSeleccionado;
            }
            else
            {
                registro.IdUsuario = idUsuario;
                registro.IdAlmacen = idAlmacen;
                registro.IdAlmacenGasto = idAlmacen;
            }

            registro.Detalles = new List<IngresoEgresoDetalleDTO> { detalle };
            var ok = await IngresosEgresosService.Registrar(registro);
            if (ok)
            {
                Navigation.NavigateTo($"/ingresos-egresos?naturaleza={tituloNaturaleza}");
            }
        }
        finally
        {
            guardando = false;
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo($"/ingresos-egresos?naturaleza={tituloNaturaleza}");
    }
}