    private async Task ExportarExcelMeta(int idMetaMensual)
    {
        try
        {
            using var response = await MetaMensualService.ExportarExcel(idMetaMensual);
            if (!response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "❌ No se pudo exportar el reporte.");
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            var base64 = Convert.ToBase64String(bytes);
            var nombreArchivo = $"MetaMensual_{idMetaMensual}.xlsx";
            await JS.InvokeVoidAsync("downloadFileFromBytes", nombreArchivo, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"❌ Error al exportar: {ex.Message}");
        }
    }

