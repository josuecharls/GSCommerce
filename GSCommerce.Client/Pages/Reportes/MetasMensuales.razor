@page "/reportes/metas-mensuales"
@using System.Globalization
@using GSCommerce.Client.Components
@using GSCommerce.Client.Models
@using GSCommerce.Client.Services
@inject MetaMensualService MetaMensualService
@inject AlmacenService AlmacenService
@inject AuthService AuthService
@inject IJSRuntime JS

<ReportsBreadcrumb Title="Metas Mensuales" />

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-sm-4 col-md-2">
                <label class="form-label">Año</label>
                <select class="form-select" @bind="anioSeleccionado" @bind:after="Buscar" disabled="@cargando">
                    @foreach (var anio in aniosDisponibles)
                    {
                        <option value="@anio">@anio</option>
                    }
                </select>
            </div>
            <div class="col-sm-4 col-md-2">
                <label class="form-label">Mes</label>
                <select class="form-select" @bind="mesSeleccionado" @bind:after="Buscar" disabled="@cargando">
                    @foreach (var mes in meses)
                    {
                        <option value="@mes.Numero">@mes.Nombre</option>
                    }
                </select>
            </div>
            @if (esAdministrador)
            {
                <div class="col-sm-4 col-md-3">
                    <label class="form-label">Almacén</label>
                    <select class="form-select" @bind="idAlmacenFiltro" @bind:after="Buscar" disabled="@cargando">
                        <option value="0">Todos</option>
                        @foreach (var almacen in almacenes.Where(a => !string.Equals(a.Nombre, "PRINCIPAL", StringComparison.OrdinalIgnoreCase)))
                        {
                            <option value="@almacen.IdAlmacen">@almacen.Nombre</option>
                        }
                    </select>
                </div>
            }
            <div class="col-sm-12 col-md-4 d-flex gap-2">
                <button class="btn btn-primary" @onclick="Buscar" disabled="@cargando">
                    <i class="bi bi-search"></i> Buscar
                </button>
                @if (esAdministrador)
                {
                    <button class="btn btn-success" @onclick="MostrarModalCrear" disabled="@cargando">
                        <i class="bi bi-plus-circle"></i> Nueva Meta
                    </button>
                    <button class="btn btn-info" @onclick="MostrarModalGenerarTodas" disabled="@cargando">
                        <i class="bi bi-gear"></i> Generar para Todos
                    </button>
                    <button class="btn btn-primary" @onclick="ExportarExcelTodas" disabled="@(!metas.Any() || cargando)">
                        <i class="bi bi-file-earmark-excel"></i> Exportar Todas
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@if (cargando)
{
    <div class="alert alert-info text-center">Cargando información...</div>
}
else if (!metas.Any())
{
    <div class="alert alert-warning text-center">No se encontraron metas para el periodo seleccionado.</div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white text-center">
            <h4 class="mb-0">BALANCE MENSUAL</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead style="background-color: #FFFF00;">
                        <tr class="text-center">
                            <th style="background-color: #FF0000; color: white; border: 2px solid #FF0000;">ALMACEN</th>
                            <th style="border: 2px solid #000;">CUOTA</th>
                            <th style="border: 2px solid #000;">VENTA REAL</th>
                            <th style="border: 2px solid #000;">DIFERENCIA</th>
                            <th style="border: 2px solid #000;">%</th>
                            <th style="border: 2px solid #000;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var meta in metas)
                        {
                            var diferencia = (meta.VentaAcumulada ?? 0) - meta.MetaMensual;
                            var esNegativo = diferencia < 0;
                            <tr>
                                <td class="fw-bold" style="background-color: #FFFF00; border: 2px solid #FF0000;">@meta.NombreAlmacen</td>
                                <td class="text-end">
                                    @if (esAdministrador && editandoCuotaMensual == meta.IdMetaMensual)
                                    {
                                        <input type="number" class="form-control form-control-sm text-end" 
                                               @bind="cuotaMensualEditada" @bind:event="oninput"
                                               @onblur="() => GuardarCuotaMensual(meta)" 
                                               @onkeydown="@(e => { if (e.Key == "Enter") GuardarCuotaMensual(meta); })"
                                               style="width: 120px;" />
                                    }
                                    else
                                    {
                                        <span @ondblclick="() => IniciarEdicionCuotaMensual(meta)">S/ @meta.MetaMensual.ToString("N0")</span>
                                    }
                                </td>
                                <td class="text-end">S/ @((meta.VentaAcumulada ?? 0).ToString("N0"))</td>
                                <td class="text-end @(esNegativo ? "text-danger" : "text-success")">
                                    @(esNegativo ? "-" : "")S/ @Math.Abs(diferencia).ToString("N0")
                                </td>
                                <td class="text-end">
                                    <span class="@(meta.PorcentajeCumplimiento >= 100 ? "text-success" : meta.PorcentajeCumplimiento >= 80 ? "text-warning" : "text-danger")">
                                        @((meta.PorcentajeCumplimiento ?? 0).ToString("N1"))%
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button class="btn btn-outline-primary" @onclick="() => VerDetalle(meta)" title="Ver Detalle">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-success" @onclick="() => ExportarExcelMeta(meta.IdMetaMensual)" title="Exportar Excel">
                                            <i class="bi bi-file-earmark-excel"></i>
                                        </button>
                                        @if (meta.Estado == "PENDIENTE" && PuedeEnviar(meta))
                                        {
                                            <button class="btn btn-outline-info" @onclick="() => EnviarPropuesta(meta)" title="Enviar Propuesta">
                                                <i class="bi bi-send"></i>
                                            </button>
                                        }
                                        @if (string.Equals(meta.Estado?.Trim(), "ENVIADA", StringComparison.OrdinalIgnoreCase) && esAdministrador)
                                        {
                                            <button class="btn btn-outline-success" @onclick="() => MostrarModalAprobar(meta, true)" title="Aprobar">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" @onclick="() => MostrarModalAprobar(meta, false)" title="Rechazar">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot style="background-color: #FFFF00; font-weight: bold;">
                        @{
                            var totalCuota = metas.Sum(m => m.MetaMensual);
                            var totalVentaReal = metas.Sum(m => m.VentaAcumulada ?? 0);
                            var totalDiferencia = totalVentaReal - totalCuota;
                            var porcentajeTotal = totalCuota > 0 ? (totalVentaReal / totalCuota) * 100 : 0;
                            var esDiferenciaNegativa = totalDiferencia < 0;
                        }
                        <tr class="text-center">
                            <td class="fw-bold" style="background-color: #FFFF00;">TOTALES</td>
                            <td class="text-end" style="background-color: #FFFF00;">S/@totalCuota.ToString("N0")</td>
                            <td class="text-end" style="background-color: #FFFF00;">S/ @totalVentaReal.ToString("N0")</td>
                            <td class="text-end @(esDiferenciaNegativa ? "text-danger" : "text-success")" style="background-color: #FFFF00;">
                                S/ @totalDiferencia.ToString("N0")
                            </td>
                            <td class="text-end" style="background-color: #FFFF00;">@porcentajeTotal.ToString("N1")%</td>
                            <td style="background-color: #FFFF00;"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}


<!-- Modal Crear Meta -->
@if (mostrarModalCrear)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva Meta Mensual</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalCrear"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Almacén</label>
                        <select class="form-select" @bind="nuevaMeta.IdAlmacen">
                            <option value="0">Seleccione un almacén</option>
                            @foreach (var almacen in almacenes)
                            {
                                <option value="@almacen.IdAlmacen">@almacen.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Año</label>
                        <select class="form-select" @bind="nuevaMeta.Anio">
                            @foreach (var anio in aniosDisponibles)
                            {
                                <option value="@anio">@anio</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mes</label>
                        <select class="form-select" @bind="nuevaMeta.Mes">
                            @foreach (var mes in meses)
                            {
                                <option value="@mes.Numero">@mes.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Meses Históricos para Cálculo</label>
                        <input type="number" class="form-control" @bind="nuevaMeta.MesesHistoricos" min="1" max="12" />
                        <small class="form-text text-muted">Número de meses anteriores a considerar para calcular la meta mensual y distribución diaria</small>
                    </div>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> La meta mensual se calculará automáticamente basándose en los datos históricos de ventas.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalCrear">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="CrearMeta" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Crear Meta
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<!-- Modal Generar Todas -->
@if (mostrarModalGenerarTodas)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Generar Metas para Todos los Almacenes</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalGenerarTodas"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Año</label>
                        <select class="form-select" @bind="generarTodasRequest.Anio">
                            @foreach (var anio in aniosDisponibles)
                            {
                                <option value="@anio">@anio</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mes</label>
                        <select class="form-select" @bind="generarTodasRequest.Mes">
                            @foreach (var mes in meses)
                            {
                                <option value="@mes.Numero">@mes.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Meses Históricos para Cálculo</label>
                        <input type="number" class="form-control" @bind="generarTodasRequest.MesesHistoricos" min="1" max="12" />
                        <small class="form-text text-muted">Número de meses anteriores a considerar para calcular la meta mensual y distribución diaria</small>
                    </div>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Se generarán metas automáticamente para todos los almacenes que son tiendas. Las metas se calcularán basándose en los datos históricos de ventas.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalGenerarTodas">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="GenerarMetasParaTodos" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Generar Metas
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<!-- Modal Aprobar/Rechazar -->
@if (mostrarModalAprobar)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(aprobarMeta ? "Aprobar" : "Rechazar") Propuesta</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalAprobar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro que desea @(aprobarMeta ? "aprobar" : "rechazar") la propuesta de meta para <strong>@metaSeleccionada?.NombreAlmacen</strong>?</p>
                    <div class="mb-3">
                        <label class="form-label">Observaciones (opcional)</label>
                        <textarea class="form-control" @bind="observacionesAprobacion" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalAprobar">Cancelar</button>
                    <button type="button" class="btn @(aprobarMeta ? "btn-success" : "btn-danger")" @onclick="ConfirmarAprobarRechazar" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        @(aprobarMeta ? "Aprobar" : "Rechazar")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<!-- Modal Detalle -->
@if (mostrarModalDetalle && metaDetalle != null)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">@metaDetalle.NombreAlmacen - @cultura.TextInfo.ToTitleCase(new DateTime(metaDetalle.Anio, metaDetalle.Mes, 1).ToString("MMMM", cultura)) @metaDetalle.Anio</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalDetalle"></button>
                </div>
                <div class="modal-body">
                    @{
                        var totalCuotaDetalle = metaDetalle.Detalles.Sum(d => d.MetaDiaria);
                        var totalVentaDetalle = metaDetalle.Detalles.Sum(d => d.VentaReal ?? 0);
                        var totalDiferenciaDetalle = totalVentaDetalle - totalCuotaDetalle;
                        var totalClientes = metaDetalle.Detalles.Sum(d => d.NumeroClientes ?? 0);
                    }
                    <!-- Summary Section (like image 3) -->
                    <div class="mb-3">
                        <table class="table table-bordered" style="width: auto;">
                            <tbody>
                                <tr>
                                    <td class="fw-bold" style="background-color: #FFFF00;">META MENSUAL</td>
                                    <td class="text-end">S/ @totalCuotaDetalle.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold" style="background-color: #FFFF00;">AVANCE DE LA META MENSUAL</td>
                                    <td class="text-end">S/ @totalVentaDetalle.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold" style="background-color: #FFFF00;">DIFERENCIA</td>
                                    <td class="text-end @(totalDiferenciaDetalle >= 0 ? "text-success" : "text-danger")">
                                        S/ @totalDiferenciaDetalle.ToString("N0")
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Detail Table (like image 2) -->
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm table-bordered mb-0">
                            <thead style="background-color: #FFFF00;" class="sticky-top">
                                <tr class="text-center">
                                    <th style="border: 2px solid #000;">DIA (@metaDetalle.Anio)</th>
                                    <th style="border: 2px solid #000;">CUOTA</th>
                                    <th style="border: 2px solid #000;">TOTAL DE VENTA</th>
                                    <th style="border: 2px solid #000;">DIFERENCIA</th>
                                    <th style="border: 2px solid #000;">N° CLIENTES</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detalle in metaDetalle.Detalles)
                                {
                                    var diferenciaDetalle = (detalle.VentaReal ?? 0) - detalle.MetaDiaria;
                                    var esNegativoDetalle = diferenciaDetalle < 0;
                                    var diaNombre = cultura.TextInfo.ToTitleCase(detalle.Fecha.ToDateTime(TimeOnly.MinValue).ToString("dddd", cultura));
                                    <tr>
                                        <td>@diaNombre @detalle.Fecha.Day.ToString("D2")</td>
                                        <td class="text-end">
                                            @if (esAdministrador && editandoCuotaDiaria == detalle.IdMetaMensualDetalle)
                                            {
                                                <input type="number" class="form-control form-control-sm text-end"
                                                       @bind="cuotaDiariaEditada" @bind:event="oninput"
                                                       @onblur="() => GuardarCuotaDiaria(detalle)"
                                                       @onkeydown="@(e => { if (e.Key == "Enter") GuardarCuotaDiaria(detalle); })"
                                                       style="width: 100px;" />
                                            }
                                            else
                                            {
                                                <span @ondblclick="() => IniciarEdicionCuotaDiaria(detalle)">S/ @detalle.MetaDiaria.ToString("N0")</span>
                                            }
                                        </td>
                                        <td class="text-end">S/ @((detalle.VentaReal ?? 0).ToString("N0"))</td>
                                        <td class="text-end @(esNegativoDetalle ? "text-danger" : "text-success")">
                                            @(esNegativoDetalle ? "-" : "")S/ @Math.Abs(diferenciaDetalle).ToString("N0")
                                        </td>
                                        <td class="text-center">@(detalle.NumeroClientes ?? 0)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot style="background-color: #FFFF00; font-weight: bold;">
                                <tr class="text-center">
                                    <td class="fw-bold">TOTALES</td>
                                    <td class="text-end">S/ @totalCuotaDetalle.ToString("N0")</td>
                                    <td class="text-end">S/ @totalVentaDetalle.ToString("N0")</td>
                                    <td class="text-end @(totalDiferenciaDetalle >= 0 ? "text-success" : "text-danger")">
                                        S/ @totalDiferenciaDetalle.ToString("N0")
                                    </td>
                                    <td class="text-center">@totalClientes</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    @if (esAdministrador && detallesModificados.Any())
                    {
                        <button type="button" class="btn btn-primary" @onclick="GuardarTodosDetalles" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-save"></i> Guardar Cambios
                        </button>
                    }
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalDetalle">Cerrar</button>
                    <button type="button" class="btn btn-success" @onclick="() => ExportarExcelMeta(metaDetalle.IdMetaMensual)">
                        <i class="bi bi-file-earmark-excel"></i> Exportar Excel
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}


@code {
    private readonly CultureInfo cultura = CultureInfo.CreateSpecificCulture("es-PE");
    private List<MetaMensualDTO> metas = new();
    private List<AlmacenDTO> almacenes = new();
    private readonly int anioActual = DateTime.Today.Year;
    private int anioSeleccionado = DateTime.Today.Year;
    private int mesSeleccionado = DateTime.Today.Month;
    private int idAlmacenFiltro = 0;
    private bool cargando;
    private string? cargo;
    private bool esAdministrador;
    private bool mostrarModalCrear;
    private bool mostrarModalGenerarTodas;
    private bool mostrarModalAprobar;
    private bool mostrarModalDetalle;
    private bool guardando;
    private CrearMetaMensualRequest nuevaMeta = new();
    private CrearMetaMensualRequest generarTodasRequest = new();
    private MetaMensualDTO? metaSeleccionada;
    private MetaMensualDTO? metaDetalle;
    private bool aprobarMeta;
    private string? observacionesAprobacion;
    
    // Variables para edición inline
    private int? editandoCuotaMensual;
    private decimal cuotaMensualEditada;
    private int? editandoCuotaDiaria;
    private decimal cuotaDiariaEditada;
    private HashSet<int> detallesModificados = new();


    private IEnumerable<int> aniosDisponibles => Enumerable.Range(anioActual - 1, 3).OrderByDescending(a => a);

    private IEnumerable<(int Numero, string Nombre)> meses => Enumerable.Range(1, 12)
        .Select(m => (Numero: m, Nombre: cultura.TextInfo.ToTitleCase(new DateTime(2000, m, 1).ToString("MMMM", cultura))));

    protected override async Task OnInitializedAsync()
    {
        cargo = await AuthService.GetUserCargo();
        esAdministrador = string.Equals(cargo, "ADMINISTRADOR", StringComparison.OrdinalIgnoreCase);
        almacenes = await AlmacenService.GetAlmacenes() ?? new List<AlmacenDTO>();
        await Buscar();
    }

    private async Task Buscar()
    {
        cargando = true;
        try
        {
            // Si idAlmacenFiltro es 0 (Todos), pasar null para obtener todas las metas
            int? idAlmacen = idAlmacenFiltro > 0 ? idAlmacenFiltro : null;
            metas = await MetaMensualService.ObtenerMetas(anioSeleccionado, mesSeleccionado, idAlmacen);
        }
        finally
        {
            cargando = false;
        }
    }

    private void MostrarModalCrear()
    {
        nuevaMeta = new CrearMetaMensualRequest
        {
            Anio = anioSeleccionado,
            Mes = mesSeleccionado,
            MesesHistoricos = 3
        };
        mostrarModalCrear = true;
    }

    private void CerrarModalCrear()
    {
        mostrarModalCrear = false;
        nuevaMeta = new CrearMetaMensualRequest();
    }

    private async Task CrearMeta()
    {
        if (nuevaMeta.IdAlmacen == 0)
        {
            await JS.InvokeVoidAsync("alert", "Por favor seleccione un almacén");
            return;
        }

        guardando = true;
        try
        {
            var exito = await MetaMensualService.CrearMeta(nuevaMeta);
            if (exito)
            {
                await JS.InvokeVoidAsync("alert", "✅ Meta creada correctamente. La meta mensual fue calculada automáticamente desde datos históricos.");
                CerrarModalCrear();
                await Buscar();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "❌ No se pudo crear la meta. Verifique que no exista ya una meta para este almacén y período.");
            }
        }
        finally
        {
            guardando = false;
        }
    }

    private void MostrarModalGenerarTodas()
    {
        generarTodasRequest = new CrearMetaMensualRequest
        {
            Anio = anioSeleccionado,
            Mes = mesSeleccionado,
            MesesHistoricos = 3
        };
        mostrarModalGenerarTodas = true;
    }

    private void CerrarModalGenerarTodas()
    {
        mostrarModalGenerarTodas = false;
        generarTodasRequest = new CrearMetaMensualRequest();
    }

    private async Task GenerarMetasParaTodos()
    {
        guardando = true;
        try
        {
            var exito = await MetaMensualService.GenerarMetasParaTodosAlmacenes(generarTodasRequest);
            if (exito)
            {
                await JS.InvokeVoidAsync("alert", "✅ Metas generadas correctamente para todos los almacenes.");
                CerrarModalGenerarTodas();
                await Buscar();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "❌ No se pudieron generar las metas.");
            }
        }
        finally
        {
            guardando = false;
        }
    }

private bool PuedeEnviar(MetaMensualDTO meta)
{
    var fechaInicioMes = new DateTime(meta.Anio, meta.Mes, 1);
    var fechaInicioPermitida = fechaInicioMes.AddDays(-7); // Penúltimo día del mes anterior
    var fechaFinPermitida = fechaInicioMes; // Primer día del mes de la meta
    var fechaActual = DateTime.Now.Date; // Solo comparar fechas, sin hora
    
    return fechaActual >= fechaInicioPermitida.Date && fechaActual <= fechaFinPermitida.Date;
}

    private async Task EnviarPropuesta(MetaMensualDTO meta)
    {
        if (!PuedeEnviar(meta))
        {
            await JS.InvokeVoidAsync("alert", "Las propuestas deben enviarse al menos 2 días antes del inicio del mes");
            return;
        }

        var confirmar = await JS.InvokeAsync<bool>("confirm", $"¿Está seguro que desea enviar la propuesta para {meta.NombreAlmacen}?");
        if (!confirmar)
            return;

        cargando = true;
        try
        {
            var exito = await MetaMensualService.EnviarPropuesta(meta.IdMetaMensual);
            if (exito)
            {
                await JS.InvokeVoidAsync("alert", "✅ Propuesta enviada correctamente");
                await Buscar();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "❌ No se pudo enviar la propuesta");
            }
        }
        finally
        {
            cargando = false;
        }
    }

