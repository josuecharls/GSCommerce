    // Métodos para edición de cuota mensual
    private void IniciarEdicionCuotaMensual(MetaMensualDTO meta)
    {
        if (!esAdministrador) return;
        editandoCuotaMensual = meta.IdMetaMensual;
        cuotaMensualEditada = meta.MetaMensual;
    }

    private async Task GuardarCuotaMensual(MetaMensualDTO meta)
    {
        if (editandoCuotaMensual != meta.IdMetaMensual) return;
        
        editandoCuotaMensual = null;
        
        if (cuotaMensualEditada == meta.MetaMensual) return;
        
        guardando = true;
        try
        {
            var exito = await MetaMensualService.ActualizarMetaMensual(meta.IdMetaMensual, cuotaMensualEditada);
            if (exito)
            {
                meta.MetaMensual = Math.Round(cuotaMensualEditada, 0);
                await JS.InvokeVoidAsync("alert", "✅ Cuota mensual actualizada correctamente");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "❌ No se pudo actualizar la cuota mensual");
            }
        }
        finally
        {
            guardando = false;
        }
    }

    // Métodos para edición de cuota diaria
    private void IniciarEdicionCuotaDiaria(MetaMensualDetalleDTO detalle)
    {
        if (!esAdministrador) return;
        editandoCuotaDiaria = detalle.IdMetaMensualDetalle;
        cuotaDiariaEditada = detalle.MetaDiaria;
    }

    private void GuardarCuotaDiaria(MetaMensualDetalleDTO detalle)
    {
        if (editandoCuotaDiaria != detalle.IdMetaMensualDetalle) return;
        
        editandoCuotaDiaria = null;
        
        if (cuotaDiariaEditada != detalle.MetaDiaria)
        {
            detalle.MetaDiaria = Math.Round(cuotaDiariaEditada, 0);
            detallesModificados.Add(detalle.IdMetaMensualDetalle);
        }
    }

    private async Task GuardarTodosDetalles()
    {
        if (metaDetalle == null || !detallesModificados.Any()) return;
        
        guardando = true;
        try
        {
            var detallesActualizar = metaDetalle.Detalles
                .Where(d => detallesModificados.Contains(d.IdMetaMensualDetalle))
                .Select(d => new DetalleActualizacion
                {
                    IdMetaMensualDetalle = d.IdMetaMensualDetalle,
                    MetaDiaria = d.MetaDiaria
                })
                .ToList();
            
            var exito = await MetaMensualService.ActualizarDetalles(metaDetalle.IdMetaMensual, detallesActualizar);
            if (exito)
            {
                detallesModificados.Clear();
                // Actualizar la meta mensual local con la suma de cuotas
                metaDetalle.MetaMensual = metaDetalle.Detalles.Sum(d => d.MetaDiaria);
                // Actualizar también en la lista principal
                var metaEnLista = metas.FirstOrDefault(m => m.IdMetaMensual == metaDetalle.IdMetaMensual);
                if (metaEnLista != null)
                {
                    metaEnLista.MetaMensual = metaDetalle.MetaMensual;
                }
                await JS.InvokeVoidAsync("alert", "✅ Cuotas diarias actualizadas correctamente");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "❌ No se pudieron actualizar las cuotas diarias");
            }
        }
        finally
        {
            guardando = false;
        }
    }
