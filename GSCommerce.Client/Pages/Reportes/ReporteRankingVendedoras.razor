@page "/reportes/ranking-vendedoras"
@using GSCommerce.Client.Components
@using GSCommerce.Client.Models
@using GSCommerce.Client.Models.DTOs.Reportes
@using GSCommerce.Client.Services
@using System.Text
@using System.Linq
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ReporteService ReporteService
@inject AlmacenService AlmacenService
@inject AuthService AuthService
@inject IJSRuntime JS

<ReportsBreadcrumb Title="Ranking de Vendedoras" />

<div class="row mb-3">
    <div class="col-md-4">
        <label>Desde:</label>
        <InputDate @bind-Value="desde" class="form-control" />
    </div>
    <div class="col-md-4">
        <label>Hasta:</label>
        <InputDate @bind-Value="hasta" class="form-control" />
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button class="btn btn-primary w-100" @onclick="BuscarRanking"><i class="bi bi-search"></i> Buscar</button>
    </div>
</div>
<div class="row mb-3">
    @if (cargo == "ADMINISTRADOR")
    {
        <div class="col-md-4">
            <label><input type="radio" value="false" @onchange="e => porAlmacen = false" checked="@(!porAlmacen)" /> Global</label>
            <label class="ms-3"><input type="radio" value="true" @onchange="e => porAlmacen = true" checked="@(porAlmacen)" /> Por Almacén</label>
            <select class="form-select mt-1" @bind="idAlmacenSeleccionado" disabled="@(porAlmacen == false)">
                <option value="0">-- Seleccionar almacén --</option>
                @foreach (var a in almacenes)
                {
                    <option value="@a.IdAlmacen">@a.Nombre</option>
                }
            </select>
        </div>
    }
    else if (cargo == "CAJERO")
    {
        <div class="col-md-4">
            <label>Almacén:</label>
            <select class="form-select mt-1" @bind="idAlmacenSeleccionado" disabled>
                @foreach (var a in almacenes)
                {
                    <option value="@a.IdAlmacen">@a.Nombre</option>
                }
            </select>
        </div>
    }
</div>
<div class="row mb-3">
    <div class="col d-flex justify-content-end gap-2">
        @if (cargo == "CAJERO" || cargo == "ADMINISTRADOR")
        {
            <button class="btn btn-success" @onclick="ExportarExcel"><i class="bi bi-file-earmark-excel-fill"></i> Exportar a Excel</button>
            <button class="btn btn-danger" @onclick="ExportarPDF"><i class="bi bi-filetype-pdf"></i> Descargar PDF</button>
        }
    </div>
</div>
@if (ranking.Any())
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Vendedora</th>
                <th>Estado</th>
                <th>Ventas Realizadas</th>
                <th>Monto Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in ranking.Select((r, i) => new { r, i }))
            {
                <tr>
                    <td>@(item.i + 1)</td>
                    <td>@item.r.Vendedora</td>
                    <td>@(item.r.Activo ? "Activo" : "Inactivo")</td>
                    <td>@item.r.VentasRealizadas</td>
                    <td>S/ @item.r.TotalVentas.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info text-center">No hay ventas registradas en este rango.</div>
}

@code {
    private List<RankingVendedoraDTO> ranking = new();
    private DateTime desde = DateTime.Today;
    private List<AlmacenDTO> almacenes = new();
    private int idAlmacenSeleccionado;
    private bool porAlmacen = false;
    private DateTime hasta = DateTime.Today;
    private string? cargo;
    private int? idAlmacenUsuario;

    protected override async Task OnInitializedAsync()
    {
        almacenes = await AlmacenService.GetAlmacenes() ?? new();
        cargo = await AuthService.GetUserCargo();
        idAlmacenUsuario = await AuthService.GetUserAlmacenId();

        if (cargo == "CAJERO")
        {
            porAlmacen = true;
            idAlmacenSeleccionado = idAlmacenUsuario ?? 0;
            almacenes = almacenes.Where(a => a.IdAlmacen == idAlmacenSeleccionado).ToList();
        }

        await BuscarRanking();
    }


    private async Task BuscarRanking()
    {
        ranking = await ReporteService.ObtenerRankingVendedoras(
            desde,
            hasta,
            porAlmacen ? idAlmacenSeleccionado : (int?)null,
            porAlmacen);
    }


    private async Task ExportarExcel()
    {
        var headers = new[] { "Ranking", "Vendedor", "Estado", "Cantidad", "Monto" };
        var rows = ranking.Select((r, i) => new object[]
        {
            i + 1,
            r.Vendedora,
            r.Activo ? "Activo" : "Inactivo",
            r.VentasRealizadas,
            r.TotalVentas
        }).ToArray();

        await JS.InvokeVoidAsync("exportToExcel", headers, rows, $"RankingVendedoras_{desde:yyyyMMdd}_{hasta:yyyyMMdd}");
    }

    private async Task ExportarPDF()
    {
        var almacenesPdf = porAlmacen && idAlmacenSeleccionado > 0
            ? almacenes.Where(a => a.IdAlmacen == idAlmacenSeleccionado).ToList()
            : almacenes;

        // Pre-cargar todos los datos primero
        var datosPorAlmacen = new List<(AlmacenDTO Almacen, List<RankingVendedoraDTO> Datos)>();
        foreach (var alm in almacenesPdf)
        {
            var datos = await ReporteService.ObtenerRankingVendedoras(desde, hasta, alm.IdAlmacen, true);
            if (datos.Any())
                datosPorAlmacen.Add((alm, datos));
        }

        var sb = new StringBuilder();

        // ─── ESTILOS GLOBALES ────────────────────────────────────────────────
        sb.AppendLine(@"
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Segoe UI', Arial, sans-serif; background: #f0f4f8; }
  .page-wrap { width: 780px; margin: 0 auto; background: #fff; padding: 0 0 32px 0; }

  /* HEADER */
  .pdf-header {
    background: linear-gradient(135deg, #1a2f5e 0%, #2563eb 100%);
    color: #fff;
    padding: 28px 36px 22px 36px;
    border-radius: 0 0 12px 12px;
    margin-bottom: 24px;
  }
  .pdf-header h1 { font-size: 22px; font-weight: 700; letter-spacing: 1px; margin-bottom: 4px; }
  .pdf-header .subtitle { font-size: 13px; opacity: .85; }
  .pdf-header .periodo {
    display: inline-block;
    margin-top: 10px;
    background: rgba(255,255,255,.18);
    border-radius: 20px;
    padding: 4px 16px;
    font-size: 12px;
    font-weight: 600;
  }

  /* SECCIÓN ALMACÉN */
  .almacen-section { margin: 0 32px 28px 32px; }
  .almacen-title {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #1a2f5e;
    color: #fff;
    padding: 9px 18px;
    border-radius: 8px 8px 0 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .5px;
    text-transform: uppercase;
  }
  .almacen-title .icon { font-size: 16px; }

  /* TABLA */
  table { width: 100%; border-collapse: collapse; }
  thead tr { background: #2563eb; color: #fff; }
  thead th {
    padding: 10px 12px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .5px;
  }
  thead th:first-child { text-align: center; width: 42px; }
  thead th:nth-child(3),
  thead th:nth-child(4),
  thead th:nth-child(5) { text-align: center; }

  tbody tr { border-bottom: 1px solid #e2e8f0; }
  tbody tr:nth-child(even) { background: #f8fafc; }
  tbody tr:hover { background: #eff6ff; }
  tbody td { padding: 9px 12px; font-size: 12px; color: #1e293b; vertical-align: middle; }
  tbody td:first-child { text-align: center; font-weight: 700; }
  tbody td:nth-child(4) { text-align: center; font-weight: 600; color: #2563eb; }
  tbody td:nth-child(5) { text-align: right; font-weight: 700; color: #16a34a; font-size: 13px; }

  /* MEDALLAS TOP 3 */
  .medal-1 { background: linear-gradient(135deg, #fef9c3, #fde68a) !important; }
  .medal-2 { background: linear-gradient(135deg, #f1f5f9, #e2e8f0) !important; }
  .medal-3 { background: linear-gradient(135deg, #fff7ed, #fed7aa) !important; }

  .rank-badge {
    display: inline-block;
    width: 26px; height: 26px;
    border-radius: 50%;
    line-height: 26px;
    font-size: 11px;
    font-weight: 700;
    color: #fff;
    text-align: center;
  }
  .rank-1 { background: #eab308; }
  .rank-2 { background: #94a3b8; }
  .rank-3 { background: #c2783c; }
  .rank-other { background: #cbd5e1; color: #475569; }

  /* ESTADO BADGE */
  .badge-activo {
    background: #dcfce7; color: #15803d;
    padding: 2px 10px; border-radius: 12px;
    font-size: 10px; font-weight: 700; text-transform: uppercase;
  }
  .badge-inactivo {
    background: #fee2e2; color: #b91c1c;
    padding: 2px 10px; border-radius: 12px;
    font-size: 10px; font-weight: 700; text-transform: uppercase;
  }

  /* FILA TOTALES */
  .totals-row td {
    background: #1e3a8a !important;
    color: #fff !important;
    font-weight: 700 !important;
    font-size: 12px !important;
    padding: 10px 12px !important;
    border-top: 2px solid #1a2f5e !important;
  }
  .totals-row td:nth-child(4) { color: #bfdbfe !important; text-align: center; }
  .totals-row td:nth-child(5) { color: #86efac !important; text-align: right; font-size: 14px !important; }

  /* SIN DATOS */
  .no-data {
    text-align: center;
    padding: 20px;
    color: #94a3b8;
    font-size: 13px;
    font-style: italic;
    border: 1px dashed #cbd5e1;
    border-radius: 0 0 8px 8px;
  }

  /* FOOTER */
  .pdf-footer {
    margin: 0 32px;
    padding-top: 16px;
    border-top: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: #94a3b8;
  }
</style>");

        sb.AppendLine("<div class='page-wrap'>");

        // ─── HEADER ────────────────────────────────────────────────────────
        sb.AppendLine($@"
<div class='pdf-header'>
  <h1>&#x1F3C6; RANKING DE VENDEDORAS</h1>
  <div class='subtitle'>Reporte de desempeño por ventas realizadas</div>
  <div class='periodo'>&#x1F4C5; Periodo: {desde:dd/MM/yyyy} &nbsp;&#x2192;&nbsp; {hasta:dd/MM/yyyy}</div>
</div>");

        // ─── SECCIONES POR ALMACÉN ─────────────────────────────────────────
        foreach (var (alm, datos) in datosPorAlmacen)
        {
            var totalMonto    = datos.Sum(d => d.TotalVentas);
            var totalCantidad = datos.Sum(d => d.VentasRealizadas);

            sb.AppendLine("<div class='almacen-section'>");
            sb.AppendLine($"<div class='almacen-title'><span class='icon'>&#x1F3EA;</span>{alm.Nombre}</div>");
            sb.AppendLine("<table>");
            sb.AppendLine("<thead><tr><th>#</th><th>Vendedora</th><th>Estado</th><th>Ventas</th><th>Monto Total</th></tr></thead>");
            sb.AppendLine("<tbody>");

            var index = 1;
            foreach (var d in datos)
            {
                var rowClass  = index == 1 ? "medal-1" : index == 2 ? "medal-2" : index == 3 ? "medal-3" : "";
                var badgeClass = index == 1 ? "rank-1" : index == 2 ? "rank-2" : index == 3 ? "rank-3" : "rank-other";
                var estadoBadge = d.Activo
                    ? "<span class='badge-activo'>Activo</span>"
                    : "<span class='badge-inactivo'>Inactivo</span>";

                sb.AppendLine($@"<tr class='{rowClass}'>
  <td><span class='rank-badge {badgeClass}'>{index}</span></td>
  <td>{System.Net.WebUtility.HtmlEncode(d.Vendedora)}</td>
  <td style='text-align:center'>{estadoBadge}</td>
  <td>{d.VentasRealizadas}</td>
  <td>S/ {d.TotalVentas:N2}</td>
</tr>");
                index++;
            }

            // Fila de totales
            sb.AppendLine($@"<tr class='totals-row'>
  <td colspan='3'><strong>TOTAL ALMACÉN</strong></td>
  <td>{totalCantidad}</td>
  <td>S/ {totalMonto:N2}</td>
</tr>");

            sb.AppendLine("</tbody></table>");
            sb.AppendLine("</div>"); // almacen-section
        }

        // ─── FOOTER ────────────────────────────────────────────────────────
        sb.AppendLine($@"
<div class='pdf-footer'>
  <span>GSCommerce &mdash; Sistema de Gestión</span>
  <span>Generado el {DateTime.Now:dd/MM/yyyy} a las {DateTime.Now:HH:mm}</span>
</div>");

        sb.AppendLine("</div>"); // page-wrap

        await JS.InvokeVoidAsync("generarPDFDesdeHTML", sb.ToString(), $"Ranking_Vendedoras_{DateTime.Now:yyyyMMdd_HHmmss}");
    }
}
