@page "/reportes/ranking-vendedoras"
@using GSCommerce.Client.Components
@using GSCommerce.Client.Models
@using GSCommerce.Client.Models.DTOs.Reportes
@using GSCommerce.Client.Services
@using System.Text
@using System.Linq
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ReporteService ReporteService
@inject AlmacenService AlmacenService
@inject AuthService AuthService
@inject IJSRuntime JS

<ReportsBreadcrumb Title="Ranking de Vendedoras" />

<div class="row mb-3 g-2 align-items-end">
    <div class="col-md-3">
        <label class="form-label">Fecha</label>
        <InputDate @bind-Value="fechaConsulta" class="form-control" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary w-100" @onclick="BuscarRanking"><i class="bi bi-search"></i> Buscar</button>
    </div>
    <div class="col-md-7 d-flex flex-wrap justify-content-md-end gap-2 align-items-end">
        <button type="button" class="btn btn-outline-secondary" @onclick="AbrirModalConsultaRango">
            <i class="bi bi-calendar-range"></i> Consultar por fechas
        </button>
        @if (cargo == "CAJERO" || cargo == "ADMINISTRADOR")
        {
            <button class="btn btn-success" @onclick="ExportarExcel"><i class="bi bi-file-earmark-excel-fill"></i> Exportar a Excel</button>
            <button class="btn btn-danger" @onclick="ExportarPDF"><i class="bi bi-filetype-pdf"></i> Descargar PDF</button>
        }
    </div>
</div>
<div class="row mb-3">
    @if (cargo == "ADMINISTRADOR")
    {
        <div class="col-md-4">
            <label><input type="radio" value="false" @onchange="e => porAlmacen = false" checked="@(!porAlmacen)" /> Global</label>
            <label class="ms-3"><input type="radio" value="true" @onchange="e => porAlmacen = true" checked="@(porAlmacen)" /> Por Almacén</label>
            <select class="form-select mt-1" @bind="idAlmacenSeleccionado" disabled="@(porAlmacen == false)">
                <option value="0">-- Seleccionar almacén --</option>
                @foreach (var a in almacenes)
                {
                    <option value="@a.IdAlmacen">@a.Nombre</option>
                }
            </select>
        </div>
    }
    else if (cargo == "CAJERO")
    {
        <div class="col-md-4">
            <label>Almacén:</label>
            <select class="form-select mt-1" @bind="idAlmacenSeleccionado" disabled>
                @foreach (var a in almacenes)
                {
                    <option value="@a.IdAlmacen">@a.Nombre</option>
                }
            </select>
        </div>
    }
</div>
@if (ranking.Any())
{
    <p class="text-muted small mb-2">
        Día <strong>@fechaConsulta.ToString("dd/MM/yyyy")</strong>. La <strong>meta</strong> es por <strong>almacén</strong> (todas las vendedoras del mismo local comparten el valor) y puede variar cada día.
        <strong>% vendido</strong> = ventas del día ÷ meta de ese almacén para esa fecha.
    </p>
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Vendedora</th>
                <th>Estado</th>
                <th>Ventas Realizadas</th>
                <th>Artículos Vendidos</th>
                <th>Monto Total</th>
                <th>Meta (día)</th>
                <th>% vendido</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in filasRanking.Select((x, i) => new { x.r, x.mostrarBotonMeta, i }))
            {
                <tr>
                    <td>@(item.i + 1)</td>
                    <td>@item.r.Vendedora</td>
                    <td>@(item.r.Activo ? "Activo" : "Inactivo")</td>
                    <td>@item.r.VentasRealizadas</td>
                    <td>@item.r.ArticulosVendidos</td>
                    <td>S/ @item.r.TotalVentas.ToString("N2")</td>
                    <td class="text-nowrap">
                        @if (item.r.MetaVentasDiarias.HasValue)
                        {
                            <span class="fw-semibold">@item.r.MetaVentasDiarias</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                        @if (cargo == "ADMINISTRADOR" && item.mostrarBotonMeta)
                        {
                            @if (!item.r.MetaVentasDiarias.HasValue)
                            {
                                <button type="button" class="btn btn-sm btn-outline-success py-0 px-1 ms-1 align-baseline" title="Definir meta del almacén para este día" @onclick="() => AbrirModalMeta(item.r)">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 ms-1 align-baseline" title="Editar meta del almacén para este día" @onclick="() => AbrirModalMeta(item.r)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            }
                        }
                    </td>
                    <td>
                        @if (item.r.PorcentajeVendido is decimal p)
                        {
                            <span class="badge @GetClasePctVendido(p)">@($"{p:0.00}%")</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info text-center">No hay ventas registradas en la fecha seleccionada.</div>
}

@if (mostrarModalMeta)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Meta diaria de ventas</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalMeta" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2">Almacén: <strong>@modalNombreAlmacen</strong></p>
                    <p class="small text-muted mb-2">Fecha: <strong>@fechaConsulta.ToString("dd/MM/yyyy")</strong>. Todas las vendedoras de este almacén comparten esta meta para ese día (mañana puede ser otro valor).</p>
                    <label class="form-label">Meta de ventas (comprobantes) para el día</label>
                    <InputNumber @bind-Value="modalMetaDiaria" class="form-control" min="1" />
                    @if (!string.IsNullOrEmpty(errorModalMeta))
                    {
                        <div class="text-danger small mt-2">@errorModalMeta</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalMeta">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarModalMeta" disabled="@guardandoMeta">
                        @(guardandoMeta ? "Guardando…" : "Guardar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModalConsultaRango)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Consultar por fechas</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalConsultaRango" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 align-items-end mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Desde</label>
                            <InputDate @bind-Value="rangoDesde" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Hasta</label>
                            <InputDate @bind-Value="rangoHasta" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            @if (cargo == "ADMINISTRADOR")
                            {
                                <div>
                                    <label><input type="radio" value="false" @onchange="e => rangoPorAlmacen = false" checked="@(!rangoPorAlmacen)" /> Global</label>
                                    <label class="ms-3"><input type="radio" value="true" @onchange="e => rangoPorAlmacen = true" checked="@(rangoPorAlmacen)" /> Por almacén</label>
                                </div>
                                <select class="form-select mt-1" @bind="rangoIdAlmacen" disabled="@(!rangoPorAlmacen)">
                                    <option value="0">-- Seleccionar almacén --</option>
                                    @foreach (var a in almacenesTodos)
                                    {
                                        <option value="@a.IdAlmacen">@a.Nombre</option>
                                    }
                                </select>
                            }
                            else if (cargo == "CAJERO")
                            {
                                <label class="form-label">Almacén</label>
                                <select class="form-select" @bind="rangoIdAlmacen" disabled>
                                    @foreach (var a in almacenes)
                                    {
                                        <option value="@a.IdAlmacen">@a.Nombre</option>
                                    }
                                </select>
                            }
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button type="button" class="btn btn-primary" @onclick="BuscarRankingRango" disabled="@cargandoRango">
                            @(cargandoRango ? "Buscando…" : "Buscar")
                        </button>
                        <button type="button" class="btn btn-success" @onclick="ExportarExcelRango" disabled="@(!rankingRango.Any())">
                            <i class="bi bi-file-earmark-excel-fill"></i> Exportar a Excel
                        </button>
                    </div>
                    @if (rankingRango.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-striped table-bordered">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Vendedora</th>
                                        <th>Estado</th>
                                        <th>Ventas Realizadas</th>
                                        <th>Artículos Vendidos</th>
                                        <th>Monto Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in rankingRango.Select((r, i) => new { r, i }))
                                    {
                                        <tr>
                                            <td>@(item.i + 1)</td>
                                            <td>@item.r.Vendedora</td>
                                            <td>@(item.r.Activo ? "Activo" : "Inactivo")</td>
                                            <td>@item.r.VentasRealizadas</td>
                                            <td>@item.r.ArticulosVendidos</td>
                                            <td>S/ @item.r.TotalVentas.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (yaBuscoRango)
                    {
                        <div class="alert alert-info mb-0">No hay ventas en el rango y filtros elegidos.</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalConsultaRango">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<RankingVendedoraDTO> ranking = new();
    private List<(RankingVendedoraDTO r, bool mostrarBotonMeta)> filasRanking = new();
    private DateTime fechaConsulta = DateTime.Today;
    private List<AlmacenDTO> almacenes = new();
    private List<AlmacenDTO> almacenesTodos = new();
    private int idAlmacenSeleccionado;
    private bool porAlmacen = false;
    private string? cargo;
    private int? idAlmacenUsuario;

    private bool mostrarModalMeta;
    private int modalIdAlmacen;
    private string modalNombreAlmacen = "";
    private int modalMetaDiaria = 1;
    private string errorModalMeta = "";
    private bool guardandoMeta;

    private bool mostrarModalConsultaRango;
    private DateTime rangoDesde = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime rangoHasta = DateTime.Today;
    private bool rangoPorAlmacen;
    private int rangoIdAlmacen;
    private List<RankingVendedoraDTO> rankingRango = new();
    private bool cargandoRango;
    private bool yaBuscoRango;

    protected override async Task OnInitializedAsync()
    {
        almacenesTodos = await AlmacenService.GetAlmacenes() ?? new();
        almacenes = almacenesTodos;
        cargo = await AuthService.GetUserCargo();
        idAlmacenUsuario = await AuthService.GetUserAlmacenId();

        if (cargo == "CAJERO")
        {
            porAlmacen = true;
            idAlmacenSeleccionado = idAlmacenUsuario ?? 0;
            almacenes = almacenes.Where(a => a.IdAlmacen == idAlmacenSeleccionado).ToList();
            rangoPorAlmacen = true;
            rangoIdAlmacen = idAlmacenSeleccionado;
        }

        await BuscarRanking();
    }

    private string NombreAlmacen(int idAlmacen) =>
        almacenesTodos.FirstOrDefault(a => a.IdAlmacen == idAlmacen)?.Nombre ?? $"Almacén {idAlmacen}";

    private void ReconstruirFilasRanking()
    {
        filasRanking.Clear();
        if (cargo != "ADMINISTRADOR")
        {
            foreach (var r in ranking)
            {
                filasRanking.Add((r, false));
            }
            return;
        }

        var seen = new HashSet<int>();
        foreach (var r in ranking)
        {
            var mostrar = r.IdAlmacen is int aid && aid > 0 && seen.Add(aid);
            filasRanking.Add((r, mostrar));
        }
    }

    private async Task BuscarRanking()
    {
        ranking = await ReporteService.ObtenerRankingVendedorasDia(
            fechaConsulta,
            porAlmacen ? idAlmacenSeleccionado : (int?)null,
            porAlmacen);
        ReconstruirFilasRanking();
    }

    private void AbrirModalConsultaRango()
    {
        yaBuscoRango = false;
        rankingRango = new();
        rangoDesde = new DateTime(fechaConsulta.Year, fechaConsulta.Month, 1);
        rangoHasta = fechaConsulta;
        if (cargo == "CAJERO")
        {
            rangoPorAlmacen = true;
            rangoIdAlmacen = idAlmacenSeleccionado;
        }
        mostrarModalConsultaRango = true;
    }

    private void CerrarModalConsultaRango()
    {
        mostrarModalConsultaRango = false;
    }

    private async Task BuscarRankingRango()
    {
        if (cargo == "ADMINISTRADOR" && rangoPorAlmacen && rangoIdAlmacen <= 0)
        {
            return;
        }

        cargandoRango = true;
        yaBuscoRango = true;
        try
        {
            rankingRango = await ReporteService.ObtenerRankingVendedorasRango(
                rangoDesde,
                rangoHasta,
                rangoPorAlmacen ? rangoIdAlmacen : (int?)null,
                rangoPorAlmacen);
        }
        finally
        {
            cargandoRango = false;
        }
    }

    private async Task ExportarExcelRango()
    {
        if (!rankingRango.Any())
        {
            return;
        }

        var headers = new[] { "Ranking", "Vendedor", "Estado", "Ventas", "Artículos", "Monto" };
        var rows = rankingRango.Select((r, i) => new object[]
        {
            i + 1,
            r.Vendedora,
            r.Activo ? "Activo" : "Inactivo",
            r.VentasRealizadas,
            r.ArticulosVendidos,
            r.TotalVentas
        }).ToArray();

        await JS.InvokeVoidAsync("exportToExcel", headers, rows, $"RankingVendedoras_Rango_{rangoDesde:yyyyMMdd}_{rangoHasta:yyyyMMdd}");
    }

    private void AbrirModalMeta(RankingVendedoraDTO r)
    {
        errorModalMeta = "";
        if (r.IdAlmacen is not int almId || almId <= 0)
        {
            errorModalMeta = "La vendedora no tiene almacén asignado; no se puede definir meta.";
            mostrarModalMeta = true;
            return;
        }

        modalIdAlmacen = almId;
        modalNombreAlmacen = NombreAlmacen(almId);
        modalMetaDiaria = r.MetaVentasDiarias is > 0 ? r.MetaVentasDiarias.Value : 1;
        mostrarModalMeta = true;
    }

    private void CerrarModalMeta()
    {
        mostrarModalMeta = false;
        errorModalMeta = "";
    }

    private async Task GuardarModalMeta()
    {
        if (modalMetaDiaria < 1)
        {
            errorModalMeta = "Ingrese una meta mayor o igual a 1.";
            return;
        }

        if (modalIdAlmacen <= 0)
        {
            errorModalMeta = "Almacén inválido.";
            return;
        }

        guardandoMeta = true;
        errorModalMeta = "";
        try
        {
            var ok = await ReporteService.GuardarMetaAlmacenVentasDiaria(modalIdAlmacen, fechaConsulta, modalMetaDiaria);
            if (!ok)
            {
                errorModalMeta = "No se pudo guardar. Verifique permisos (solo administrador) o la sesión.";
                return;
            }

            CerrarModalMeta();
            await BuscarRanking();
        }
        finally
        {
            guardandoMeta = false;
        }
    }

    private async Task ExportarExcel()
    {
        var headers = new[] { "Ranking", "Vendedor", "Estado", "Ventas", "Artículos", "Monto", "Meta día", "% vendido" };
        var rows = ranking.Select((r, i) => new object[]
        {
            i + 1,
            r.Vendedora,
            r.Activo ? "Activo" : "Inactivo",
            r.VentasRealizadas,
            r.ArticulosVendidos,
            r.TotalVentas,
            r.MetaVentasDiarias ?? (object)"",
            r.PorcentajeVendido.HasValue ? $"{r.PorcentajeVendido:0.00}%" : ""
        }).ToArray();

        await JS.InvokeVoidAsync("exportToExcel", headers, rows, $"RankingVendedoras_{fechaConsulta:yyyyMMdd}");
    }

    private static string GetClasePctVendido(decimal pct)
    {
        if (pct < 60m) return "bg-danger";
        if (pct < 90m) return "bg-warning text-dark";
        return "bg-success";
    }

    private async Task ExportarPDF()
    {
        var almacenesPdf = porAlmacen && idAlmacenSeleccionado > 0
            ? almacenes.Where(a => a.IdAlmacen == idAlmacenSeleccionado).ToList()
            : almacenes;

        // Pre-cargar todos los datos
        var datosPorAlmacen = new List<(AlmacenDTO Almacen, List<RankingVendedoraDTO> Datos)>();
        foreach (var alm in almacenesPdf)
        {
            var datos = await ReporteService.ObtenerRankingVendedorasDia(fechaConsulta, alm.IdAlmacen, true);
            if (datos.Any())
                datosPorAlmacen.Add((alm, datos));
        }

        // Cada sección es un string HTML independiente (se renderiza por separado para evitar cortes)
        var sections = new List<string>();

        // ─── SECCIÓN 1: HEADER ─────────────────────────────────────────────
        sections.Add($@"
<div style='font-family:Segoe UI,Arial,sans-serif;background:linear-gradient(135deg,#5e2f8a 0%,#7a42bb 100%);color:#fff;padding:24px 36px 20px 36px;border-radius:0 0 12px 12px;position:relative;'>
  <img src='data:image/png;base64,' style='position:absolute;top:70px;right:20px;width:30px;height:30px;border-radius:8px;'/>
  <div style='font-size:22px;font-weight:700;letter-spacing:1px;margin-bottom:4px;display:flex;align-items:center;gap:10px;'><svg xmlns='http://www.w3.org/2000/svg' width='26' height='26' viewBox='0 0 24 24' fill='white'><path d='M19 5h-2V3H7v2H5C3.9 5 3 5.9 3 7v1c0 2.55 1.92 4.63 4.39 4.94C8.02 14.44 9.37 15.57 11 15.9V18H9v2h6v-2h-2v-2.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 12.63 21 10.55 21 8V7c0-1.1-.9-2-2-2zM5 8V7h2v3.82C5.84 10.4 5 9.3 5 8zm14 0c0 1.3-.84 2.4-2 2.82V7h2v1z'/></svg> RANKING DE VENDEDORAS</div>
  <div style='font-size:13px;opacity:.85;'>Reporte de desempeño por ventas realizadas</div>
  <div style='display:inline-block;margin-top:10px;background:rgba(255,255,255,.18);border-radius:20px;padding:4px 16px;font-size:12px;font-weight:600;'>
    <svg xmlns='http://www.w3.org/2000/svg' width='13' height='13' viewBox='0 0 24 24' fill='white' style='vertical-align:middle;margin-right:4px;'><path d='M19 3h-1V1h-2v2H8V1H6v2H5C3.89 3 3 3.9 3 5v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z'/></svg> Fecha: {fechaConsulta:dd/MM/yyyy}
  </div>
</div>");

        // ─── SECCIÓN POR ALMACÉN (una por cada tienda) ─────────────────────
        foreach (var (alm, datos) in datosPorAlmacen)
        {
            var totalMonto    = datos.Sum(d => d.TotalVentas);
            var totalCantidad = datos.Sum(d => d.VentasRealizadas);
            var totalArticulos = datos.Sum(d => d.ArticulosVendidos);

            var sb = new StringBuilder();
            sb.AppendLine($@"
<div style='font-family:Segoe UI,Arial,sans-serif;margin:8px 0 0 0;'>
  <div style='background:#f1f5f9;color:#334155;padding:9px 18px;border-radius:8px 8px 0 0;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;border:1px solid #e2e8f0;border-bottom:none;'>
    <svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='#64748b' style='vertical-align:middle;margin-right:6px;'><path d='M20 4H4v2h16V4zM21 14v-2l-1-5H4l-1 5v2h1v6h10v-6h4v6h2v-6h1zM12 18H6v-4h6v4z'/></svg> {System.Net.WebUtility.HtmlEncode(alm.Nombre)}
  </div>
  <table style='width:100%;border-collapse:collapse;border:1px solid #e2e8f0;'>
    <thead>
      <tr style='background:#f8fafc;color:#475569;'>
        <th style='padding:10px 12px;font-size:11px;font-weight:700;text-transform:uppercase;text-align:center;width:42px;'>#</th>
        <th style='padding:10px 12px;font-size:11px;font-weight:700;text-transform:uppercase;text-align:left;'>Vendedora</th>
        <th style='padding:10px 12px;font-size:11px;font-weight:700;text-transform:uppercase;text-align:center;'>Estado</th>
        <th style='padding:10px 12px;font-size:11px;font-weight:700;text-transform:uppercase;text-align:center;'>Ventas</th>
        <th style='padding:10px 12px;font-size:11px;font-weight:700;text-transform:uppercase;text-align:center;'>Artículos</th>
        <th style='padding:10px 12px;font-size:11px;font-weight:700;text-transform:uppercase;text-align:right;'>Monto Total</th>
        <th style='padding:10px 12px;font-size:11px;font-weight:700;text-transform:uppercase;text-align:center;'>Meta</th>
        <th style='padding:10px 12px;font-size:11px;font-weight:700;text-transform:uppercase;text-align:right;'>% vendido</th>
      </tr>
    </thead>
    <tbody>");

            var index = 1;
            foreach (var d in datos)
            {
                var rowBg = index == 1 ? "#fefce8"
                          : index == 2 ? "#f8fafc"
                          : index == 3 ? "#fffbf7"
                          : index % 2 == 0 ? "#fdfdfd" : "#ffffff";

                var badgeBg    = index == 1 ? "#facc15" : index == 2 ? "#cbd5e1" : index == 3 ? "#dd6b20" : "#e2e8f0";
                var badgeColor = index <= 3 ? "#fff" : "#64748b";

                var estadoStyle = d.Activo
                    ? "background:#dcfce7;color:#15803d;padding:2px 10px;border-radius:12px;font-size:10px;font-weight:700;"
                    : "background:#fee2e2;color:#b91c1c;padding:2px 10px;border-radius:12px;font-size:10px;font-weight:700;";
                var estadoTexto = d.Activo ? "ACTIVO" : "INACTIVO";

                var metaPdf = d.MetaVentasDiarias.HasValue
                    ? System.Net.WebUtility.HtmlEncode($"{d.MetaVentasDiarias}")
                    : "—";
                var pctPdf = d.PorcentajeVendido.HasValue
                    ? System.Net.WebUtility.HtmlEncode($"{d.PorcentajeVendido:N2}%")
                    : "—";

                sb.AppendLine($@"
      <tr style='background:{rowBg};border-bottom:1px solid #e2e8f0;'>
        <td style='padding:9px 12px;text-align:center;vertical-align:middle;'>
          <span style='display:inline-block;width:26px;height:26px;border-radius:50%;background:{badgeBg};color:{badgeColor};font-size:11px;font-weight:700;text-align:center;line-height:26px;'>{index}</span>
        </td>
        <td style='padding:9px 12px;font-size:12px;color:#1e293b;vertical-align:middle;'>{System.Net.WebUtility.HtmlEncode(d.Vendedora)}</td>
        <td style='padding:9px 12px;text-align:center;vertical-align:middle;'><span style='{estadoStyle}'>{estadoTexto}</span></td>
        <td style='padding:9px 12px;font-size:12px;font-weight:600;color:#334155;text-align:center;vertical-align:middle;'>{d.VentasRealizadas}</td>
        <td style='padding:9px 12px;font-size:12px;font-weight:600;color:#334155;text-align:center;vertical-align:middle;'>{d.ArticulosVendidos}</td>
        <td style='padding:9px 12px;font-size:13px;font-weight:700;color:#15803d;text-align:right;vertical-align:middle;'>S/ {d.TotalVentas:N2}</td>
        <td style='padding:9px 12px;font-size:11px;font-weight:600;color:#334155;text-align:center;vertical-align:middle;'>{metaPdf}</td>
        <td style='padding:9px 12px;font-size:12px;font-weight:600;color:#334155;text-align:right;vertical-align:middle;'>{pctPdf}</td>
      </tr>");
                index++;
            }

            sb.AppendLine($@"
      <tr style='background:#f8fafc;border-top:2px solid #cbd5e1;'>
        <td colspan='3' style='padding:10px 12px;font-size:12px;font-weight:700;color:#334155;'>TOTAL ALMACEN</td>
        <td style='padding:10px 12px;font-size:12px;font-weight:700;color:#334155;text-align:center;'>{totalCantidad}</td>
        <td style='padding:10px 12px;font-size:12px;font-weight:700;color:#334155;text-align:center;'>{totalArticulos}</td>
        <td style='padding:10px 12px;font-size:14px;font-weight:700;color:#0f766e;text-align:right;'>S/ {totalMonto:N2}</td>
        <td style='padding:10px 12px;font-size:12px;font-weight:700;color:#64748b;text-align:center;'>—</td>
        <td style='padding:10px 12px;font-size:12px;font-weight:700;color:#64748b;text-align:right;'>—</td>
      </tr>
    </tbody>
  </table>
</div>");

            sections.Add(sb.ToString());
        }

        // ─── SECCIÓN FINAL: FOOTER ─────────────────────────────────────────
        sections.Add($@"
<div style='font-family:Segoe UI,Arial,sans-serif;padding-top:12px;border-top:1px solid #e2e8f0;display:flex;justify-content:space-between;font-size:10px;color:#94a3b8;'>
  <span>GSCommerce &mdash; Sistema de Gestion</span>
  <span>Generado el {DateTime.Now:dd/MM/yyyy} a las {DateTime.Now:HH:mm}</span>
</div>");

        await JS.InvokeVoidAsync("generarPDFConSecciones", sections, $"Ranking_Vendedoras_{DateTime.Now:yyyyMMdd_HHmmss}");
    }
}
