@page "/hubs/reportes/ventas-tarjeta-mensual"
@using System.Linq
@using GSCommerce.Client.Components
@using GSCommerce.Client.Models.DTOs.Reportes
@using GSCommerce.Client.Services
@inject ReporteService ReporteService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthService AuthService

<ReportsBreadcrumb Title="Ventas Tarjeta / Online (Histórico mensual)" />

<div class="container-fluid py-2">
    <p class="text-muted small mb-3">
        Reporte anual por mes: totales por método (SGVV hasta el 09/08/2025: solo soles; SYSCHARLES desde el 10/08/2025: soles y dólares como en el sistema actual). Misma estructura que pagos tarjeta/online.
    </p>

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label class="form-label">Año</label>
            <select class="form-select" @bind="anioSeleccionado">
                @foreach (var y in aniosDisponibles)
                {
                    <option value="@y">@y</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Almacén</label>
            <select class="form-select" @bind="nombreAlmacen">
                <option value="">Todos</option>
                @foreach (var alm in almacenesPermitidos)
                {
                    <option value="@alm">@alm</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-primary w-100" @onclick="Buscar" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                <i class="bi bi-search"></i> Buscar
            </button>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-success w-100" @onclick="ExportarExcel" disabled="@(reporte == null || isLoading)">
                <i class="bi bi-file-earmark-spreadsheet"></i> Exportar Excel
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center my-4">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (reporte != null)
    {
        @foreach (var mesDto in reporte.Meses.OrderBy(m => m.Month))
        {
            var tituloMes = $"{GetNombreMes(mesDto.Month)} {reporte.Year}";
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white fw-bold">
                    @tituloMes
                </div>
                <div class="card-body p-0">
                    @if (mesDto.Totales.Count == 0)
                    {
                        <div class="p-3 text-muted">No hay operaciones con tarjeta u online en este mes.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Método</th>
                                        <th>Tipo</th>
                                        <th class="text-center">Operaciones</th>
                                        <th class="text-end">Soles</th>
                                        <th class="text-end">Dólares</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in mesDto.Totales)
                                    {
                                        <tr>
                                            <td>@item.Descripcion</td>
                                            <td>@item.Tipo</td>
                                            <td class="text-center">@item.CantidadOperaciones</td>
                                            <td class="text-end">S/ @item.TotalSoles.ToString("N2")</td>
                                            <td class="text-end">$ @item.TotalDolares.ToString("N2")</td>
                                            <td class="text-end">@item.Total.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light fw-bold">
                                    <tr>
                                        <td>Total</td>
                                        <td></td>
                                        <td class="text-center">@mesDto.Totales.Sum(t => t.CantidadOperaciones)</td>
                                        <td class="text-end">S/ @mesDto.Totales.Sum(t => t.TotalSoles).ToString("N2")</td>
                                        <td class="text-end">$ @mesDto.Totales.Sum(t => t.TotalDolares).ToString("N2")</td>
                                        <td class="text-end">@mesDto.Totales.Sum(t => t.Total).ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-secondary text-white fw-bold">
                Total año @reporte.Year
            </div>
            <div class="card-body p-0">
                @if (reporte.TotalesAnio.Count == 0)
                {
                    <div class="p-3 text-muted">No hay datos en el año seleccionado.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Método</th>
                                    <th>Tipo</th>
                                    <th class="text-center">Operaciones</th>
                                    <th class="text-end">Soles</th>
                                    <th class="text-end">Dólares</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in reporte.TotalesAnio)
                                {
                                    <tr>
                                        <td>@item.Descripcion</td>
                                        <td>@item.Tipo</td>
                                        <td class="text-center">@item.CantidadOperaciones</td>
                                        <td class="text-end">S/ @item.TotalSoles.ToString("N2")</td>
                                        <td class="text-end">$ @item.TotalDolares.ToString("N2")</td>
                                        <td class="text-end">@item.Total.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td>Total</td>
                                    <td></td>
                                    <td class="text-center">@reporte.TotalesAnio.Sum(t => t.CantidadOperaciones)</td>
                                    <td class="text-end">S/ @reporte.TotalesAnio.Sum(t => t.TotalSoles).ToString("N2")</td>
                                    <td class="text-end">$ @reporte.TotalesAnio.Sum(t => t.TotalDolares).ToString("N2")</td>
                                    <td class="text-end">@reporte.TotalesAnio.Sum(t => t.Total).ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private int anioSeleccionado = DateTime.Today.Year;
    private List<int> aniosDisponibles = new();
    private string? nombreAlmacen;
    private readonly List<string> almacenesPermitidos = new()
    {
        "CHICLAYO2", "PIURA2", "SULLANA2", "TRUJILLO2", "AGUAS VERDES2", "IQUITOS FATISHOP"
    };

    private ReporteVentasTarjetaMensualResponseDTO? reporte;
    private bool isLoading;

    private int? userId;

    protected override async Task OnInitializedAsync()
    {
        var y = DateTime.Today.Year;
        aniosDisponibles = Enumerable.Range(y - 8, 10).ToList();
        if (!aniosDisponibles.Contains(anioSeleccionado))
        {
            aniosDisponibles.Add(anioSeleccionado);
            aniosDisponibles.Sort();
        }

        userId = await AuthService.GetUserId();
        if (userId != 4004 && userId != 4023 && userId != 4033)
        {
            Navigation.NavigateTo("/");
            return;
        }

        await Buscar();
    }

    private async Task Buscar()
    {
        isLoading = true;
        reporte = null;
        StateHasChanged();
        try
        {
            reporte = await ReporteService.ObtenerVentasTarjetaOnlineMensual(anioSeleccionado, nombreAlmacen);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            reporte = new ReporteVentasTarjetaMensualResponseDTO
            {
                Year = anioSeleccionado,
                Meses = Enumerable.Range(1, 12).Select(m => new VentaTarjetaMesTotalesDTO { Month = m }).ToList()
            };
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExportarExcel()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            using var response = await ReporteService.ExportarVentasTarjetaOnlineMensual(anioSeleccionado, nombreAlmacen);
            if (!response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "No se pudo exportar el reporte.");
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            var base64 = Convert.ToBase64String(bytes);
            var nombreArchivo = $"VentasTarjetaMensual_{anioSeleccionado}_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            await JS.InvokeVoidAsync("downloadFileFromBytes", nombreArchivo, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
        }
        catch
        {
            await JS.InvokeVoidAsync("alert", "Error inesperado al exportar.");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private static string GetNombreMes(int mes)
    {
        return mes switch
        {
            1 => "Enero", 2 => "Febrero", 3 => "Marzo", 4 => "Abril",
            5 => "Mayo", 6 => "Junio", 7 => "Julio", 8 => "Agosto",
            9 => "Septiembre", 10 => "Octubre", 11 => "Noviembre", 12 => "Diciembre",
            _ => mes.ToString()
        };
    }
}
