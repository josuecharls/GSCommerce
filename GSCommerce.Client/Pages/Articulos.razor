@page "/articulos"
@using GSCommerce.Client.Models
@using GSCommerce.Client.Services
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "ADMINISTRADOR,ALMACEN")]
@inject ArticuloService ArticuloService
@inject ArticuloVarianteService ArticuloVarianteService
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS

<h3><i class="bi bi-box-seam-fill"></i>  Lista de Artículos</h3>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <button class="btn btn-success" @onclick="CreateNewArticulo">+ Nuevo Artículo</button>
        <button class="btn btn-outline-success ms-2" @onclick="AbrirModalExportar">
            <i class="bi bi-file-earmark-excel"></i> Exportar Articulos
        </button>
    </div>
    <div class="input-group w-50">
        <input type="text"
               class="form-control"
               placeholder="Buscar por CÓDIGO o DESCRIPCIÓN..."
               @bind="searchTerm"
               @bind:event="oninput"
               @onkeypress="HandleKeyPress" />
        <button class="btn btn-primary" @onclick="SearchArticulos"><i class="bi bi-search"></i> Buscar</button>
    </div>
</div>

<div class="card p-3 shadow-sm">
    <table class="table table-striped">
        <thead>
            <tr>
                <th @onclick='() => SortBy("Codigo")' style="cursor:pointer;">
                    <i class="bi @(GetSortIcon("Codigo")) me-1"></i>Código
                </th>
                <th @onclick='() => SortBy("Descripcion")' style="cursor:pointer;">
                    <i class="bi @(GetSortIcon("Descripcion")) me-1"></i>Descripción
                </th>
                <th>Precio Compra</th>
                <th>Precio Venta</th>
                <th>Fecha Registro</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (articuloList.Any())
            {
                @foreach (var a in articuloList)
                {
                    <tr>
                        <td>@a.IdArticulo</td>
                        <td>@a.Descripcion</td>
                        <td>S/. @a.PrecioCompra</td>
                        <td>S/. @a.PrecioVenta</td>
                        <td>@a.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (a.Estado)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                        <td class="text-center">
                            <button @onclick="() => ShowPhoto(a.IdArticulo)" class="btn btn-info btn-sm me-1">
                                <i class="bi bi-image"></i>
                            </button>
                            <button @onclick="() => ShowBarcode(a.IdArticulo)" class="btn btn-primary btn-sm me-1" title="Ver código de barras">
                                <i class="bi bi-upc"></i>
                            </button>
                            <button @onclick="() => ShowQr(a.IdArticulo)" class="btn btn-secondary btn-sm me-1">
                                <i class="bi bi-qr-code"></i>
                            </button>
                            <button @onclick="() => EditVariantes(a.IdArticulo)" class="btn btn-info btn-sm me-1">
                                <i class="bi bi-palette"></i> Var.
                            </button>
                            <button @onclick="() => EditArticulo(a.IdArticulo)" class="btn btn-warning btn-sm me-1">
                                <i class="bi bi-pencil-square"></i> Editar
                            </button>
                            <button @onclick="() => ConfirmDeleteArticulo(a.IdArticulo, a.Descripcion)" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="7" class="text-center">Cargando... Espere...</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- Controles de paginación -->
<div class="d-flex justify-content-between">
    <button class="btn btn-secondary" @onclick="PrevPage" disabled="@(!CanPrev)">
        <i class="bi bi-arrow-left"></i> Anterior
    </button>
    <span>Página @currentPage de @totalPages</span>
    <button class="btn btn-secondary" @onclick="NextPage" disabled="@(!CanNext)">
        Siguiente <i class="bi bi-arrow-right"></i>
    </button>
</div>

<!-- Modal Exportar Artículos -->
@if (showExportModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Exportar Articulos</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalExportar" disabled="@exportando"></button>
                </div>
                <div class="modal-body">
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="chkExportarTodos"
                               checked="@seleccionarTodosExport"
                               @onchange="OnSeleccionarTodosExportChanged"
                               disabled="@exportando" />
                        <label class="form-check-label" for="chkExportarTodos">
                            Seleccionar todos
                        </label>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeExport))
                    {
                        <div class="alert alert-warning py-2">@mensajeExport</div>
                    }

                    @if (seleccionarTodosExport)
                    {
                        <div class="alert alert-info mb-0">
                            Se exportarán todos los artículos (Código y Fecha de Registro).
                        </div>
                    }
                    else
                    {
                        <label class="form-label">Buscar por código</label>
                        <input type="text"
                               class="form-control"
                               placeholder="Ingrese el código y presione Enter"
                               @bind="codigoExportar"
                               @bind:event="oninput"
                               @onkeydown="OnExportCodigoKeyDown"
                               @ref="exportCodigoInput"
                               disabled="@exportando" />

                        @if (articulosExportarSeleccionados.Any())
                        {
                            <div class="mt-3">
                                <small class="text-muted">Seleccionados: @articulosExportarSeleccionados.Count</small>
                                <ul class="list-group mt-1" style="max-height: 280px; overflow-y: auto;">
                                    @foreach (var art in articulosExportarSeleccionados)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                            <span>
                                                <strong>@art.IdArticulo</strong>
                                                <span class="text-muted ms-2">@art.FechaRegistro.ToString("dd/MM/yyyy")</span>
                                            </span>
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => RemoverArticuloExport(art)"
                                                    disabled="@exportando"
                                                    title="Quitar">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mt-3 mb-0">Ningún artículo seleccionado.</p>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-success" @onclick="ExportarArticulos" disabled="@exportando">
                        @if (exportando)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Exportar
                    </button>
                    <button class="btn btn-secondary" @onclick="CerrarModalExportar" disabled="@exportando">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal de Confirmación para Eliminar -->
@if (showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body text-center">
                    <p>¿Desea eliminar el artículo <strong>@deleteArticuloName</strong> de la base de datos?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger" @onclick="DeleteConfirmed">Sí</button>
                    <button class="btn btn-secondary" @onclick="CloseDeleteModal">No</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal de QR (2-up 100x50mm) -->
@if (showQrModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content p-4 text-center">
                <div class="modal-header border-0">
                    <h5 class="modal-title">QR de @qrArticulo?.Descripcion</h5>
                    <button type="button" class="btn-close" @onclick="CloseQrModal"></button>
                </div>
                <div class="modal-body text-center pt-0">
                    <div class="etiqueta-imprimir">
                        <div class="label">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=@qrArticulo?.IdArticulo" />
                            <div class="desc">@qrArticulo?.DescripcionCorta</div>
                            <div class="code">Código: @qrArticulo?.IdArticulo</div>
                        </div>
                        <div class="label">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=@qrArticulo?.IdArticulo" />
                            <div class="desc">@qrArticulo?.DescripcionCorta</div>
                            <div class="code">Código: @qrArticulo?.IdArticulo</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <button class="btn btn-success" @onclick="PrintQr">Imprimir</button>
                    <button class="btn btn-secondary" @onclick="CloseQrModal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <style>
        @@media print {
            @@page {
                size: 100mm 50mm;
                margin: 0;
            }

            body * {
                visibility: hidden !important;
            }

            .etiqueta-imprimir, .etiqueta-imprimir * {
                visibility: visible !important;
            }

            .etiqueta-imprimir {
                position: fixed;
                inset: 0;
                width: 100mm;
                height: 50mm;
                display: flex;
                gap: 3mm;
            }

            .label {
                width: calc((100mm - 3mm)/2);
                height: 50mm;
                border: 1px solid #000;
                border-radius: .8mm;
                padding: 1.2mm;
                box-sizing: border-box;
                display: flex;
                flex-direction: column;
                gap: 1mm;
                justify-content: center;
                align-items: center;
            }

                .label img {
                    width: 22mm;
                    height: 22mm;
                    object-fit: contain;
                    display: block;
                }

            .desc {
                font-weight: 700;
                font-size: 8pt;
                line-height: 1.15;
                text-align: center;
            }

            .code {
                font-size: 7pt;
            }
        }
    </style>
}

<!-- Modal de Código de Barras (preview; impresión abre /barcode-print) -->
@if (showBarcodeModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content p-4 text-center">
                <div class="modal-header border-0">
                    <h5 class="modal-title">Código de Barras de @barcodeArticulo?.Descripcion</h5>
                    <button type="button" class="btn-close" @onclick="CloseBarcodeModal"></button>
                </div>
                <div class="modal-body text-center pt-0">
                    <div class="etiqueta-preview">
                        <div class="barcode-price">
                            <img src="https://barcodeapi.org/api/128/@CodigoBarrasModalPreview" width="240" />
                            <div class="price">S/. @barcodeArticulo?.PrecioVenta.ToString("0.00")</div>
                        </div>
                        <div style="font-weight:bold; margin-top:6px">@descripcionParaImpresion</div>
                        @if (varianteSeleccionadaImpresion != null)
                        {
                            <div style="font-size:small; color: #666; margin-top: 4px;">
                                Color: <strong>@varianteSeleccionadaImpresion.Color</strong> | Talla: <strong>@varianteSeleccionadaImpresion.Talla</strong>
                            </div>
                        }
                        else if (tieneVariantes)
                        {
                            <div style="font-size:small; color: #856404; margin-top: 4px;">
                                Elija una variante con el botón «Elegir Variante» para imprimir.
                            </div>
                        }
                        <div style="font-size:small">Código: @CodigoBarrasModalPreview</div>
                    </div>
                </div>
                <div class="modal-footer justify-content-center flex-wrap">
                    @if (tieneVariantes)
                    {
                        <button class="btn btn-info me-2" 
                                type="button"
                                @onclick="AbrirModalSeleccionVarianteImpresion">
                            <i class="bi bi-palette"></i> Elegir Variante
                        </button>
                    }
                    <button class="btn btn-success"
                            type="button"
                            disabled="@DebeElegirVarianteParaImprimir"
                            title="@(DebeElegirVarianteParaImprimir ? "Seleccione una variante en Elegir Variante para imprimir." : null)"
                            @onclick="PrintBarcode">Imprimir</button>
                    <button class="btn btn-secondary" type="button" @onclick="CloseBarcodeModal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal para ver foto -->
@if (showPhotoModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Foto de @selectedArticulo?.Descripcion</h5>
                    <button type="button" class="btn-close" @onclick="ClosePhotoModal"></button>
                </div>
                <div class="modal-body text-center">
                    @if (!string.IsNullOrEmpty(photoUrl))
                    {
                        <img src="@photoUrl" loading="lazy" alt="Foto" class="img-fluid img-thumbnail" style="max-width:300px;max-height:300px;" />
                    }
                    else
                    {
                        <p>No hay foto disponible.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="ClosePhotoModal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Seleccionar Variante para Impresión -->
@if (mostrarModalSeleccionVarianteImpresion)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Seleccionar Variante para Imprimir</h5>
                    <button type="button" class="btn-close" @onclick="() => mostrarModalSeleccionVarianteImpresion = false"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">Seleccione la variante que desea imprimir:</p>
                    <div class="list-group">
                        @foreach (var variante in variantesDisponiblesImpresion)
                        {
                            <button type="button" 
                                    class="list-group-item list-group-item-action @(varianteSeleccionadaImpresion?.IdVariante == variante.IdVariante ? "active" : "")"
                                    @onclick="() => SeleccionarVarianteParaImpresion(variante)">
                                <strong>@variante.Color</strong> - <strong>@variante.Talla</strong>
                            </button>
                        }
                    </div>
                    @if (varianteSeleccionadaImpresion != null)
                    {
                        <div class="mt-3">
                            <button class="btn btn-sm btn-outline-secondary w-100" @onclick="LimpiarVarianteSeleccionada">
                                <i class="bi bi-x-circle"></i> Limpiar Selección
                            </button>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => mostrarModalSeleccionVarianteImpresion = false">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public int? page { get; set; }

    [SupplyParameterFromQuery]
    public string? search { get; set; }

    private List<ArticuloDTO> articuloList = new();
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages;
    private string searchTerm = "";
    private bool isDeleting = false;
    private bool showDeleteModal = false;
    private int deleteArticuloId;
    private string deleteArticuloName = "";
    private bool showPhotoModal = false;
    private bool showBarcodeModal = false;
    private bool showQrModal = false;
    private string? photoUrl;
    private ArticuloDTO? barcodeArticulo;
    private ArticuloDTO? selectedArticulo;
    private ArticuloDTO? qrArticulo;
    private string currentSortColumn = "Codigo";
    private bool sortAscending = true;

    private bool showExportModal = false;
    private bool seleccionarTodosExport = false;
    private bool exportando = false;
    private bool focusExportInput = false;
    private string codigoExportar = "";
    private string mensajeExport = "";
    private List<ArticuloDTO> articulosExportarSeleccionados = new();
    private ElementReference exportCodigoInput;

    protected override async Task OnInitializedAsync()
    {
        if (page.HasValue && page.Value > 0)
        {
            currentPage = page.Value;
        }
        
        if (!string.IsNullOrEmpty(search))
        {
            searchTerm = search;
        }

        await LoadArticulos();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusExportInput && showExportModal && !seleccionarTodosExport)
        {
            focusExportInput = false;
            try
            {
                await exportCodigoInput.FocusAsync();
            }
            catch
            {
                // El input puede no estar en el DOM si se marcó "Seleccionar todos"
            }
        }
    }

    private void AbrirModalExportar()
    {
        showExportModal = true;
        seleccionarTodosExport = false;
        exportando = false;
        codigoExportar = "";
        mensajeExport = "";
        articulosExportarSeleccionados.Clear();
        focusExportInput = true;
    }

    private void CerrarModalExportar()
    {
        if (exportando)
            return;

        showExportModal = false;
        seleccionarTodosExport = false;
        codigoExportar = "";
        mensajeExport = "";
        articulosExportarSeleccionados.Clear();
    }

    private void OnSeleccionarTodosExportChanged(ChangeEventArgs e)
    {
        seleccionarTodosExport = e.Value is bool b && b;
        mensajeExport = "";
        if (!seleccionarTodosExport)
        {
            focusExportInput = true;
        }
    }

    private async Task OnExportCodigoKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AgregarArticuloPorCodigo();
        }
    }

    private async Task AgregarArticuloPorCodigo()
    {
        mensajeExport = "";
        var codigo = ArticuloService.NormalizarCodigoArticulo(codigoExportar);
        if (string.IsNullOrEmpty(codigo))
            return;

        if (articulosExportarSeleccionados.Any(a => a.IdArticulo == codigo))
        {
            mensajeExport = $"El artículo {codigo} ya está seleccionado.";
            codigoExportar = "";
            focusExportInput = true;
            return;
        }

        var articulo = await ArticuloService.BuscarPorCodigoAsync(codigo);
        if (articulo == null)
        {
            mensajeExport = $"No se encontró el artículo {codigo}.";
            focusExportInput = true;
            return;
        }

        articulosExportarSeleccionados.Add(articulo);
        codigoExportar = "";
        focusExportInput = true;
    }

    private void RemoverArticuloExport(ArticuloDTO art)
    {
        articulosExportarSeleccionados.Remove(art);
    }

    private async Task ExportarArticulos()
    {
        mensajeExport = "";

        if (!seleccionarTodosExport && !articulosExportarSeleccionados.Any())
        {
            mensajeExport = "Seleccione al menos un artículo o marque 'Seleccionar todos'.";
            focusExportInput = true;
            return;
        }

        exportando = true;
        try
        {
            var aExportar = seleccionarTodosExport
                ? await ArticuloService.ObtenerTodos()
                : articulosExportarSeleccionados;

            if (aExportar == null || !aExportar.Any())
            {
                mensajeExport = "No hay artículos para exportar.";
                return;
            }

            var headers = new[] { "Codigo", "Fecha de Registro" };
            var rows = aExportar
                .Select(a => new object[]
                {
                    a.IdArticulo,
                    a.FechaRegistro.ToString("dd/MM/yyyy")
                })
                .ToArray();

            await JS.InvokeVoidAsync("exportToExcel", headers, rows, "Articulos");
            exportando = false;
            CerrarModalExportar();
        }
        catch (Exception ex)
        {
            mensajeExport = $"No se pudo generar el Excel: {ex.Message}";
        }
        finally
        {
            exportando = false;
        }
    }

    private async Task LoadArticulos()
    {
        try
        {
            var response = await ArticuloService.GetArticulos(currentPage, pageSize, searchTerm);
            articuloList = SortList(response.Data);
            totalPages = response.TotalPages;

            // Actualizar la URL sin recargar la página
            var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                { "page", currentPage > 1 ? currentPage : null },
                { "search", !string.IsNullOrEmpty(searchTerm) ? searchTerm : null }
            });
            Navigation.NavigateTo(uri, forceLoad: false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error al cargar artículos: {ex.Message}");
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchArticulos();
        }
    }

    private async Task SearchArticulos()
    {
        currentPage = 1;
        await LoadArticulos();
    }

    private async Task PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadArticulos();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadArticulos();
        }
    }

    private void CreateNewArticulo()
    {
        Navigation.NavigateTo("/articulo-form/" + Guid.NewGuid().ToString());
    }

    private void EditArticulo(string id)
    {
        var uri = Navigation.GetUriWithQueryParameters(Navigation.ToAbsoluteUri($"/articulo/edit/{id}").ToString(), new Dictionary<string, object?>
        {
            { "page", currentPage > 1 ? currentPage : null },
            { "search", !string.IsNullOrEmpty(searchTerm) ? searchTerm : null }
        });
        Navigation.NavigateTo(uri.ToString());
    }

    private void EditVariantes(string id)
    {
        var uri = Navigation.GetUriWithQueryParameters(Navigation.ToAbsoluteUri($"/articulo-variante/{id}").ToString(), new Dictionary<string, object?>
        {
            { "page", currentPage > 1 ? currentPage : null },
            { "search", !string.IsNullOrEmpty(searchTerm) ? searchTerm : null }
        });
        Navigation.NavigateTo(uri.ToString());
    }

    private void ConfirmDeleteArticulo(string id, string name)
    {
        deleteArticuloId = int.Parse(id);
        deleteArticuloName = name;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        deleteArticuloId = 0;
        deleteArticuloName = "";
    }

    private async Task DeleteConfirmed()
    {
        if (!isDeleting && deleteArticuloId > 0)
        {
            isDeleting = true;
            try
            {
                if (await ArticuloService.DeleteArticulo(deleteArticuloId.ToString("D6")))
                {
                    await LoadArticulos();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al eliminar artículo: {ex.Message}");
            }
            isDeleting = false;
            CloseDeleteModal();
        }
    }

