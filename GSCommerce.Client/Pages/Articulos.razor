    {
        selectedArticulo = articuloList.FirstOrDefault(a => a.IdArticulo == id);
        if (selectedArticulo != null)
        {
            photoUrl = $"{Http.BaseAddress}articulos/foto/{id}?t={DateTime.Now.Ticks}";
            showPhotoModal = true;
        }
    }

    private void ClosePhotoModal()
    {
        showPhotoModal = false;
        photoUrl = null;
    }

    private void ShowQr(string id)
    {
        qrArticulo = articuloList.FirstOrDefault(a => a.IdArticulo == id);
        if (qrArticulo != null)
        {
            showQrModal = true;
        }
    }

    private void CloseQrModal()
    {
        showQrModal = false;
    }

    private async Task PrintQr()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private void SortBy(string column)
    {
        if (currentSortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSortColumn = column;
            sortAscending = true;
        }

        articuloList = SortList(articuloList);
    }

    private List<ArticuloDTO> SortList(List<ArticuloDTO> list)
    {
        return currentSortColumn switch
        {
            "Codigo" => sortAscending ? list.OrderBy(a => a.IdArticulo).ToList() : list.OrderByDescending(a => a.IdArticulo).ToList(),
            "Descripcion" => sortAscending ? list.OrderBy(a => a.Descripcion).ToList() : list.OrderByDescending(a => a.Descripcion).ToList(),
            _ => list
        };
    }

    private string GetSortIcon(string column)
    {
        if (currentSortColumn != column)
            return "bi-arrow-down-up";
        return sortAscending ? "bi-arrow-up" : "bi-arrow-down";
    }

    private async Task ShowBarcode(string id)
    {
        barcodeArticulo = articuloList.FirstOrDefault(a => a.IdArticulo == id);
        if (barcodeArticulo != null)
        {
            variantesDisponiblesImpresion = await ArticuloVarianteService.ObtenerVariantesPorArticulo(barcodeArticulo.IdArticulo);
            varianteSeleccionadaImpresion = null;
            descripcionParaImpresion = barcodeArticulo.DescripcionCorta ?? barcodeArticulo.Descripcion ?? string.Empty;

            showBarcodeModal = true;
        }
    }

    private void CloseBarcodeModal()
    {
        showBarcodeModal = false;
        varianteSeleccionadaImpresion = null;
        variantesDisponiblesImpresion.Clear();
        descripcionParaImpresion = string.Empty;
    }

    // Abre /barcode-print (dos etiquetas, 96×36 mm)
    private void PrintBarcode()
    {
        if (barcodeArticulo is null) return;
        if (DebeElegirVarianteParaImprimir) return;

        var codigoParaImprimir = CalcularCodigoBarrasImpresion();

        // Color/talla: variante si el artículo tiene variantes y hay selección; si no, cabecera del artículo (antiguos).
        var colorImpresion = tieneVariantes
            ? varianteSeleccionadaImpresion!.Color
            : barcodeArticulo.Color;
        var tallaImpresion = tieneVariantes
            ? varianteSeleccionadaImpresion!.Talla
            : barcodeArticulo.Talla;

        var q = BarcodePrintMetadataQuery.BuildPrintQuery(
            descripcionParaImpresion,
            barcodeArticulo,
            barcodeArticulo.PrecioVenta,
            colorImpresion,
            tallaImpresion);

        Navigation.NavigateTo($"/barcode-print/{codigoParaImprimir}?{q}", true);
    }

    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < totalPages;

    // Variables para manejo de variantes en impresión
    private List<ArticuloVarianteDTO> variantesDisponiblesImpresion = new();
    private ArticuloVarianteDTO? varianteSeleccionadaImpresion;
    private string descripcionParaImpresion = string.Empty;
    private bool mostrarModalSeleccionVarianteImpresion = false;
    private bool tieneVariantes => variantesDisponiblesImpresion.Any();

    /// <summary>Artículos con variantes: exige elegir una en el modal antes de imprimir.</summary>
    private bool DebeElegirVarianteParaImprimir =>
        tieneVariantes && varianteSeleccionadaImpresion is null;

    /// <summary>Código mostrado en el modal (coherente con lo que se imprimirá al tener variante elegida).</summary>
    private string CodigoBarrasModalPreview
    {
        get
        {
            if (barcodeArticulo is null) return string.Empty;
            return CalcularCodigoBarrasImpresion();
        }
    }

    private string CalcularCodigoBarrasImpresion()
    {
        if (barcodeArticulo is null) return string.Empty;
        if (!tieneVariantes || varianteSeleccionadaImpresion is null)
            return barcodeArticulo.IdArticulo;

        var indice = variantesDisponiblesImpresion.FindIndex(v => v.IdVariante == varianteSeleccionadaImpresion.IdVariante) + 1;
        if (indice < 1) return barcodeArticulo.IdArticulo;

        if (variantesDisponiblesImpresion.Count > 1)
            return $"{barcodeArticulo.IdArticulo}-{indice}";

        return barcodeArticulo.IdArticulo;
    }

    private void AbrirModalSeleccionVarianteImpresion()
    {
        if (tieneVariantes)
        {
            mostrarModalSeleccionVarianteImpresion = true;
        }
    }

    private void SeleccionarVarianteParaImpresion(ArticuloVarianteDTO variante)
    {
        varianteSeleccionadaImpresion = variante;
        if (barcodeArticulo != null)
        {
            // Formato: "DESCRIPCION C/VAR T/TALLA" según el formato mostrado en las imágenes
            descripcionParaImpresion = $"{barcodeArticulo.DescripcionCorta} C/{variante.Color} T/{variante.Talla}";
        }
        mostrarModalSeleccionVarianteImpresion = false;
        StateHasChanged();
    }

    private void LimpiarVarianteSeleccionada()
    {
        varianteSeleccionadaImpresion = null;
        if (barcodeArticulo != null)
        {
            descripcionParaImpresion = barcodeArticulo.DescripcionCorta ?? barcodeArticulo.Descripcion;
        }
        StateHasChanged();
    }
}