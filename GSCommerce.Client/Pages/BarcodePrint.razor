@page "/barcode-print/{codigo}"
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@attribute [Authorize]
@inject IJSRuntime JS

<style>
    :root {
        /* Formato físico de impresión (dos etiquetas en 96×36 mm) */
        --page-w: 96mm;
        --page-h: 36mm;
        --gap: 8.5mm;
        --safe: 1.0mm;
        --label-w: calc((var(--page-w) - var(--gap)) / 2);
    }

    .two-up {
        width: var(--page-w);
        height: var(--page-h);
        display: flex;
        gap: var(--gap);
    }

    .print-area {
        width: calc(var(--label-w) - 2*var(--safe));
        height: calc(var(--page-h) - 2*var(--safe));
        margin: var(--safe);
        box-sizing: border-box;
        padding: 1.0mm;
        border-radius: .8mm;
        display: grid;
        grid-template-rows: auto 1fr auto;
        row-gap: 0.85mm;
        border: 2.5px solid #000;
    }

    /* Cabecera: barras + fila código / TALLA (sin marco interior) */
    .top {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
    }

    .barcode {
        width: 100%;
        height: 8.5mm;
        object-fit: contain;
        display: block;
        flex-shrink: 0;
    }

        .barcode svg {
            width: 100% !important;
            height: 100% !important;
            max-width: 100%;
            max-height: 100%;
        }

    .barcode-meta {
        display: flex;
        flex-direction: row;
        align-items: baseline;
        justify-content: space-between;
        gap: 1.25mm;
        margin-top: 0.25mm;
        padding: 0 1.5mm;
        box-sizing: border-box;
    }

    .barcode-code {
        font-size: 8pt;
        font-weight: 700;
        line-height: 1;
        color: #000;
        font-family: Arial, Helvetica, "Segoe UI", sans-serif;
        letter-spacing: 0.02em;
        flex: 0 1 auto;
        min-width: 0;
    }

    .talla-block {
        font-size: 7.75pt;
        font-weight: 700;
        line-height: 1;
        text-align: right;
        text-transform: uppercase;
        white-space: nowrap;
        flex-shrink: 0;
        font-family: Arial, Helvetica, "Segoe UI", sans-serif;
    }

    .body-lines {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.2mm;
        min-height: 0;
    }

    /* Primera línea del bloque (línea + marca): ligeramente mayor */
    .body-lines > .body-line:first-of-type {
        font-size: 7.75pt;
        line-height: 1.12;
    }

    .body-line {
        font-size: 6.75pt;
        font-weight: 700;
        line-height: 1.12;
        text-transform: uppercase;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: Arial, Helvetica, "Segoe UI", sans-serif;
    }

    /* Material / tela: más pequeño que línea y modelo */
    .body-line--material {
        font-size: 5.25pt;
        font-weight: 600;
        line-height: 1.1;
    }

    .body-fallback {
        font-size: 6.75pt;
        font-weight: 700;
        line-height: 1.12;
        text-transform: uppercase;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        white-space: normal;
        font-family: Arial, Helvetica, "Segoe UI", sans-serif;
    }

    .footer {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: end;
        column-gap: 1.5mm;
    }

    .fecha-creacion {
        font-size: 6pt;
        font-weight: 700;
        line-height: 1;
        text-transform: uppercase;
        flex-shrink: 0;
        font-family: Arial, Helvetica, "Segoe UI", sans-serif;
    }

    .price {
        font-weight: 700;
        font-size: 11.4pt;
        line-height: 1;
        white-space: nowrap;
        flex-shrink: 0;
        font-family: Arial, Helvetica, "Segoe UI", sans-serif;
    }

    @@media print {
        @@page {
            size: var(--page-w) var(--page-h);
            margin: 0;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

            body * {
                visibility: hidden !important;
            }

        .to-print, .to-print * {
            visibility: visible !important;
        }

        .to-print {
            position: fixed;
            inset: 0;
        }

        .barcode svg {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
    }
</style>

@if (!string.IsNullOrWhiteSpace(Codigo))
{
    <div class="to-print">
        <div class="two-up">
            @for (int i = 0; i < 2; i++)
            {
                <div class="print-area">
                    <div class="top">
                        <svg class="barcode" id="barcode-@i" data-code="@Codigo"></svg>
                        <div class="barcode-meta">
                            <span class="barcode-code">@Codigo</span>
                            @if (!string.IsNullOrWhiteSpace(Talla))
                            {
                                <div class="talla-block">TALLA @Talla.Trim().ToUpperInvariant()</div>
                            }
                        </div>
                    </div>

                    <div class="body-lines">
                        @if (UsaLineasEstructuradas)
                        {
                            @* LÍNEA MARCA · FAMILIA MODELO · TELA (más pequeña) · COLOR *@
                            @if (!string.IsNullOrWhiteSpace(LineaMarca))
                            {
                                <div class="body-line">@LineaMarca</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(FamiliaModelo))
                            {
                                <div class="body-line">@FamiliaModelo</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(LineaTela))
                            {
                                <div class="body-line body-line--material">@LineaTela</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(LineaColor))
                            {
                                <div class="body-line">@LineaColor</div>
                            }
                        }
                        else if (!string.IsNullOrWhiteSpace(DescripcionDecoded))
                        {
                            <div class="body-fallback">@DescripcionDecoded</div>
                        }
                    </div>

                    <div class="footer">
                        <div class="fecha-creacion">@TextoFechaCreacion</div>
                        <div class="price">
                            @if (PrecioDecimal.HasValue)
                            {
                                <span>S/ @PrecioDecimal.Value.ToString("0.00", CultureInfo.InvariantCulture)</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{

    <p>Cargando…</p>
}

@code {
    [Parameter] public string? Codigo { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "precio")] public string? Precio { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "descripcion")] public string? Descripcion { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? Color { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? Talla { get; set; }

    [Parameter, SupplyParameterFromQuery] public string? Linea { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? Marca { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? Familia { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? Material { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? Modelo { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? Fc { get; set; }

    private decimal? PrecioDecimal;

    private string DescripcionDecoded =>
        string.IsNullOrWhiteSpace(Descripcion) ? string.Empty : Descripcion.Trim();

    private string? LineaTrim =>
        string.IsNullOrWhiteSpace(Linea) ? null : Linea.Trim();

    private string? MarcaTrim =>
        string.IsNullOrWhiteSpace(Marca) ? null : Marca.Trim();

    private string? FamiliaTrim =>
        string.IsNullOrWhiteSpace(Familia) ? null : Familia.Trim();

    private string? ModeloTrim =>
        string.IsNullOrWhiteSpace(Modelo) ? null : Modelo.Trim();

    private string? MaterialTrim =>
        string.IsNullOrWhiteSpace(Material) ? null : Material.Trim();

    private string? LineaMarca =>
        JoinLineParts(LineaTrim, MarcaTrim);

    private string? FamiliaModelo =>
        JoinLineParts(FamiliaTrim, ModeloTrim);

    private static string? JoinLineParts(params string?[] parts)
    {
        var s = string.Join(' ', parts.Where(p => !string.IsNullOrWhiteSpace(p)).Select(p => p!.Trim()));
        return string.IsNullOrWhiteSpace(s) ? null : s;
    }

    /// <summary>Tercera línea: material / tela (tipografía reducida vía CSS).</summary>
    private string? LineaTela =>
        string.IsNullOrWhiteSpace(MaterialTrim) ? null : $"TELA: {MaterialTrim.ToUpperInvariant()}";

    private string? ColorDecoded =>
        string.IsNullOrWhiteSpace(Color) ? null : Color.Trim();

    private string? LineaColor =>
        string.IsNullOrWhiteSpace(ColorDecoded) ? null : $"COLOR: {ColorDecoded.ToUpperInvariant()}";

    private bool UsaLineasEstructuradas =>
        !string.IsNullOrWhiteSpace(LineaMarca)
        || !string.IsNullOrWhiteSpace(FamiliaModelo)
        || !string.IsNullOrWhiteSpace(LineaTela)
        || !string.IsNullOrWhiteSpace(LineaColor);

    private string TextoFechaCreacion =>
        !string.IsNullOrWhiteSpace(Fc)
        && DateOnly.TryParse(Fc, CultureInfo.InvariantCulture, DateTimeStyles.None, out var d)
            ? $"F.C: {d:dd/MM/yy}"
            : string.Empty;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Precio))
        {
            if (decimal.TryParse(Precio, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var vInv))
                PrecioDecimal = vInv;
            else if (decimal.TryParse(Precio, out var vLoc))
                PrecioDecimal = vLoc;
            else
                PrecioDecimal = null;
        }
        else PrecioDecimal = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrWhiteSpace(Codigo))
        {
            await JS.InvokeVoidAsync("generateBarcode", "barcode-0", Codigo);
            await JS.InvokeVoidAsync("generateBarcode", "barcode-1", Codigo);

            await Task.Delay(150);
            await JS.InvokeVoidAsync("window.print");
        }
    }
}
