@page "/almacen-repuesto"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "ADMINISTRADOR,CAJERO")]
@using GSCommerce.Client.Models
@using GSCommerce.Client.Services
@inject AlmacenRepuestoService AlmacenRepuestoService
@inject StockAlmacenRepuestoService StockRepuestoService
@inject AlmacenService AlmacenService
@inject ArticuloService ArticuloService
@inject AuthService AuthService

<PageTitle>Depósito interno</PageTitle>

<div class="container-fluid py-3">
    <h3 class="mb-2"><i class="bi bi-layers-half text-primary"></i> Depósito interno</h3>
    <p class="text-muted mb-4">
        Aquí se registra el <strong>stock aparte de los depósitos</strong>.
    </p>

    @if (datosInicialesListos && !esAdministrador && (idAlmacenCajero == null || idAlmacenCajero <= 0))
    {
        <div class="alert alert-warning">
            Su usuario no tiene una tienda asignada en personal. Solicite al administrador que vincule su usuario a un almacén para usar los depósitos.
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeOk))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @mensajeOk
            <button type="button" class="btn-close" @onclick="() => mensajeOk = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        @if (esAdministrador)
        {
            <div class="col-md-4">
                <label class="form-label fw-semibold">Filtrar por tienda</label>
                <select class="form-select" @bind="filtroIdAlmacen" @bind:after="OnCambioFiltroTienda">
                    <option value="0">— Todas las tiendas —</option>
                    @foreach (var a in almacenes)
                    {
                        <option value="@a.IdAlmacen">@a.Nombre</option>
                    }
                </select>
            </div>
        }
        else
        {
            <div class="col-md-6">
                <label class="form-label fw-semibold">Tu tienda</label>
                <div class="form-control-plaintext border rounded px-3 py-2 bg-light">
                    @(nombreTiendaCajero ?? "—")
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">@(esAdministrador ? "Administración de depósitos" : "Depósitos de tu tienda")</h5>
        @if (esAdministrador)
        {
            <button type="button" class="btn btn-success" @onclick="AbrirModalNuevo">
                <i class="bi bi-plus-circle"></i> Nuevo depósito
            </button>
        }
    </div>
    <p class="text-muted mb-3">Haz clic en una fila para seleccionar el depósito y registrar movimientos.</p>

    <div class="table-responsive mb-4">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Tienda</th>
                    <th>Nombre del depósito</th>
                    <th class="text-end">Artículos</th>
                    <th class="text-end">Unidades</th>
                    <th>Estado</th>
                    @if (esAdministrador)
                    {
                        <th class="text-center">Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!listaSotanosTabla.Any())
                {
                    <tr><td colspan="@(esAdministrador ? 6 : 5)" class="text-center text-muted">No hay depósitos registrados.</td></tr>
                }
                else
                {
                    @foreach (var ar in listaSotanosTabla)
                    {
                        var seleccionado = ar.IdAlmacenRepuesto == idSotanoSeleccionado;
                        <tr class="@(seleccionado ? "table-primary" : "")"
                            style="cursor: pointer;"
                            role="button"
                            @onclick="() => SeleccionarSotano(ar.IdAlmacenRepuesto)">
                            <td>@ar.NombreAlmacen</td>
                            <td>
                                @ar.Nombre
                                @if (seleccionado)
                                {
                                    <span class="badge bg-primary ms-2">Seleccionado</span>
                                }
                            </td>
                            <td class="text-end">@((ar.TotalArticulos ?? 0).ToString())</td>
                            <td class="text-end">@((ar.TotalUnidades ?? 0).ToString())</td>
                            <td>
                                @if (ar.Estado)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            @if (esAdministrador)
                            {
                                <td class="text-center text-nowrap">
                                    <button type="button"
                                            class="btn btn-warning btn-sm me-1"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => AbrirModalEditar(ar)">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => ConfirmDelete(ar.IdAlmacenRepuesto, ar.Nombre)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (idSotanoSeleccionado > 0)
    {
        <div class="card border-primary mb-4">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-arrow-down-up"></i> Ingreso o retiro de prendas en el depósito seleccionado
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Código de artículo</label>
                        <input class="form-control" placeholder="5060 o 005060" @bind="codigoArticulo" maxlength="12" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-outline-secondary w-100" @onclick="BuscarArticulo" disabled="@busy">
                            Ver artículo
                        </button>
                    </div>
                    <div class="col-md-4">
                        @if (articuloVista != null)
                        {
                            <div class="small text-success"><strong>@articuloVista.IdArticulo</strong> — @articuloVista.Descripcion</div>
                        }
                        else if (busquedaSinResultado)
                        {
                            <div class="small text-danger">No se encontró el artículo.</div>
                        }
                    </div>
                </div>
                <div class="row g-3 align-items-end mt-2">
                    <div class="col-md-2">
                        <label class="form-label">Cantidad (unidades)</label>
                        <input type="number" class="form-control" min="1" @bind="cantidadMovimiento" @bind:event="oninput" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-success w-100" @onclick="() => RegistrarMovimiento(true)" disabled="@(!PuedeRegistrar)">
                            <i class="bi bi-plus-lg"></i> Ingresar al depósito
                        </button>
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-warning w-100 text-dark" @onclick="() => RegistrarMovimiento(false)" disabled="@(!PuedeRegistrar)">
                            <i class="bi bi-dash-lg"></i> Retirar del depósito
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <h5 class="mb-2">Stock actual en este depósito</h5>
        <div class="row g-2 mb-2">
            <div class="col-md-4">
                <input class="form-control" placeholder="Buscar en este depósito (código o descripción)..." @bind="busquedaEnSotano" @bind:event="oninput" />
            </div>
        </div>
        @if (cargandoStock)
        {
            <p class="text-muted">Cargando…</p>
        }
        else if (!lineasStockFiltradas.Any())
        {
            <p class="text-muted">No hay artículos registrados con cantidad mayor a cero.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th class="text-end">Cantidad en depósito</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var linea in lineasStockFiltradas)
                        {
                            <tr>
                                <td><code>@linea.IdArticulo</code></td>
                                <td>@linea.Descripcion</td>
                                <td class="text-end fw-semibold">@linea.Cantidad</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(esEdicion ? "Editar" : "Nuevo") depósito</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tienda</label>
                        <select class="form-select" @bind="modelo.IdAlmacen">
                            <option value="0">— Seleccione —</option>
                            @foreach (var a in almacenes)
                            {
                                <option value="@a.IdAlmacen">@a.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nombre del depósito</label>
                        <input type="text" class="form-control" @bind="modelo.Nombre" placeholder="Ej. Depósito principal" />
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="chkEstado" @bind="modelo.Estado" />
                        <label class="form-check-label" for="chkEstado">Activo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="Guardar" disabled="@isSaving">@(isSaving ? "Guardando…" : "Guardar")</button>
                    <button class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill text-warning"></i> Confirmar</h5>
                    <button type="button" class="btn-close" @onclick="CerrarDeleteModal"></button>
                </div>
                <div class="modal-body">
                    ¿Eliminar el depósito <strong>@deleteNombre</strong>? Solo se permite si no tiene stock.
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger" @onclick="DeleteConfirmed">Eliminar</button>
                    <button class="btn btn-secondary" @onclick="CerrarDeleteModal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool datosInicialesListos;
    private bool esAdministrador;
    private int? idAlmacenCajero;
    private string? nombreTiendaCajero;
    private List<AlmacenDTO> almacenes = new();
    private List<AlmacenRepuestoDTO> listaSotanosCompleta = new();
    private int filtroIdAlmacen;
    private int idSotanoSeleccionado;
    private List<StockAlmacenRepuestoLineaDTO> lineasStock = new();
    private string busquedaEnSotano = string.Empty;
    private bool cargandoStock;
    private string codigoArticulo = "";
    private ArticuloDTO? articuloVista;
    private bool busquedaSinResultado;
    private int cantidadMovimiento = 1;
    private bool busy;
    private string? mensajeOk;
    private string? mensajeError;

    private AlmacenRepuestoDTO modelo = new() { Estado = true };
    private bool showModal;
    private bool showDeleteModal;
    private bool esEdicion;
    private bool isSaving;
    private int deleteId;
    private string deleteNombre = "";

    private IEnumerable<AlmacenRepuestoDTO> sotanosActivos =>
        listaSotanosCompleta
            .Where(x => x.Estado && (filtroIdAlmacen == 0 || x.IdAlmacen == filtroIdAlmacen))
            .OrderBy(x => x.NombreAlmacen)
            .ThenBy(x => x.Nombre);

    private IEnumerable<AlmacenRepuestoDTO> listaSotanosTabla =>
        listaSotanosCompleta
            .Where(x => filtroIdAlmacen == 0 || x.IdAlmacen == filtroIdAlmacen)
            .OrderBy(x => x.NombreAlmacen)
            .ThenBy(x => x.Nombre);

    private IEnumerable<StockAlmacenRepuestoLineaDTO> lineasStockFiltradas
    {
        get
        {
            var term = (busquedaEnSotano ?? string.Empty).Trim();
            if (term.Length == 0)
                return lineasStock;
            term = term.ToUpperInvariant();
            return lineasStock.Where(x =>
                (x.IdArticulo ?? string.Empty).ToUpperInvariant().Contains(term) ||
                (x.Descripcion ?? string.Empty).ToUpperInvariant().Contains(term));
        }
    }

    private bool PuedeRegistrar =>
        idSotanoSeleccionado > 0
        && articuloVista != null
        && cantidadMovimiento > 0
        && !busy;

    protected override async Task OnInitializedAsync()
    {
        var cargo = await AuthService.GetUserCargo();
        esAdministrador = string.Equals(cargo, "ADMINISTRADOR", StringComparison.OrdinalIgnoreCase);

        almacenes = await AlmacenService.GetAlmacenes() ?? new List<AlmacenDTO>();

        if (!esAdministrador)
        {
            idAlmacenCajero = await AuthService.GetUserAlmacenId();
            if (idAlmacenCajero is > 0)
            {
                filtroIdAlmacen = idAlmacenCajero.Value;
                nombreTiendaCajero = almacenes.FirstOrDefault(a => a.IdAlmacen == idAlmacenCajero)?.Nombre;
            }
        }

        await RecargarListaSotanos();
        datosInicialesListos = true;
    }

    private async Task RecargarListaSotanos()
    {
        listaSotanosCompleta = await AlmacenRepuestoService.GetAlmacenRepuestos();
        if (idSotanoSeleccionado > 0 && !sotanosActivos.Any(s => s.IdAlmacenRepuesto == idSotanoSeleccionado))
            idSotanoSeleccionado = 0;
        await OnCambioSotano();
    }

    private async Task OnCambioFiltroTienda()
    {
        if (idSotanoSeleccionado > 0)
        {
            var ok = sotanosActivos.Any(s => s.IdAlmacenRepuesto == idSotanoSeleccionado);
            if (!ok)
                idSotanoSeleccionado = 0;
        }
        await OnCambioSotano();
    }

    private async Task SeleccionarSotano(int idAlmacenRepuesto)
    {
        if (idAlmacenRepuesto <= 0)
            return;
        if (idSotanoSeleccionado == idAlmacenRepuesto)
            return;
        idSotanoSeleccionado = idAlmacenRepuesto;
        await OnCambioSotano();
    }

    private async Task OnCambioSotano()
    {
        mensajeError = null;
        mensajeOk = null;
        lineasStock.Clear();
        busquedaEnSotano = string.Empty;
        articuloVista = null;
        busquedaSinResultado = false;
        if (idSotanoSeleccionado <= 0)
        {
            StateHasChanged();
            return;
        }
        cargandoStock = true;
        StateHasChanged();
        lineasStock = await StockRepuestoService.GetStockAsync(idSotanoSeleccionado);
        cargandoStock = false;
    }

    private async Task BuscarArticulo()
    {
        mensajeError = null;
        busquedaSinResultado = false;
        articuloVista = null;
        var norm = ArticuloService.NormalizarCodigoArticulo(codigoArticulo);
        if (string.IsNullOrEmpty(norm))
        {
            mensajeError = "Ingrese un código de artículo.";
            return;
        }
        busy = true;
        articuloVista = await ArticuloService.BuscarPorCodigoAsync(codigoArticulo);
        busy = false;
        busquedaSinResultado = articuloVista == null;
    }

    private async Task RegistrarMovimiento(bool ingreso)
    {
        if (!PuedeRegistrar || articuloVista == null)
            return;
        mensajeOk = null;
        mensajeError = null;
        busy = true;
        var req = new AjusteStockRepuestoRequest
        {
            IdAlmacenRepuesto = idSotanoSeleccionado,
            IdArticulo = articuloVista.IdArticulo,
            Tipo = ingreso ? "I" : "E",
            Cantidad = cantidadMovimiento
        };
        var (ok, err) = await StockRepuestoService.AjustarAsync(req);
        busy = false;
        if (!ok)
        {
            mensajeError = err ?? "No se pudo registrar el movimiento.";
            return;
        }
        mensajeOk = ingreso
            ? $"Se ingresaron {cantidadMovimiento} unidad(es) al depósito."
            : $"Se retiraron {cantidadMovimiento} unidad(es) del depósito.";
        lineasStock = await StockRepuestoService.GetStockAsync(idSotanoSeleccionado);
        // refrescar resumen por depósito
        await RecargarListaSotanos();
        cantidadMovimiento = 1;
    }

    private void AbrirModalNuevo()
    {
        modelo = new AlmacenRepuestoDTO { Estado = true, IdAlmacen = filtroIdAlmacen > 0 ? filtroIdAlmacen : 0 };
        esEdicion = false;
        showModal = true;
    }

    private void AbrirModalEditar(AlmacenRepuestoDTO item)
    {
        modelo = new AlmacenRepuestoDTO
        {
            IdAlmacenRepuesto = item.IdAlmacenRepuesto,
            IdAlmacen = item.IdAlmacen,
            Nombre = item.Nombre,
            Direccion = item.Direccion,
            Estado = item.Estado
        };
        esEdicion = true;
        showModal = true;
    }

    private void CerrarModal() => showModal = false;

    private async Task Guardar()
    {
        if (modelo.IdAlmacen == 0 || string.IsNullOrWhiteSpace(modelo.Nombre))
        {
            mensajeError = "Complete tienda y nombre del depósito.";
            return;
        }
        isSaving = true;
        bool ok = esEdicion
            ? await AlmacenRepuestoService.UpdateAlmacenRepuesto(modelo.IdAlmacenRepuesto, modelo)
            : await AlmacenRepuestoService.CreateAlmacenRepuesto(modelo);
        isSaving = false;
        if (ok)
        {
            CerrarModal();
            await RecargarListaSotanos();
            mensajeOk = "Depósito guardado.";
        }
        else
            mensajeError = "No se pudo guardar. Revise los datos o su conexión.";
    }

    private void ConfirmDelete(int id, string nombre)
    {
        deleteId = id;
        deleteNombre = nombre;
        showDeleteModal = true;
    }

    private void CerrarDeleteModal()
    {
        showDeleteModal = false;
        deleteId = 0;
        deleteNombre = "";
    }

    private async Task DeleteConfirmed()
    {
        if (deleteId <= 0)
            return;
        if (await AlmacenRepuestoService.DeleteAlmacenRepuesto(deleteId))
        {
            mensajeOk = "Depósito eliminado.";
            if (idSotanoSeleccionado == deleteId)
                idSotanoSeleccionado = 0;
            await RecargarListaSotanos();
        }
        else
            mensajeError = "No se pudo eliminar (¿aún tiene stock?).";
        CerrarDeleteModal();
    }
}
